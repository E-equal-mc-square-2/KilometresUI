		ResetChat("New chat started.")
	end)
	ClearBtn.MouseButton1Click:Connect(function()
		ResetChat("Chat cleared.")
	end)
	RegenBtn.MouseButton1Click:Connect(Regenerate)
	ExportBtn.MouseButton1Click:Connect(ExportChat)

	StopBtn.MouseButton1Click:Connect(function()
		if Gemini.Sending then
			Gemini.Generation = Gemini.Generation + 1
			Gemini.Sending = false
			SetThinking(false)
			SetSendingUI(false)
			UpdateCounter()
			Notify("Gemini", "Generation stopped.", 1.8, "Info")
		end
	end)

	SendBtn.MouseButton1Click:Connect(function()
		SendGeminiMessage(ChatInput.Text)
	end)
	ChatInput.FocusLost:Connect(function(enterPressed)
		if enterPressed then
