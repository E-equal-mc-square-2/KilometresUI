	SetHidden = function(hidden)
		State.Hidden = hidden and true or false
		if State.Hidden then
			Tween(MainScale, {Scale = 0.94}, 0.15)
			task.delay(0.14, function()
				if State.Hidden then
					Main.Visible = false
				end
			end)
			SettingsOverlay.Visible = false
			Orb.Visible = true
			ClampOrb()
			Tween(OrbScale, {Scale = 0}, 0.01)
			Tween(OrbScale, {Scale = 1}, 0.3, Enum.EasingStyle.Back)
		else
			Main.Visible = true
			Orb.Visible = false
			if State.Minimized then
				State.Minimized = false
				if UpdateLayout then UpdateLayout() end
			end
			Tween(MainScale, {Scale = 1}, 0.22, Enum.EasingStyle.Back)
			PageHolder.Visible = not SettingsOverlay.Visible
			if not SettingsOverlay.Visible then
				if IsPortrait() then
					PortraitNav.Visible = true
					LandscapeNav.Visible = false
				else
					LandscapeNav.Visible = true
					PortraitNav.Visible = false
				end
			end
			ClampOffsets()
		end
	end

	SetMinimized = function(flag)
		if State.Hidden then
			return
		end
		State.Minimized = flag and true or false
		local ew = EffectiveSize()
		if State.Minimized then
			LandscapeNav.Visible = false
			PortraitNav.Visible = false
			PageHolder.Visible = false
			SettingsOverlay.Visible = false
			ResizeGrip.Visible = false
			local s = {Size = UDim2.fromOffset(ew, 58)}
			Tween(Main, s, 0.22)
			task.delay(0.23, ClampOffsets)
		else
			ResizeGrip.Visible = true
			Tween(Main, {Size = UDim2.fromOffset(EffectiveSize())}, 0.22)
			task.delay(0.06, function()
				if UpdateLayout then UpdateLayout() end
			end)
		end
	end

	SetTheme = function(name)
		if not Themes[name] then
			name = "Default"
		end
		State.ThemeName = name
		RefreshAll()
		-- animated transitions on the structural surfaces
		local T = Theme()
		Tween(Main, {BackgroundColor3 = T.Background, BackgroundTransparency = T.BackgroundTransparency}, 0.28)
		Tween(LandscapeNav, {BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency}, 0.28)
		Tween(PortraitNav, {BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency}, 0.28)
		Tween(SettingsPanel, {BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency}, 0.28)
		Tween(Orb, {BackgroundColor3 = T.Accent}, 0.28)
		Persist()
	end

	UpdateLayout = function()
		if State.Minimized then
			ClampOffsets()
			return
		end
		local ew, eh = EffectiveSize()
		Main.Size = UDim2.fromOffset(ew, eh)
		ClampOffsets()
		local portrait = IsPortrait()
		if SettingsOverlay.Visible then
			LandscapeNav.Visible = false
			PortraitNav.Visible = false
		elseif portrait then
			LandscapeNav.Visible = false
			PortraitNav.Visible = true
		else
			LandscapeNav.Visible = true
			PortraitNav.Visible = false
		end

		PortraitNav.Position = UDim2.new(0, 10, 0, 64)
		PortraitNav.Size = UDim2.new(1, -20, 0, 54)
		LandscapeNav.Position = UDim2.new(0, 12, 0, 64)
		LandscapeNav.Size = UDim2.new(0, 216, 1, -76)

		if portrait then
			PageHolder.Position = UDim2.new(0, 10, 0, 126)
			PageHolder.Size = UDim2.new(1, -20, 1, -136)
		else
			PageHolder.Position = UDim2.new(0, 240, 0, 64)
			PageHolder.Size = UDim2.new(1, -252, 1, -76)
		end
	end

	AddConn(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		Camera = workspace.CurrentCamera or Camera
		if Camera then
			AddConn(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				if not State.Destroyed then
					pcall(UpdateLayout)
					pcall(ClampOrb)
				end
			end))
			pcall(UpdateLayout)
			pcall(ClampOrb)
		end
	end))

	if Camera then
		AddConn(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if not State.Destroyed then
				pcall(UpdateLayout)
				pcall(ClampOrb)
			end
		end))
	end

