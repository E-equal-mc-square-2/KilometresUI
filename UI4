	local HELP_TEXT = table.concat({
		"**Slash commands**",
		"- `/help` show this list",
		"- `/clear` or `/new` start a fresh chat",
		"- `/mode chat` or `/mode coder` switch AI behaviour",
		"- `/model <name>` set the Gemini model",
		"- `/temp <0-2>` set creativity",
		"- `/theme <name>` change UI theme",
		"- `/wallpaper <1-20 | random | off | on>` change UIBG",
		"- `/run` execute the last code block Gemini sent",
		"- `/copy` copy the last reply",
		"- `/save` or `/load` chat history",
	}, "\n")

	local function HandleSlashCommand(text)
		local cmd, rest = text:match("^/(%a+)%s*(.*)$")
		if not cmd then
			return false
		end
		cmd = cmd:lower()
		rest = Trim(rest or "")

		if cmd == "help" then
			AddBubble("system", HELP_TEXT)
		elseif cmd == "clear" or cmd == "new" then
			ResetChat("New chat started.")
		elseif cmd == "mode" then
			local m = rest:lower()
			SetGeminiMode((m == "coder" or m == "code") and "Coder" or "Chat", true)
			AddBubble("system", "Mode set to **" .. State.Gemini.Mode .. "**.")
		elseif cmd == "model" then
			if rest ~= "" then
				State.Gemini.Model = rest
				if GeminiRefs.Model then GeminiRefs.Model.Set(rest) end
				Persist()
				AddBubble("system", "Model set to `" .. rest .. "`.")
			else
				AddBubble("system", "Current model: `" .. State.Gemini.Model .. "`")
			end
		elseif cmd == "temp" then
			local v = tonumber(rest)
			if v then
				State.Gemini.Temperature = Clamp(v, 0, 2)
				if GeminiRefs.Temperature then GeminiRefs.Temperature.Set(State.Gemini.Temperature, true) end
				Persist()
				AddBubble("system", "Temperature set to **" .. tostring(State.Gemini.Temperature) .. "**.")
			else
				AddBubble("system", "Usage: `/temp 0.7`")
			end
		elseif cmd == "theme" then
			local found = nil
			for _, info in ipairs(ThemeList) do
				if info.Key:lower() == rest:lower() or info.Label:lower() == rest:lower() then
					found = info
					break
				end
			end
			if found then
				SetTheme(found.Key)
				AddBubble("system", "Theme changed to **" .. found.Label .. "**.")
			else
				local names = {}
				for _, info in ipairs(ThemeList) do
					table.insert(names, "`" .. info.Key .. "`")
				end
				AddBubble("system", "Unknown theme. Available: " .. table.concat(names, ", "))
			end
		elseif cmd == "wallpaper" or cmd == "uibg" or cmd == "uibd" then
			local low = rest:lower()
			if low == "off" then
				State.UIBG.Enabled = false
				if UIBGRefs.Toggle then UIBGRefs.Toggle.Set(false, true) end
				ApplyWallpaper(true)
				Persist()
				AddBubble("system", "UIBG wallpaper **off**.")
			elseif low == "on" then
				State.UIBG.Enabled = true
				if UIBGRefs.Toggle then UIBGRefs.Toggle.Set(true, true) end
				ApplyWallpaper()
				Persist()
				AddBubble("system", "UIBG wallpaper **on**.")
			elseif low == "random" or low == "shuffle" then
				local i = ShuffleWallpaper(true)
				AddBubble("system", "Wallpaper: **" .. (WALLPAPERS[i] and WALLPAPERS[i].Name or "?") .. "**")
			else
				local n = tonumber(rest)
				if n and WALLPAPERS[math.floor(n)] then
					n = math.floor(n)
					State.UIBG.Index = n
					State.UIBG.CustomId = ""
					State.UIBG.Enabled = true
					if UIBGRefs.Toggle then UIBGRefs.Toggle.Set(true, true) end
					if UIBGRefs.Refresh then UIBGRefs.Refresh() end
					ApplyWallpaper()
					Persist()
					AddBubble("system", "Wallpaper: **" .. WALLPAPERS[n].Name .. "** (" .. n .. "/" .. #WALLPAPERS .. ")")
				else
					AddBubble("system", "Usage: `/wallpaper 7`, `/wallpaper random`, `/wallpaper off`")
				end
			end
		elseif cmd == "run" or cmd == "exec" then
			if LastCodeBlock then
				RunGeneratedCode(LastCodeBlock)
				AddBubble("system", "Executed the last code block.")
			else
				AddBubble("system", "No code block to run yet.")
			end
		elseif cmd == "copy" then
			local last = nil
			for i = #Gemini.History, 1, -1 do
				if Gemini.History[i].role == "model" then
					last = Gemini.History[i].content
					break
				end
			end
			if last and SetClipboardText(last) then
				AddBubble("system", "Last reply copied to clipboard.")
			else
				AddBubble("system", "Nothing to copy (or clipboard unsupported).")
			end
		elseif cmd == "save" then
			SaveChatHistory(false)
			AddBubble("system", "Chat saved to `" .. ChatFile .. "`.")
		elseif cmd == "load" then
			if LoadChatHistory and LoadChatHistory(true) then
				AddBubble("system", "Chat history restored.")
			else
				AddBubble("system", "No saved chat found.")
			end
		else
			return false
		end

		ChatInput.Text = ""
		ScrollBottom()
		return true
	end

	------------------------------------------------------------------
	-- SEND
	------------------------------------------------------------------

	local function DispatchGemini(myGen, attempt)
		local started = os.clock()
		task.spawn(function()
			local ok, res = pcall(function()
				local body = BuildGeminiBody()
				if not body then
					error("json")
				end
				return HttpPost(BuildGeminiURL(), body)
			end)

			if State.Destroyed or myGen ~= Gemini.Generation then
				return
			end

			-- one silent retry for flaky executor HTTP
			if (not ok) and State.Gemini.AutoRetry and attempt < 2 then
				SetStatus("NETWORK HICCUP - RETRYING...", "accent")
				task.wait(1.5)
				if myGen == Gemini.Generation and not State.Destroyed then
					DispatchGemini(myGen, attempt + 1)
				end
				return
			end

			Gemini.Sending = false
			SetThinking(false)
			SetSendingUI(false)
			StopStatusPulse()

			if not ok then
				if RawRequest == nil then
					GeminiFail("Gemini Error: No HTTP request function available on this executor.")
				else
					GeminiFail("Gemini Error: Network error.")
				end
				return
			end
			if type(res) ~= "table" or type(res.Body) ~= "string" then
				GeminiFail("Gemini Error: API unavailable.")
				return
			end

			local status = tonumber(res.StatusCode) or 0
			local data = SafeJSONDecode(res.Body)
			if not data then
				if status >= 200 and status < 300 then
					GeminiFail("Gemini Error: Invalid JSON response.")
				else
					GeminiFail(MapGeminiError(status, nil))
				end
				return
			end

			if status < 200 or status >= 300 or data.error then
				GeminiFail(MapGeminiError(status, data))
				return
			end

			local candidates = data.candidates
			if type(candidates) ~= "table" or #candidates == 0 then
				local reason = (type(data.promptFeedback) == "table" and data.promptFeedback.blockReason)
					and tostring(data.promptFeedback.blockReason) or nil
				GeminiFail("Gemini Error: Empty response" .. (reason and (" (blocked: " .. reason .. ").") or " (missing candidates)."))
				return
			end

			local cand = candidates[1]
			local parts = (type(cand) == "table" and type(cand.content) == "table") and cand.content.parts or nil
			if type(parts) ~= "table" or #parts == 0 then
				GeminiFail("Gemini Error: Missing content in response.")
				return
			end

			local chunks = {}
			for _, p in ipairs(parts) do
				if type(p) == "table" and type(p.text) == "string" then
					table.insert(chunks, p.text)
				end
			end
			local outText = table.concat(chunks, "")
			if Trim(outText) == "" then
				GeminiFail("Gemini Error: Empty response.")
				return
			end

			table.insert(Gemini.History, {role = "model", content = outText, ts = os.time()})
			AddBubble("model", outText, os.date("%H:%M"), true)
			TrimHistory()
			UpdateCounter()
			SaveChatHistory(true)

			local secs = math.floor((os.clock() - started) * 10 + 0.5) / 10
			SetStatus(string.format("REPLY IN %.1fs  -  %d chars", secs, #outText), "success")
			task.delay(4, function()
				if not Gemini.Sending and not State.Destroyed then
					SetStatus(State.Gemini.Mode == "Coder" and "CODER MODE - AI WRITES LUAU" or "CHAT MODE - READY", "idle")
				end
			end)

			-- Coder mode convenience: auto-copy the first code block
			if State.Gemini.Mode == "Coder" and LastCodeBlock and SetClip then
				pcall(SetClipboardText, LastCodeBlock)
			end
		end)
	end

	SendGeminiMessage = function(text)
		text = Trim(text)
		if text == "" then
			return
		end
		if text:sub(1, 1) == "/" and HandleSlashCommand(text) then
			return
		end
		if Gemini.Sending then
			Notify("Gemini", "Please wait - a response is generating.", 2, "Warning")
			return
		end
		if State.Gemini.ApiKey == "" then
			AddBubble("error", "Gemini Error: Missing API key. Open Settings -> Gemini AI and paste your key.")
			Notify("Gemini Error", "Missing API key.", 3, "Error")
			return
		end

		ChatInput.Text = ""
		table.insert(Gemini.History, {role = "user", content = text, ts = os.time()})
		AddBubble("user", text, os.date("%H:%M"))
		TrimHistory()
		UpdateCounter()

		Gemini.Sending = true
		Gemini.Generation = Gemini.Generation + 1
		local myGen = Gemini.Generation
		SetThinking(true)
		SetSendingUI(true)
		SetStatus("GEMINI IS THINKING...", "accent")
		StartStatusPulse()

		task.delay(120, function()
			if Gemini.Sending and myGen == Gemini.Generation and not State.Destroyed then
				Gemini.Generation = Gemini.Generation + 1
				Gemini.Sending = false
				SetThinking(false)
				SetSendingUI(false)
				StopStatusPulse()
				UpdateCounter()
				GeminiFail("Gemini Error: Request timed out.")
			end
		end)

		DispatchGemini(myGen, 1)
	end

	ResetChat = function(notifyText)
		Gemini.Generation = Gemini.Generation + 1
		Gemini.Sending = false
		SetThinking(false)
		SetSendingUI(false)
		StopStatusPulse()
		Gemini.History = {}
		LastCodeBlock = nil
		for _, child in ipairs(ChatScroll:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		UpdateCounter()
		SetStatus(State.Gemini.Mode == "Coder" and "CODER MODE - AI WRITES LUAU" or "CHAT MODE - READY", "idle")
		if notifyText then
			Notify("Gemini AI", notifyText, 2, "Info")
		end
		ScrollBottom()
	end

	LoadChatHistory = function(notifyIt)
		local raw = TryReadFile(ChatFile)
		local data = raw and SafeJSONDecode(raw)
		if not data or type(data.messages) ~= "table" or #data.messages == 0 then
			if notifyIt then
				Notify("Gemini AI", "No saved chat found.", 2, "Warning")
			end
			return false
		end
		ResetChat(nil)
		for _, m in ipairs(data.messages) do
			if type(m) == "table" and type(m.content) == "string" then
				local role = (m.role == "model") and "model" or "user"
				table.insert(Gemini.History, {role = role, content = m.content, ts = os.time()})
				AddBubble(role, m.content, nil, false)
			end
		end
		UpdateCounter()
		if notifyIt then
			Notify("Gemini AI", #Gemini.History .. " messages restored.", 2, "Success")
		end
		return true
	end

	local function Regenerate()
		if Gemini.Sending then
			Notify("Gemini", "Stop the current generation first.", 2, "Warning")
			return
		end
		while #Gemini.History > 0 and Gemini.History[#Gemini.History].role == "model" do
			table.remove(Gemini.History)
		end
		local lastUser = nil
		if #Gemini.History > 0 and Gemini.History[#Gemini.History].role == "user" then
			lastUser = Gemini.History[#Gemini.History].content
			table.remove(Gemini.History)
		end
		if not lastUser then
			Notify("Gemini", "Nothing to regenerate yet.", 2, "Warning")
			return
		end
		local historyCopy = {}
		for _, m in ipairs(Gemini.History) do
			table.insert(historyCopy, m)
		end
		ResetChat(nil)
		Gemini.History = historyCopy
		for _, m in ipairs(historyCopy) do
			AddBubble(m.role == "model" and "model" or "user", m.content, os.date("%H:%M"), false)
		end
		UpdateCounter()
		SendGeminiMessage(lastUser)
	end

	GeminiHooks.Regenerate = Regenerate

