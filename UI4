end

--// Executor HTTP bridge: request / http_request / syn.request / http.request
--// with a Studio-safe HttpService:RequestAsync fallback.
local RawRequest =
	(type(request) == "function" and request)
	or (type(http_request) == "function" and http_request)
	or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
	or (type(http) == "table" and type(http.request) == "function" and http.request)
	or (type(fluxus) == "table" and type(fluxus.request) == "function" and fluxus.request)

local function HttpPost(url, jsonBody)
	if RawRequest then
		return RawRequest({
			Url = url,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Accept"] = "application/json",
			},
			Body = jsonBody,
		})
	end
	-- fallback (Studio / local testing)
	return HttpService:RequestAsync({
		Url = url,
		Method = "POST",
		Headers = {["Content-Type"] = "application/json"},
		Body = jsonBody,
	})
end

local SetClip =
	(type(setclipboard) == "function" and setclipboard)
	or (type(toclipboard) == "function" and toclipboard)
	or nil

local function SetClipboardText(text)
	if SetClip then
		local ok = pcall(SetClip, tostring(text))
		return ok
	end
	return false
end

--// RichText escaping (used before any richtext formatting)
local function Esc(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	s = s:gsub('"', "&quot;")
	s = s:gsub("'", "&apos;")
	return s
end

--// Roblox's Gotham has no emoji glyphs, so unsupported codepoints render as
--// a tofu box. Strip them for display (the raw text is kept for copy/execute).
local function StripUnsupportedGlyphs(s)
	s = tostring(s or "")
	if type(utf8) ~= "table" or type(utf8.codes) ~= "function" then
		return s
	end
	local ok, out = pcall(function()
		local parts = {}
		for _, code in utf8.codes(s) do
			local drop =
				code >= 0x1F000                      -- emoji + pictographs
				or code == 0xFE0F or code == 0xFE0E  -- variation selectors
				or code == 0x200D or code == 0x20E3  -- ZWJ / keycap
				or (code >= 0xE000 and code <= 0xF8FF) -- private use
			if not drop then
				table.insert(parts, utf8.char(code))
			end
		end
		return table.concat(parts)
	end)
	if ok and type(out) == "string" then
		return out
	end
	return s
end

local function Truncate(s, max)
	s = tostring(s or "")
	if #s > max then
		return s:sub(1, max - 3) .. "..."
	end
	return s
end

local function Trim(s)
	return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function Color3ToHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5))
end

local function HexToColor3(s)
	s = tostring(s or ""):gsub("#", ""):gsub("%s", "")
	if #s == 3 then
		s = s:sub(1, 1) .. s:sub(1, 1) .. s:sub(2, 2) .. s:sub(2, 2) .. s:sub(3, 3) .. s:sub(3, 3)
	end
	if #s ~= 6 or s:find("[^0-9a-fA-F]") then
		return nil
	end
	local r = tonumber(s:sub(1, 2), 16)
	local g = tonumber(s:sub(3, 4), 16)
	local b = tonumber(s:sub(5, 6), 16)
	if not (r and g and b) then
		return nil
	end
	return Color3.fromRGB(r, g, b)
end

local function FormatNumber(v, step)
	if step and step % 1 ~= 0 then
		local out = string.format("%.2f", v)
		out = out:gsub("0+$", ""):gsub("%.$", "")
		return out
	end
	return tostring(math.floor(v + 0.5))
end

--// ======================================================================
--// MARKDOWN-LITE  (safe RichText formatting for Gemini responses)
--// ======================================================================

local function SplitCodeBlocks(text)
	local parts = {}
	text = tostring(text or "")
	local i = 1
	while true do
		local s, e = text:find("```", i, true)
		if not s then
			local rest = text:sub(i)
			if rest ~= "" then
				table.insert(parts, {code = false, text = rest})
			end
			break
		end
		if s > i then
			table.insert(parts, {code = false, text = text:sub(i, s - 1)})
		end
		local s2, e2 = text:find("```", e + 1, true)
		if not s2 then
			-- unterminated fence: treat the remainder as code
			table.insert(parts, {code = true, text = text:sub(e + 1)})
			break
		end
		local body = text:sub(e + 1, s2 - 1)
		body = body:gsub("^%w+\n", "") -- strip optional language tag line
		body = body:gsub("^\n", ""):gsub("\n$", "")
		table.insert(parts, {code = true, text = body})
		i = e2 + 1
	end
	if #parts == 0 then
		table.insert(parts, {code = false, text = ""})
	end
	return parts
end

local function FormatInline(s)
	s = Esc(s)
	s = s:gsub("%*%*(.-)%*%*", "<b>%1</b>")
	s = s:gsub("__(.-)__", "<b>%1</b>")
	s = s:gsub("%*([^%s*][^*]-)%*", "<i>%1</i>")
	s = s:gsub("`([^`]+)`", '<font color="#9CDCFE">%1</font>')
	return s
end

local function FormatChunk(text, baseSize)
	text = StripUnsupportedGlyphs(text)
	baseSize = baseSize or 13
	local out = {}
	for line in (tostring(text or "") .. "\n"):gmatch("(.-)\n") do
		local hashes, headerBody = line:match("^(#+)%s+(.+)$")
		if hashes and headerBody then
			local lvl = math.min(3, #hashes)
			local size = baseSize + (4 - lvl) * 2
			table.insert(out, string.format('<font size="%d"><b>%s</b></font>', size, FormatInline(headerBody)))
		else
			local listBody = line:match("^%s*[%-%*%+]%s+(.+)$")
			if listBody then
				table.insert(out, "  •  " .. FormatInline(listBody))
			else
				table.insert(out, FormatInline(line))
			end
		end
	end
	local result = table.concat(out, "\n")
	if result == "" then
		result = " "
	end
	return result
end

