			BackgroundColor3 = Theme().Background,
			BackgroundTransparency = Theme().BackgroundTransparency,
			BorderSizePixel = 0,
			Text = value.Name,
			TextColor3 = Theme().TextDim,
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			ZIndex = 91,
		})
		Corner(keyBtn, 8)
		Stroke(keyBtn, Theme().Stroke, 1)

		local function SetValue(v, silent)
			if typeof(v) == "EnumItem" then
				value = v
			elseif type(v) == "string" and Enum.KeyCode[v] then
				value = Enum.KeyCode[v]
			end
			keyBtn.Text = value.Name
			if not silent then
				SafeCall(callback, value)
			end
		end

		keyBtn.MouseButton1Click:Connect(function()
			listening = true
			keyBtn.Text = "..."
			keyBtn.TextColor3 = Theme().Accent
		end)

		AddConn(UIS.InputBegan:Connect(function(input, gp)
			if not listening then
				return
			end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = false
				keyBtn.Text = value.Name
				keyBtn.TextColor3 = Theme().TextDim
				return
			end
			listening = false
			keyBtn.TextColor3 = Theme().TextDim
			SetValue(input.KeyCode)
			Persist()
		end))

		AddRefresher(function()
			row.BackgroundColor3 = Theme().Surface2
			row.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			keyBtn.BackgroundColor3 = Theme().Background
			keyBtn.BackgroundTransparency = Theme().BackgroundTransparency
			if not listening then
				keyBtn.TextColor3 = Theme().TextDim
			end
			Stroke(row, Theme().Stroke, 1)
			Stroke(keyBtn, Theme().Stroke, 1)
		end)

		local api = {Instance = row}
		api.Get = Dual(function()
			return value
		end)
		api.Set = Dual(function(v, silent)
			SetValue(v, silent)
		end)
		return WrapInstance(api, row)
	end

