		end
		StatusPulse = true
		task.spawn(function()
			while StatusPulse and not State.Destroyed do
				Tween(StatusLabel, {TextTransparency = 0.55}, 0.45)
				task.wait(0.5)
				Tween(StatusLabel, {TextTransparency = 0}, 0.45)
