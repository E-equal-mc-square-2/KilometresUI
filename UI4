			end
		end)
		TabButton.MouseLeave:Connect(function()
			if not Data.Active then
				Tween(TabButton, {BackgroundColor3 = Theme().Surface2}, 0.15)
			end
		end)

		local Page
		if opts.Raw then
			Page = New("Frame", {
				Parent = PageHolder,
				Visible = false,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 35,
			})
		else
			Page = New("ScrollingFrame", {
				Parent = PageHolder,
				Visible = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
