		end)

		local api = {Instance = row}
		api.Get = Dual(function()
			return color
		end)
		api.Set = Dual(function(c, silent)
			if typeof(c) == "Color3" then
				suppress = true
				slR.Set(math.floor(c.R * 255 + 0.5), true)
				slG.Set(math.floor(c.G * 255 + 0.5), true)
