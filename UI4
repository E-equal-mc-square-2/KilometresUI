	sh.ScaleType = Enum.ScaleType.Slice
	sh.SliceCenter = Rect.new(49, 49, 450, 450)
	sh.Size = UDim2.new(1, spread * 2, 1, spread * 2)
	sh.Position = UDim2.new(0, -spread, 0, -spread + 3)
	sh.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
