function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local SaveFile = cfg.SaveFile or "KilometresUIX/settings.json"

	------------------------------------------------------------------
	-- CONFIGURATION / STATE
	------------------------------------------------------------------

	local Defaults = {
		ThemeName = "LiquidGlass",
		Width = 750,
		Height = 360,
		OffsetX = 0,
		OffsetY = 0,
		SaveSettings = true,
		Hotkey = Enum.KeyCode.RightShift,
	}

	local State = {
		ThemeName = Defaults.ThemeName,
		Width = Defaults.Width,
		Height = Defaults.Height,
		OffsetX = Defaults.OffsetX,
		OffsetY = Defaults.OffsetY,
		SaveSettings = Defaults.SaveSettings,
		Hotkey = Defaults.Hotkey,
		Hidden = false,
		Minimized = false,
		Destroyed = false,
		Refreshers = {},
		Connections = {},
		ActiveTab = nil,
		TabCounter = 0,
		Gemini = {
			ApiKey = "",
			Model = "gemini-2.5-flash",
			Endpoint = DEFAULT_GEMINI_ENDPOINT,
			Temperature = 0.7,
			MaxTokens = 1024,
			SystemPrompt = "",
		},
	}

	-- forward declarations (V5 bugfix: these were referenced before their
	-- `local` declaration, silently resolving as globals in old handlers)
	local UpdateLayout
	local SetHidden
	local SetMinimized
	local SetTheme
	local ApplyLoadedState
	local WidthSlider
	local HeightSlider

	local GeminiRefs = {}

	local function AddConn(conn)
		if conn then
			table.insert(State.Connections, conn)
		end
		return conn
	end

	local function Theme()
		return Themes[State.ThemeName] or Themes.Default
	end

	local function AddRefresher(fn)
		table.insert(State.Refreshers, fn)
	end

	local function RefreshAll()
		for _, fn in ipairs(State.Refreshers) do
			pcall(fn)
		end
	end

	local function Persist()
		if not State.SaveSettings then
			return
		end
		local payload = {
			Version = "V7",
			ThemeName = State.ThemeName,
			Width = State.Width,
			Height = State.Height,
			OffsetX = math.floor(State.OffsetX + 0.5),
			OffsetY = math.floor(State.OffsetY + 0.5),
			SaveSettings = State.SaveSettings,
			Hotkey = tostring(State.Hotkey),
			Gemini = {
				ApiKey = State.Gemini.ApiKey,
				Model = State.Gemini.Model,
				Endpoint = State.Gemini.Endpoint,
				Temperature = State.Gemini.Temperature,
				MaxTokens = State.Gemini.MaxTokens,
				SystemPrompt = State.Gemini.SystemPrompt,
			},
		}
		local json = SafeJSONEncode(payload)
		if json then
			TryWriteFile(SaveFile, json)
		end
	end

	local function LoadPersisted()
		local raw = TryReadFile(SaveFile)
		if not raw then
			-- no file: defaults already present; create the file once
			Persist()
			return
		end

		local data = SafeJSONDecode(raw)
		if not data then
			-- corrupted file: recover safely instead of crashing
			local backup = SaveFile .. ".broken"
			TryWriteFile(backup, raw)
			Persist()
			return
		end

		State.ThemeName = (type(data.ThemeName) == "string" and Themes[data.ThemeName] and data.ThemeName) or State.ThemeName
