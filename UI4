	local function AddBubble(kind, text, stamp)
		local T = Theme()
		local isUser = (kind == "user")
		local isError = (kind == "error")

		local row = New("Frame", {
			Parent = ChatScroll,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 52,
		})

		local bubble = New("Frame", {
			Parent = row,
			AnchorPoint = Vector2.new(isUser and 1 or 0, 0),
			Position = UDim2.new(isUser and 1 or 0, 0, 0, 0),
			Size = UDim2.new(0.8, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = isUser and T.Accent or (isError and T.Error or T.Surface2),
			BackgroundTransparency = isError and 0.25 or (isUser and 0 or T.Surface2Transparency),
			BorderSizePixel = 0,
			ZIndex = 53,
		})
		Corner(bubble, 14)
		if not isUser then
			Stroke(bubble, isError and T.Error or T.Stroke, 1)
		end
		New("UIPadding", {Parent = bubble, PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)})
		New("UIListLayout", {Parent = bubble, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder})

		local whoText = isUser and "You" or (isError and "Error" or "Gemini")
		if stamp then
			whoText = whoText .. "  ·  " .. stamp
		end
		local meta = New("TextLabel", {
			Parent = bubble,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 12),
			Text = whoText,
			TextColor3 = isUser and Color3.new(1, 1, 1) or T.TextDim,
			TextTransparency = isUser and 0.25 or 0,
			TextSize = 10,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 54,
		})

		local textColor = isUser and Color3.new(1, 1, 1) or (isError and Color3.fromRGB(255, 226, 226) or T.Text)

		if isUser or isError then
			New("TextLabel", {
				Parent = bubble,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = " ",
				RichText = true,
				TextColor3 = textColor,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 54,
			}).Text = Esc(text)
		else
			-- model message: markdown-lite formatting + code blocks
			for _, seg in ipairs(SplitCodeBlocks(text)) do
				if seg.code then
					local codeFrame = New("Frame", {
						Parent = bubble,
						BackgroundColor3 = ColorLerp(T.Surface2, Color3.new(0, 0, 0), 0.35),
						BackgroundTransparency = 0.15,
