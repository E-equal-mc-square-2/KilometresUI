local Library = {}

function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local SaveFile = cfg.SaveFile or "KilometresUIX/v6_settings.json"

	local State = {
		ThemeName = "LiquidGlass",
		Width = 750,
		Height = 360,
		SaveSettings = true,
		Hidden = false,
		Refreshers = {},
		ActiveTab = nil,
		Hotkey = Enum.KeyCode.RightShift,
		OffsetX = 0, OffsetY = 0,
		GeminiKey = "",
	}

	local function Theme() return Themes[State.ThemeName] or Themes.Default end
	local function AddRefresher(fn) table.insert(State.Refreshers, fn) end
	local function RefreshAll() for _, fn in ipairs(State.Refreshers) do pcall(fn) end end

	local function Persist()
		if not State.SaveSettings then return end
		local payload = {
			ThemeName = State.ThemeName, Width = State.Width, Height = State.Height,
			SaveSettings = State.SaveSettings, Hotkey = tostring(State.Hotkey),
			GeminiKey = State.GeminiKey
		}
		pcall(function()
			if writefile then writefile(SaveFile, HttpService:JSONEncode(payload)) end
		end)
	end

	pcall(function()
		if isfile and isfile(SaveFile) then
			local data = HttpService:JSONDecode(readfile(SaveFile))
			State.ThemeName = data.ThemeName or State.ThemeName
			State.Width = data.Width or State.Width
			State.Height = data.Height or State.Height
			State.GeminiKey = data.GeminiKey or ""
		end
	end)

	local Screen = New("ScreenGui", {Name = "KilometresV6", Parent = SafeParent(), IgnoreGuiInset = true})
	
	local Main = New("Frame", {
		Parent = Screen, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(State.Width, State.Height), BackgroundColor3 = Theme().Background,
		BackgroundTransparency = Theme().BackgroundTransparency, BorderSizePixel = 0, ZIndex = 1
	})
	Corner(Main, 18)
	local MainStroke = Stroke(Main, Theme().Stroke, 1.2)

	local Topbar = New("Frame", {Parent = Main, Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, ZIndex = 5})
	local Title = New("TextLabel", {
		Parent = Topbar, BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -150, 0, 24), Text = cfg.Title or "KILOMETRES UI X V6",
		TextColor3 = Theme().Text, TextSize = 18, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left
	})

	local ButtonContainer = New("Frame", {
		Parent = Topbar, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(120, 30), BackgroundTransparency = 1
	})
	New("UIListLayout", {Parent = ButtonContainer, FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8)})

	local function TopBtn(txt, callback)
		local b = New("TextButton", {
			Parent = ButtonContainer, Size = UDim2.fromOffset(30, 30), BackgroundColor3 = Theme().Surface2,
			Text = txt, TextColor3 = Theme().Text, Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = false
		})
		Corner(b, 8)
		Stroke(b, Theme().Stroke, 1)
		b.MouseButton1Click:Connect(callback)
		b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3 = Theme().Accent, TextColor3 = Color3.new(0,0,0)}, 0.1) end)
		b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3 = Theme().Surface2, TextColor3 = Theme().Text}, 0.1) end)
		return b
	end

	local HideBtn = TopBtn("–", function() State.Hidden = true Main.Visible = false end)
	local SettingsBtn = TopBtn("⚙", nil) -- Logic added later

	-- Dragging Logic
	do
		local dragToggle, dragStart, startPos
		Topbar.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragToggle = true dragStart = input.Position startPos = Main.Position
			end
		end)
		UIS.InputChanged:Connect(function(input)
			if dragToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end)
		UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragToggle = false end end)
	end

	local TabHolder = New("ScrollingFrame", {
		Parent = Main, Position = UDim2.fromOffset(12, 60), Size = UDim2.new(0, 180, 1, -72),
		BackgroundTransparency = 1, ScrollBarThickness = 0, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y
	})
	New("UIListLayout", {Parent = TabHolder, Padding = UDim.new(0, 6)})

	local PageHolder = New("Frame", {
		Parent = Main, Position = UDim2.fromOffset(205, 60), Size = UDim2.new(1, -217, 1, -72), BackgroundTransparency = 1
	})

	local Tabs = {}
	function Library:CreateTab(name)
		local Tab = {}
		local TabBtn = New("TextButton", {
			Parent = TabHolder, Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme().Surface,
			Text = name, TextColor3 = Theme().TextDim, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false
		})
		Corner(TabBtn, 10)
		local TabStroke = Stroke(TabBtn, Theme().Stroke, 1)

		local Page = New("ScrollingFrame", {
			Parent = PageHolder, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Visible = false, ScrollBarThickness = 2, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y
		})
		New("UIListLayout", {Parent = Page, Padding = UDim.new(0, 10)})
		New("UIPadding", {Parent = Page, PaddingLeft = UDim.new(0,2), PaddingRight = UDim.new(0,5)})

		TabBtn.MouseButton1Click:Connect(function()
			for _, t in pairs(Tabs) do
				t.Page.Visible = false
				Tween(t.Btn, {BackgroundColor3 = Theme().Surface, TextColor3 = Theme().TextDim}, 0.15)
			end
			Page.Visible = true
			Tween(TabBtn, {BackgroundColor3 = Theme().Accent, TextColor3 = Color3.new(1,1,1)}, 0.15)
		end)

		function Tab:CreateSection(title)
			local Sect = {}
			local SectFrame = New("Frame", {
				Parent = Page, Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Theme().Surface2, BackgroundTransparency = 0.5
			})
			Corner(SectFrame, 12)
			New("UIListLayout", {Parent = SectFrame, Padding = UDim.new(0, 8)})
			New("UIPadding", {Parent = SectFrame, PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)})
			
			New("TextLabel", {
				Parent = SectFrame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
				Text = title:upper(), TextColor3 = Theme().Accent, Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left
			})

			function Sect:Button(txt, cb)
				local b = New("TextButton", {
					Parent = SectFrame, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme().Surface,
					Text = txt, TextColor3 = Theme().Text, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false
				})
				Corner(b, 8)
				Stroke(b, Theme().Stroke, 1)
				b.MouseButton1Click:Connect(function()
					Tween(b, {BackgroundColor3 = Theme().Accent}, 0.05)
					task.wait(0.05)
					Tween(b, {BackgroundColor3 = Theme().Surface}, 0.2)
					if cb then cb() end
				end)
			end

			function Sect:Toggle(txt, def, cb)
				local state = def or false
				local t = New("TextButton", {
					Parent = SectFrame, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme().Surface,
					Text = "  " .. txt, TextColor3 = Theme().Text, Font = Enum.Font.GothamMedium, TextSize = 13,
					AutoButtonColor = false, TextXAlignment = Enum.TextXAlignment.Left
				})
				Corner(t, 8)
				local tog = New("Frame", {
					Parent = t, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
					Size = UDim2.fromOffset(34, 18), BackgroundColor3 = state and Theme().Accent or Theme().Surface2
				})
				Corner(tog, 10)
				local ball = New("Frame", {
					Parent = tog, Position = state and UDim2.fromScale(0.6, 0.1) or UDim2.fromScale(0.1, 0.1),
					Size = UDim2.fromScale(0.3, 0.8), BackgroundColor3 = Color3.new(1,1,1)
				})
				Corner(ball, 10)

				t.MouseButton1Click:Connect(function()
					state = not state
					Tween(tog, {BackgroundColor3 = state and Theme().Accent or Theme().Surface2}, 0.2)
					Tween(ball, {Position = state and UDim2.fromScale(0.6, 0.1) or UDim2.fromScale(0.1, 0.1)}, 0.2)
					if cb then cb(state) end
				end)
			end

			return Sect
		end

		table.insert(Tabs, {Btn = TabBtn, Page = Page})
		if #Tabs == 1 then TabBtn.MouseButton1Click:Fire() end
		return Tab
	end

	--// ======================================================================
	--// GEMINI AI TAB
	--// ======================================================================
	local ChatTab = Library:CreateTab("Gemini Chat")
	local ChatSect = ChatTab:CreateSection("AI Assistant")
	
	local ChatContainer = New("ScrollingFrame", {
		Parent = ChatSect.Page, Size = UDim2.new(1, 0, 0, 180), BackgroundColor3 = Theme().Surface,
		ScrollBarThickness = 2, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y
	})
	Corner(ChatContainer, 10)
	New("UIListLayout", {Parent = ChatContainer, Padding = UDim.new(0, 8)})
	New("UIPadding", {Parent = ChatContainer, PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)})

	local InputBox = New("TextBox", {
		Parent = ChatSect.Page, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme().Surface2,
		PlaceholderText = "Type message here...", Text = "", TextColor3 = Theme().Text, Font = Enum.Font.Gotham, TextSize = 13
	})
	Corner(InputBox, 10)
	Stroke(InputBox, Theme().Stroke, 1)

	local function AddBubble(sender, msg)
		local b = New("TextLabel", {
			Parent = ChatContainer, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = sender == "You" and Theme().Accent or Theme().Surface2,
			Text = "<b>" .. sender .. ":</b> " .. msg, TextColor3 = sender == "You" and Color3.new(0,0,0) or Theme().Text,
			Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, RichText = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})
		Corner(b, 8)
		New("UIPadding", {Parent = b, PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)})
		ChatContainer.CanvasPosition = Vector2.new(0, ChatContainer.AbsoluteCanvasSize.Y)
	end

	InputBox.FocusLost:Connect(function(enter)
		if not enter or InputBox.Text == "" then return end
		local query = InputBox.Text
		InputBox.Text = ""
		AddBubble("You", query)

		if State.GeminiKey == "" then
			AddBubble("System", "Please set your Gemini API Key in the Settings tab.")
			return
		end

		task.spawn(function()
			AddBubble("Gemini", "Thinking...")
			local thinkingLabel = ChatContainer:GetChildren()[#ChatContainer:GetChildren() - 1]
			
			local success, response = pcall(function()
				local url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" .. State.GeminiKey
				return HttpService:PostAsync(url, HttpService:JSONEncode({
					contents = {{ parts = {{ text = query }} }}
				}))
			end)

			if success then
				local data = HttpService:JSONDecode(response)
				local reply = data.candidates[1].content.parts[1].text
				thinkingLabel.Text = "<b>Gemini:</b> " .. reply
			else
				thinkingLabel.Text = "<b>Gemini:</b> Error connecting to API."
			end
		end)
	end)

	--// ======================================================================
	--// SETTINGS TAB
	--// ======================================================================
	local SetTab = Library:CreateTab("Settings")
	local ThemesSect = SetTab:CreateSection("Appearance")
	
	for _, tInfo in ipairs(ThemeList) do
		ThemesSect:Button("Theme: " .. tInfo.Label, function()
			State.ThemeName = tInfo.Key
			Main.BackgroundColor3 = Theme().Background
			MainStroke.Color = Theme().Stroke
			RefreshAll()
			Persist()
		end)
	end

	local MiscSect = SetTab:CreateSection("Integrations")
	local KeyInput = New("TextBox", {
		Parent = MiscSect.Page, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme().Surface,
		PlaceholderText = "Paste Gemini API Key Here", Text = State.GeminiKey, TextColor3 = Theme().Text, Font = Enum.Font.Gotham, TextSize = 12
	})
	Corner(KeyInput, 10)
	KeyInput.FocusLost:Connect(function() State.GeminiKey = KeyInput.Text Persist() end)

	-- Notification Logic
	function Library:Notify(title, msg)
		local n = New("Frame", {
			Parent = Screen, Position = UDim2.new(1, 10, 0, 20), Size = UDim2.fromOffset(250, 60),
			BackgroundColor3 = Theme().Surface, ZIndex = 100
		})
		Corner(n, 12)
		Stroke(n, Theme().Accent, 1)
		New("TextLabel", {Parent = n, Position = UDim2.fromOffset(10, 10), Text = title, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme().Accent, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left})
		New("TextLabel", {Parent = n, Position = UDim2.fromOffset(10, 30), Text = msg, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme().Text, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left})
		
		Tween(n, {Position = UDim2.new(1, -260, 0, 20)}, 0.4)
		task.delay(3, function()
			Tween(n, {Position = UDim2.new(1, 10, 0, 20)}, 0.4)
			task.wait(0.4) n:Destroy()
		end)
	end

	-- Hotkey toggle
	UIS.InputBegan:Connect(function(input)
		if input.KeyCode == State.Hotkey then
			Main.Visible = not Main.Visible
		end
	end)

	Library:Notify("Success", "Kilometres UI X V6 Loaded")
	return Library
end

return Library
