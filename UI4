end

--// coloured glow ring behind a frame (used for the tab indicator + orb)
local function Glow(parent, target, color, spread, transparency)
	local g = Instance.new("ImageLabel")
	g.Name = "KM_Glow"
	g.BackgroundTransparency = 1
	g.Image = SHADOW_ASSET
	g.ImageColor3 = color
	g.ImageTransparency = transparency or 0.55
	g.ScaleType = Enum.ScaleType.Slice
	g.SliceCenter = Rect.new(49, 49, 450, 450)
	g.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
	g.AnchorPoint = target.AnchorPoint
	g.Parent = parent
	spread = spread or 10
	local function sync()
		g.Size = UDim2.new(
			target.Size.X.Scale, target.Size.X.Offset + spread * 2,
			target.Size.Y.Scale, target.Size.Y.Offset + spread * 2
		)
		g.Position = UDim2.new(
			target.Position.X.Scale, target.Position.X.Offset - 0,
			target.Position.Y.Scale, target.Position.Y.Offset
		)
		g.Visible = target.Visible
	end
	sync()
	target:GetPropertyChangedSignal("Size"):Connect(sync)
	target:GetPropertyChangedSignal("Position"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	return g
end

local function Tween(obj, props, speed, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(speed or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function Clamp(v, mn, mx)
	return math.max(mn, math.min(mx, v))
end

local function Lerp(a, b, t)
	return a + (b - a) * t
end

local function ColorLerp(a, b, t)
	return Color3.new(Lerp(a.R, b.R, t), Lerp(a.G, b.G, t), Lerp(a.B, b.B, t))
end

local function SafeCall(fn, ...)
	if type(fn) == "function" then
		local args = {...}
		task.spawn(function()
			pcall(fn, unpack(args))
		end)
	end
end

local function IsPortrait()
	local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
	return vp.Y > vp.X
end

local function TryReadFile(path)
	if type(isfile) == "function" and type(readfile) == "function" and isfile(path) then
		local ok, data = pcall(readfile, path)
		if ok and type(data) == "string" then
			return data
		end
	end
	return nil
end

local function TryWriteFile(path, data)
	if type(makefolder) == "function" then
		local folder = path:match("^(.*)/[^/]+$")
		if folder and folder ~= "" then
			pcall(function()
				if type(isfolder) == "function" and not isfolder(folder) then
					makefolder(folder)
				end
			end)
		end
	end
	if type(writefile) == "function" then
		pcall(writefile, path, data)
	end
end

local function SafeJSONEncode(tbl)
	local ok, res = pcall(function()
		return HttpService:JSONEncode(tbl)
	end)
	if ok then
