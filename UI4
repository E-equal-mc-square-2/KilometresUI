local function SafeParent()
	if type(gethui) == "function" then
		local ok, ui = pcall(gethui)
		if ok and ui then
			return ui
		end
	end
	if PlayerGui then
		return PlayerGui
	end
	return CoreGui
end

local function New(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			obj[k] = v
		end
	end
	if props and props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

--// live "Roundness" multiplier (Settings -> Appearance). Pill radii (>=900)
--// are left alone so circles stay circles.
local RoundnessMult = 1

local function ScaledRadius(radius)
	if radius >= 900 then
		return radius
	end
	return math.max(0, math.floor(radius * RoundnessMult + 0.5))
end

local function Corner(obj, radius)
	radius = radius or 14
	local c = New("UICorner", {
		Parent = obj,
		CornerRadius = UDim.new(0, ScaledRadius(radius)),
	})
	-- remembered so the "Roundness" slider can rescale every corner live
	c:SetAttribute("KM_BaseRadius", radius)
	return c
end

--// V7 FIX: reuses an existing UIStroke instead of stacking a new one
--// every time a theme refresher runs (V5 leaked one UIStroke per refresh).
local function Stroke(obj, color, thickness)
	local s = obj:FindFirstChildOfClass("UIStroke")
	if not s then
		s = Instance.new("UIStroke")
		s.Thickness = thickness or 1
		s.Parent = obj
	end
	s.Color = color
	if thickness then
		s.Thickness = thickness
	end
	return s
end

--// V8.5 visual helpers: gradients, soft shadows, glows
local function Gradient(obj, c1, c2, rotation, transparency)
	local g = obj:FindFirstChildOfClass("UIGradient")
	if not g then
		g = Instance.new("UIGradient")
		g.Parent = obj
	end
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(1, c2),
	})
	g.Rotation = rotation or 0
	if transparency then
		g.Transparency = transparency
	end
	return g
end

local SHADOW_ASSET = "rbxassetid://6015045625"

--// soft drop shadow: `host` must not clip, `target` is the frame it hugs
local function Shadow(host, target, spread, transparency, color)
	local sh = Instance.new("ImageLabel")
	sh.Name = "KM_Shadow"
	sh.BackgroundTransparency = 1
	sh.Image = SHADOW_ASSET
	sh.ImageColor3 = color or Color3.new(0, 0, 0)
	sh.ImageTransparency = transparency or 0.55
	sh.ScaleType = Enum.ScaleType.Slice
	sh.SliceCenter = Rect.new(49, 49, 450, 450)
	sh.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
	sh.AnchorPoint = target.AnchorPoint
	sh.Parent = host

	spread = spread or 22
	local function sync()
		sh.Size = UDim2.new(
			target.Size.X.Scale, target.Size.X.Offset + spread * 2,
			target.Size.Y.Scale, target.Size.Y.Offset + spread * 2
		)
		sh.Position = UDim2.new(
			target.Position.X.Scale, target.Position.X.Offset,
			target.Position.Y.Scale, target.Position.Y.Offset + 4
		)
		sh.Visible = target.Visible
	end
	sync()
	target:GetPropertyChangedSignal("Size"):Connect(sync)
	target:GetPropertyChangedSignal("Position"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	return sh
end

--// shadow drawn as a child of the frame itself - use this when the frame is
--// managed by a UIListLayout (a sibling shadow would become a list item)
