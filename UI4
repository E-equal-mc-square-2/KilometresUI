						Parent = codeFrame,
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						Text = seg.text,
						TextColor3 = Color3.fromRGB(220, 230, 245),
						TextSize = 12,
						Font = Enum.Font.Code,
						TextWrapped = true,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						ZIndex = 55,
					})
