		function Data.Activate()
			if State.Hidden or State.Minimized then
				SetMinimized(false)
			end
			for _, t in ipairs(Tabs) do
				t.Active = false
				t.Page.Visible = false
				Tween(t.LandButton, {BackgroundColor3 = Theme().Surface2}, 0.15)
				Tween(t.PortButton, {BackgroundColor3 = Theme().Surface2}, 0.15)
				Tween(t.LandLabel, {TextColor3 = Theme().TextDim}, 0.15)
