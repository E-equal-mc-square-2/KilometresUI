--// LUA SYNTAX HIGHLIGHTER (used by the Gemini code blocks)
--// ======================================================================

local SyntaxColors = {
	Keyword  = "#F86D7C",
	Global   = "#FFCB6B",
	Function = "#82AAFF",
	String   = "#C3E88D",
	Number   = "#F78C6C",
	Comment  = "#676E95",
}

local LuaKeywords = {
	"and", "break", "do", "elseif", "else", "end", "false", "for", "function",
	"if", "in", "local", "nil", "not", "or", "repeat", "return", "then",
	"true", "until", "while", "continue",
}

local LuaGlobals = {
	"game", "workspace", "script", "task", "wait", "spawn", "print", "warn",
	"pairs", "ipairs", "tostring", "tonumber", "typeof", "Instance", "Vector3",
	"Vector2", "CFrame", "Color3", "UDim2", "UDim", "Enum", "math", "string",
	"table", "os", "pcall", "loadstring",
}

local function HighlightLua(code)
	code = tostring(code or "")
	code = code:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	-- strings first so keywords inside them are not recolored
	code = code:gsub('("[^"\n]*")', '<font color="' .. SyntaxColors.String .. '">%1</font>')
	code = code:gsub("('[^'\n]*')", '<font color="' .. SyntaxColors.String .. '">%1</font>')
	code = code:gsub("(%W)(%d+%.?%d*)", '%1<font color="' .. SyntaxColors.Number .. '">%2</font>')
	for _, kw in ipairs(LuaKeywords) do
		code = code:gsub("([^%w_])(" .. kw .. ")([^%w_])", '%1<font color="' .. SyntaxColors.Keyword .. '">%2</font>%3')
		code = code:gsub("^(" .. kw .. ")([^%w_])", '<font color="' .. SyntaxColors.Keyword .. '">%1</font>%2')
	end
	for _, gl in ipairs(LuaGlobals) do
		code = code:gsub("([^%w_%.])(" .. gl .. ")([^%w_])", '%1<font color="' .. SyntaxColors.Global .. '">%2</font>%3')
	end
	code = code:gsub("([%w_]+)(%s*%()", '<font color="' .. SyntaxColors.Function .. '">%1</font>%2')
	code = code:gsub("(%-%-[^\n]*)", '<font color="' .. SyntaxColors.Comment .. '">%1</font>')
	return code
end

