					local lbl = New("TextLabel", {
						Parent = bubble,
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						RichText = true,
						Text = " ",
						TextColor3 = textColor,
						TextSize = 13,
