		Notify("UIBG", "Downloading 20 wallpapers into img/ ...", 2.5, "Info")
		task.spawn(function()
			EnsureImgFolder()
			local done, failed = 0, 0
			for i, wp in ipairs(WALLPAPERS) do
				if State.Destroyed then
					return
				end
				if CacheWallpaper(wp) then
					done = done + 1
					if UIBGRefs.SetCellImage then
						UIBGRefs.SetCellImage(i)
					end
				else
					failed = failed + 1
				end
				cacheInfo.Text = string.format("Downloading... %d/%d (%d failed)", done, #WALLPAPERS, failed)
				task.wait(0.05)
			end
			RefreshCacheInfo()
			ApplyWallpaper(true)
			Notify("UIBG", string.format("img/ ready - %d saved, %d failed.", done, failed), 3, done > 0 and "Success" or "Error")
