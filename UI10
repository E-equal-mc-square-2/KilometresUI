	local function CreateSlider(parent, text, min, max, default, callback, step, flag)
		min = tonumber(min) or 0
		max = tonumber(max) or 100
		step = tonumber(step) or 1
		local value = Clamp(tonumber(default) or min, min, max)
		if flag and type(State.Flags[flag]) == "number" then value = State.Flags[flag] end
		local slider = New("Frame", {
			Parent = parent, Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0, ZIndex = 90,
		})
		Round(slider, 12)
		Stroke(slider, Theme().Stroke, 1)
		local label = New("TextLabel", {
			Parent = slider, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 8),
			Size = UDim2.new(1, -90, 0, 16), Text = text, TextColor3 = Theme().Text,
			TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 91,
		})
		local valueLabel = New("TextLabel", {
			Parent = slider, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(72, 16),
			Text = FormatNumber(value, step), TextColor3 = Theme().TextDim,
			TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 91,
		})
		local bar = New("Frame", {
			Parent = slider, Position = UDim2.fromOffset(12, 36), Size = UDim2.new(1, -24, 0, 6),
			BackgroundColor3 = Color3.fromRGB(45, 45, 55), BorderSizePixel = 0, ZIndex = 91,
		})
		Round(bar, 999)
		local fill = New("Frame", {
			Parent = bar, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme().Accent,
			BorderSizePixel = 0, ZIndex = 92,
		})
		Round(fill, 999)
		local knob = New("Frame", {
			Parent = bar, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0, ZIndex = 93,
		})
		Round(knob, 999)
		local dragging = false
		local function SetValue(v, silent)
			v = Clamp(tonumber(v) or min, min, max)
			if step and step > 0 then v = math.floor((v / step) + 0.5) * step end
			v = Clamp(v, min, max)
			value = v
			valueLabel.Text = FormatNumber(value, step)
			local pct = (value - min) / math.max(1e-9, max - min)
			Tween(fill, { Size = UDim2.new(pct, 0, 1, 0) }, Motion(0.08))
			Tween(knob, { Position = UDim2.new(pct, 0, 0.5, 0) }, Motion(0.08))
			if flag then State.Flags[flag] = value end
			if not silent then SafeCall(callback, value) end
		end
		local function FromInput(input)
			local rel = (input.Position.X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X)
			SetValue(min + (max - min) * Clamp(rel, 0, 1))
		end
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true FromInput(input)
			end
		end)
		AddConn(UIS.InputEnded:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = false Persist()
			end
		end))
		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				FromInput(input)
			end
		end))
		AddRefresher(function()
			slider.BackgroundColor3 = Theme().Surface2
			slider.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			valueLabel.TextColor3 = Theme().TextDim
			fill.BackgroundColor3 = Theme().Accent
			Stroke(slider, Theme().Stroke, 1)
		end)
		SetValue(value, true)
		if flag then RegisterFlag(flag, SetValue, function() return value end) end
		local api = { Instance = slider, Frame = slider }
		api.Set = Dual(SetValue)
		api.Get = Dual(function() return value end)
		return WrapInstance(api, slider)
	end

	local function CreateInput(parent, text, a2, a3, a4)
		local placeholder, defaultText, callback, flag = "", "", nil, nil
		if type(a2) == "table" then
			placeholder = a2.Placeholder or ""
			defaultText = a2.Default or a2.Text or ""
			callback = a2.Callback
			flag = a2.Flag
		else
			placeholder = tostring(a2 or "")
			if type(a3) == "function" then callback = a3 else defaultText = tostring(a3 or "") callback = a4 end
		end
		if flag and type(State.Flags[flag]) == "string" then defaultText = State.Flags[flag] end
		local wrap = New("Frame", {
			Parent = parent, Size = UDim2.new(1, 0, 0, 64),
			BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0, ZIndex = 90,
		})
		Round(wrap, 12)
		Stroke(wrap, Theme().Stroke, 1)
		local label = New("TextLabel", {
			Parent = wrap, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 8),
			Size = UDim2.new(1, -24, 0, 16), Text = text, TextColor3 = Theme().Text,
			TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 91,
		})
		local box = New("TextBox", {
			Parent = wrap, Position = UDim2.fromOffset(12, 28), Size = UDim2.new(1, -24, 0, 26),
			BackgroundColor3 = Theme().Background, BackgroundTransparency = Theme().BackgroundTransparency,
			BorderSizePixel = 0, ClearTextOnFocus = false, Text = tostring(defaultText or ""),
			PlaceholderText = placeholder, TextColor3 = Theme().Text, PlaceholderColor3 = Theme().TextDim,
			TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 91,
		})
		Round(box, 8)
		Stroke(box, Theme().Stroke, 1)
		New("UIPadding", { Parent = box, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) })
		local function Commit()
			if flag then State.Flags[flag] = box.Text end
			SafeCall(callback, box.Text)
			Persist()
		end
		box.FocusLost:Connect(function() Commit() end)
		AddRefresher(function()
			wrap.BackgroundColor3 = Theme().Surface2
			wrap.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			box.BackgroundColor3 = Theme().Background
			box.TextColor3 = Theme().Text
			box.PlaceholderColor3 = Theme().TextDim
			Stroke(wrap, Theme().Stroke, 1)
			Stroke(box, Theme().Stroke, 1)
		end)
		if flag then
			RegisterFlag(flag, function(v) box.Text = tostring(v or "") end, function() return box.Text end)
		end
		local api = { Instance = wrap, Box = box }
		api.Get = Dual(function() return box.Text end)
		api.Set = Dual(function(v) box.Text = tostring(v or "") end)
		api.Clear = Dual(function() box.Text = "" end)
		return WrapInstance(api, wrap), box
	end

	local function CreateDropdown(parent, text, options, default, callback, flag)
		options = options or {}
		local selected = default or options[1]
		if flag and State.Flags[flag] ~= nil then selected = State.Flags[flag] end
		local opened = false
		local Holder = New("Frame", {
			Parent = parent, Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0, ZIndex = 90,
		})
		Round(Holder, 12)
		Stroke(Holder, Theme().Stroke, 1)
		local Label = New("TextLabel", {
			Parent = Holder, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -150, 1, 0), Text = text, TextColor3 = Theme().Text,
			TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 91,
		})
		local Value = New("TextLabel", {
			Parent = Holder, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -32, 0.5, 0), Size = UDim2.fromOffset(110, 18),
			Text = Truncate(tostring(selected or ""), 16), TextColor3 = Theme().TextDim,
			TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 91,
		})
		local Caret = Chevron(Holder, 11, Theme().TextDim, "down", 91)
		Caret.Holder.AnchorPoint = Vector2.new(1, 0.5)
		Caret.Holder.Position = UDim2.new(1, -12, 0.5, 0)
		local ClickArea = New("TextButton", {
			Parent = Holder, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 92,
		})
		local Drop = New("Frame", {
			Parent = Holder, Position = UDim2.new(0, 0, 1, 6), Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = Theme().Surface, BorderSizePixel = 0, Visible = false,
			ClipsDescendants = true, ZIndex = 200,
		})
		Round(Drop, 10)
		Stroke(Drop, Theme().Stroke, 1)
		local List = New("ScrollingFrame", {
			Parent = Drop, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.fromOffset(0, 0), ZIndex = 201,
		})
		New("UIListLayout", { Parent = List, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
		New("UIPadding", { Parent = List, PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) })
		local OptionButtons = {}
		local function ToggleDrop(state)
			opened = state and true or false
			Caret:SetDirection(opened and "up" or "down", not State.ReducedMotion)
			if opened then
				local sizeY = math.min(#options * 36 + 12, 180)
				Drop.Visible = true
				Tween(Drop, { Size = UDim2.new(1, 0, 0, sizeY) }, Motion(0.16))
			else
				Tween(Drop, { Size = UDim2.new(1, 0, 0, 0) }, Motion(0.12))
				task.delay(0.14, function() if not opened and Drop.Parent then Drop.Visible = false end end)
			end
		end
		local function BuildOptions(list)
			for _, b in ipairs(OptionButtons) do b:Destroy() end
			OptionButtons = {}
			for _, option in ipairs(list) do
				local Btn = New("TextButton", {
					Parent = List, Size = UDim2.new(1, 0, 0, 30),
					BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency,
					BorderSizePixel = 0, Text = tostring(option), TextColor3 = Theme().Text,
					TextSize = 12, Font = Enum.Font.Gotham, AutoButtonColor = false, ZIndex = 202,
				})
				Round(Btn, 8)
				table.insert(OptionButtons, Btn)
				Btn.MouseButton1Click:Connect(function()
					selected = option
					Value.Text = Truncate(tostring(option), 16)
					if flag then State.Flags[flag] = option end
					ToggleDrop(false)
					SafeCall(callback, option)
					Persist()
				end)
			end
		end
		BuildOptions(options)
		ClickArea.MouseButton1Click:Connect(function() ToggleDrop(not opened) end)
		AddRefresher(function()
			Holder.BackgroundColor3 = Theme().Surface2
			Holder.BackgroundTransparency = Theme().Surface2Transparency
			Label.TextColor3 = Theme().Text
			Value.TextColor3 = Theme().TextDim
			Caret:SetColor(Theme().TextDim)
			Drop.BackgroundColor3 = Theme().Surface
			for _, b in ipairs(OptionButtons) do
				b.BackgroundColor3 = Theme().Surface2
				b.TextColor3 = Theme().Text
			end
			Stroke(Holder, Theme().Stroke, 1)
			Stroke(Drop, Theme().Stroke, 1)
		end)
		local api = { Instance = Holder, Frame = Holder }
		api.Get = Dual(function() return selected end)
		api.Set = Dual(function(v, silent)
			selected = v
			Value.Text = Truncate(tostring(v), 16)
			if flag then State.Flags[flag] = v end
			if not silent then SafeCall(callback, v) end
		end)
		api.Refresh = Dual(function(newOptions, keep)
			if type(newOptions) == "table" then
				options = newOptions
				BuildOptions(options)
				local found = false
				if keep then for _, o in ipairs(options) do if o == selected then found = true break end end end
				if not found then
					selected = options[1]
					Value.Text = Truncate(tostring(selected or ""), 16)
				end
			end
		end)
		api.SetOptions = api.Refresh
		if flag then RegisterFlag(flag, api.Set, function() return selected end) end
