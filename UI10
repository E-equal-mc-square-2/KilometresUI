		})
		Round(swatch, 6)
		local panel = New("Frame", {
			Parent = row, BackgroundTransparency = 1, Visible = false,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 91,
		})
