		New("TextButton", {
			Parent = KScreen, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.4, Text = "", AutoButtonColor = false, ZIndex = 1,
		})
		local card = New("Frame", {
			Parent = KScreen, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(360, 220), BackgroundColor3 = Theme().Background, BorderSizePixel = 0, ZIndex = 4,
		})
		Round(card, WINDOW_RADIUS)
		Stroke(card, Theme().Accent, 1.3)
		New("TextLabel", {
			Parent = card, BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 18),
			Size = UDim2.new(1, -40, 0, 22), Text = ks.Title or cfg.Title or "Key required",
			TextColor3 = Theme().Text, TextSize = 16, Font = Enum.Font.GothamBold, ZIndex = 5,
		})
		New("TextLabel", {
			Parent = card, BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 44),
			Size = UDim2.new(1, -40, 0, 32), Text = ks.Note or "Enter your key to continue.",
			TextColor3 = Theme().TextDim, TextSize = 12, Font = Enum.Font.Gotham, TextWrapped = true, ZIndex = 5,
		})
		local box = New("TextBox", {
			Parent = card, Position = UDim2.fromOffset(20, 88), Size = UDim2.new(1, -40, 0, 34),
			BackgroundColor3 = Theme().Surface, BorderSizePixel = 0, Text = "",
			PlaceholderText = "KEY", PlaceholderColor3 = Theme().TextDim, TextColor3 = Theme().Text,
			TextSize = 14, Font = Enum.Font.Code, ClearTextOnFocus = false, ZIndex = 5,
		})
		Round(box, 10)
		New("UIPadding", { Parent = box, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
		local status = New("TextLabel", {
			Parent = card, BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 128),
			Size = UDim2.new(1, -40, 0, 16), Text = "", TextColor3 = Theme().TextDim,
			TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
		})
		local unlock = New("TextButton", {
			Parent = card, Position = UDim2.fromOffset(20, 156), Size = UDim2.fromOffset(160, 34),
			BackgroundColor3 = Theme().Accent, BorderSizePixel = 0, Text = "Unlock",
			TextColor3 = Color3.new(1, 1, 1), TextSize = 13, Font = Enum.Font.GothamBold,
			AutoButtonColor = false, ZIndex = 5,
		})
		Round(unlock, 10)
		local function accept()
			KeyVerified = true
			KScreen:Destroy()
			Screen.Enabled = true
			Notify("Welcome", "Key accepted.", 2.4, "Success")
		end
		local function submit()
			local given = string.upper((Trim(box.Text):gsub("[^%w]", "")))
			if given == "" then status.Text = "Enter a key first." status.TextColor3 = Theme().Warning return end
			if Static[given] then accept() return end
			if type(ks.Validate) == "function" then
				local ok, res = pcall(ks.Validate, box.Text)
				if ok and res then accept() return end
			end
			if VerifyUrl then
				status.Text = "Checking…"
				task.spawn(function()
					local ok, res = pcall(function()
						local sep = string.find(VerifyUrl, "?", 1, true) and "&" or "?"
						return game:HttpGet(VerifyUrl .. sep .. "key=" .. given, true)
					end)
					if ok and type(res) == "string" and res:find('"valid"%s*:%s*true') then
						accept()
					else
						status.Text = "That key is not valid."
						status.TextColor3 = Theme().Error
					end
				end)
				return
			end
			status.Text = "That key is not valid."
			status.TextColor3 = Theme().Error
		end
		unlock.MouseButton1Click:Connect(submit)
		box.FocusLost:Connect(function(enter) if enter then submit() end end)
		if Link ~= "" then
			local copy = New("TextButton", {
				Parent = card, Position = UDim2.fromOffset(190, 156), Size = UDim2.fromOffset(150, 34),
				BackgroundColor3 = Theme().Surface2, BorderSizePixel = 0, Text = "Get key",
				TextColor3 = Theme().Text, TextSize = 12, Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 5,
			})
			Round(copy, 10)
			copy.MouseButton1Click:Connect(function()
				SetClipboardText(Link)
				status.Text = "Link copied."
				status.TextColor3 = Theme().Success
			end)
		end
	end

	-- wiring
	local function CloseSettings()
		SettingsOverlay.Visible = false
		PageHolder.Visible = true
		UpdateLayout()
	end
	SettingsClose.MouseButton1Click:Connect(CloseSettings)
	SettingsBackdrop.MouseButton1Click:Connect(CloseSettings)
	SettingsButton.MouseButton1Click:Connect(function()
		if State.Hidden then return end
		if State.Minimized then SetMinimized(false) end
		local on = not SettingsOverlay.Visible
		SettingsOverlay.Visible = on
		if on then
			TabBar.Visible = false
			PageHolder.Visible = false
			SearchBox.Visible = false
		else
			CloseSettings()
		end
	end)
	MinimizeButton.MouseButton1Click:Connect(function() SetMinimized(not State.Minimized) end)
	HideButton.MouseButton1Click:Connect(function()
		SetHidden(true)
		Notify("Hidden", "Tap the orb to restore.", 2, "Info")
	end)
	Orb.MouseButton1Click:Connect(function() SetHidden(false) end)

	AddConn(UIS.InputBegan:Connect(function(input, gp)
		if gp or State.Destroyed then return end
		if input.KeyCode == State.Hotkey then
			SetHidden(not State.Hidden)
		elseif input.KeyCode == State.PaletteHotkey and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
			if PalOverlay.Visible then PalOverlay.Visible = false else OpenPalette() end
		end
	end))

	Destroy = function()
		if State.Destroyed then return end
		State.Destroyed = true
		for _, c in ipairs(State.Connections) do pcall(function() c:Disconnect() end) end
		if WorldBlur and WorldBlur.Parent then pcall(function() WorldBlur:Destroy() end) end
		Persist()
		if Screen.Parent then Screen:Destroy() end
	end

	AddRefresher(function()
		local T = Theme()
		Main.BackgroundColor3 = T.Background
		Main.BackgroundTransparency = T.BackgroundTransparency
		Stroke(Main, T.Stroke, 1.3)
		TitleLabel.TextColor3 = T.Text
		SubtitleLabel.TextColor3 = T.TextDim
		Gradient(TitleLabel, Color3.new(1, 1, 1), T.Accent, 25)
		TopbarRule.BackgroundColor3 = T.Accent
		TabBar.BackgroundColor3 = T.Surface
		TabIndicator.BackgroundColor3 = T.Accent
		SettingsPanel.BackgroundColor3 = T.Surface
		SettingsTitle.TextColor3 = T.Text
		SearchBox.BackgroundColor3 = T.Surface2
		SearchBox.TextColor3 = T.Text
		SearchBox.PlaceholderColor3 = T.TextDim
		PalCard.BackgroundColor3 = T.Surface
		PalInput.BackgroundColor3 = T.Background
		PalInput.TextColor3 = T.Text
		Orb.BackgroundColor3 = T.Accent
		for _, rec in ipairs(TopbarButtons) do
			rec.Btn.BackgroundColor3 = T.Surface2
			if rec.Icon and rec.Icon.SetColor then rec.Icon:SetColor(T.Text) end
			Stroke(rec.Btn, T.Stroke, 1)
		end
		for _, pip in ipairs(GripMarks) do pip.BackgroundColor3 = T.TextDim end
	end)

	-- about
	if cfg.About ~= false then
		task.defer(function()
			if State.Destroyed then return end
			local Tab = WindowAPI:CreateTab("About", { Order = 9500 })
			local S = Tab:CreateSection("KILOMETRES UI X")
			S:Paragraph("Nova", "V10 is a UI kit: instance windows, flagged elements, named profiles, a command palette, and a cinematic boot. Universal Suite is not bundled.")
			S:Info("14 themes · Ctrl+K palette · tab filter · side or top layout · reduced motion.")
			local L = Tab:CreateSection("Links")
			L:Button("Copy library note", function()
				SetClipboardText("Kilometres UI X V10 Nova")
				Notify("About", "Copied.", 1.4, "Success")
			end)
		end)
	end

	-- public
	function WindowAPI:Notify(a, b, c, d) return Notify(a, b, c, d) end
	function WindowAPI:SetTheme(n) SetTheme(n) end
	function WindowAPI:GetTheme() return State.ThemeName end
	function WindowAPI:GetThemes()
		local out = {}
		for _, t in ipairs(ThemeList) do table.insert(out, t.Key) end
		return out
	end
	function WindowAPI:Hide() SetHidden(true) end
	function WindowAPI:Show() SetHidden(false) end
	function WindowAPI:Toggle() SetHidden(not State.Hidden) end
	function WindowAPI:Minimize() SetMinimized(true) end
	function WindowAPI:Restore() SetMinimized(false) SetHidden(false) end
	function WindowAPI:Destroy() Destroy() end
	function WindowAPI:SetSize(w, h)
		State.Width = Clamp(tonumber(w) or State.Width, 340, 1400)
		State.Height = Clamp(tonumber(h) or State.Height, 260, 900)
		WidthSlider.Set(State.Width, true)
		HeightSlider.Set(State.Height, true)
		UpdateLayout() Persist()
	end
	function WindowAPI:SetHotkey(key)
		if typeof(key) == "EnumItem" then State.Hotkey = key
		elseif type(key) == "string" and Enum.KeyCode[key] then State.Hotkey = Enum.KeyCode[key] end
		hotkeyKb.Set(State.Hotkey, true) Persist()
	end
	function WindowAPI:SetUIScale(v)
		v = tonumber(v) or 1
		if v > UI_SCALE_MAX then v = v / 100 end
		State.UIScale = Clamp(v, UI_SCALE_MIN, UI_SCALE_MAX)
		LookRefs.UIScale.Set(math.floor(State.UIScale * 100 + 0.5), true)
		Tween(MainScale, { Scale = State.UIScale }, Motion(0.16)) Persist()
	end
	function WindowAPI:SetBlur(f) ApplyBlur(f) LookRefs.Blur.Set(State.Blur, true) Persist() end
	function WindowAPI:SetRoundness(v)
		LookRefs.Roundness.Set(v) 
	end
	function WindowAPI:SaveSettings() Persist() Notify("Settings", "Saved.", 1.6, "Success") end
	function WindowAPI:GetFlag(flag) return State.Flags[flag] end
	function WindowAPI:SetFlag(flag, value) SetFlag(flag, value, false) end
	function WindowAPI:GetFlags() 
		local c = {}
		for k, v in pairs(State.Flags) do c[k] = v end
		return c
	end
	function WindowAPI:SaveProfile(name)
		name = Trim(name or State.ActiveProfile)
		profileInput.Set(name)
		local snap = {}
		for k, v in pairs(State.Flags) do snap[k] = v end
		State.Profiles[name] = { Flags = snap, ThemeName = State.ThemeName, UIScale = State.UIScale, Layout = State.Layout }
		State.ActiveProfile = name
		Persist()
		Notify("Profiles", "Saved “" .. name .. "”.", 2, "Success")
	end
	function WindowAPI:LoadProfile(name)
		profileInput.Set(name)
		local p = State.Profiles[name]
		if not p then return false end
		if p.ThemeName then SetTheme(p.ThemeName) end
		if p.Flags then for k, v in pairs(p.Flags) do SetFlag(k, v, false) end end
		return true
	end
	function WindowAPI:OpenPalette() OpenPalette() end
	function WindowAPI:OpenGemini() OpenCharlotte() end
	function WindowAPI:OpenCharlotte() OpenCharlotte() end
	function WindowAPI:ConfigureGemini(opts)
		if type(opts) ~= "table" then return end
		for k, v in pairs(opts) do State.Gemini[k] = v end
		Persist()
	end
	function WindowAPI:IsKeyVerified() return KeyVerified end
	function WindowAPI:LoadUniversalSuite()
		Notify("V10 Nova", "Universal Suite is not bundled in the UI kit.", 3.2, "Warning")
		return nil
	end
	function WindowAPI:GetState()
		return {
			Version = Library.Version, ThemeName = State.ThemeName,
			Width = State.Width, Height = State.Height,
			Hidden = State.Hidden, Minimized = State.Minimized,
			Layout = State.Layout, UIScale = State.UIScale,
			Profile = State.ActiveProfile, KeyVerified = KeyVerified,
		}
	end

	-- boot
	if State.Blur then ApplyBlur(true) end
	UpdateLayout()
	RefreshAll()
	ClampOffsets()
	PlayIntro()
	task.defer(function()
		if State.Destroyed then return end
		if Tabs[1] then Tabs[1].Activate() end
		RebuildPalette()
	end)

	table.insert(Library.Windows, WindowAPI)
	WindowAPI.Screen = Screen
	WindowAPI.Main = Main
	return WindowAPI
end

function Library:Notify(a, b, c, d)
	local w = self.Windows[#self.Windows]
	if w then return w:Notify(a, b, c, d) end
end

return Library
