function Library:CreateWindow(cfg)
	cfg = cfg or {}

	local SaveFile = cfg.SaveFile or "KilometresUIX/settings.json"
	local State = {
		ThemeName     = cfg.Theme or cfg.ThemeName or "LiquidGlass",
		Width         = Clamp(tonumber(cfg.Width) or 750, 340, 1400),
		Height        = Clamp(tonumber(cfg.Height) or 380, 260, 900),
		OffsetX       = 0,
		OffsetY       = 0,
		SaveSettings  = cfg.SaveSettings ~= false,
		Hotkey        = cfg.Hotkey or Enum.KeyCode.RightShift,
		PaletteHotkey = cfg.PaletteHotkey or Enum.KeyCode.K,
		Roundness     = Clamp(tonumber(cfg.Roundness) or 1, 0, 2),
		UIScale       = Clamp(tonumber(cfg.UIScale) or 0.85, UI_SCALE_MIN, UI_SCALE_MAX),
		Blur          = cfg.Blur and true or false,
		ReducedMotion = cfg.ReducedMotion and true or false,
		Layout        = (cfg.Layout == "Side") and "Side" or "Top",
		Hidden        = false,
		Minimized     = false,
		Destroyed     = false,
		Refreshers    = {},
		Connections   = {},
		Flags         = {},
		FlagMeta      = {},
		Profiles      = {},
		ActiveProfile = "Default",
		ActiveTab     = nil,
		TabCounter    = 0,
		Intro         = cfg.Intro ~= false,
		Gemini = {
			ApiKey = "",
			Model = "gemini-2.5-flash",
			Endpoint = DEFAULT_GEMINI,
			Temperature = 0.7,
			MaxTokens = 1024,
		},
	}
	if not Themes[State.ThemeName] then State.ThemeName = "Default" end

	local function Theme()
		return Themes[State.ThemeName] or Themes.Default
	end

	local function AddConn(conn)
		if conn then table.insert(State.Connections, conn) end
		return conn
	end

	local function AddRefresher(fn)
		table.insert(State.Refreshers, fn)
	end

	local function RefreshAll()
		for _, fn in ipairs(State.Refreshers) do pcall(fn) end
	end

	local function Motion(speed)
		if State.ReducedMotion then return 0.01 end
		return speed or 0.2
	end

	local function Round(obj, radius)
		return Corner(obj, radius, State.Roundness)
	end

	-- persist
	local function Persist()
		if not State.SaveSettings then return end
		local flags = {}
		for k, v in pairs(State.Flags) do
			if typeof(v) == "Color3" then
				flags[k] = { __c = Color3ToHex(v) }
			elseif typeof(v) == "EnumItem" then
				flags[k] = { __e = tostring(v) }
			else
				flags[k] = v
			end
		end
		local json = SafeJSONEncode({
			Version = "V10",
			ThemeName = State.ThemeName,
			Width = State.Width, Height = State.Height,
			OffsetX = math.floor(State.OffsetX + 0.5),
			OffsetY = math.floor(State.OffsetY + 0.5),
			Roundness = State.Roundness, UIScale = State.UIScale,
			Blur = State.Blur, ReducedMotion = State.ReducedMotion,
			Layout = State.Layout,
			Hotkey = tostring(State.Hotkey),
			Flags = flags,
			Profiles = State.Profiles,
			ActiveProfile = State.ActiveProfile,
			Gemini = State.Gemini,
		})
		if json then TryWriteFile(SaveFile, json) end
	end

	local function LoadPersisted()
		local raw = TryReadFile(SaveFile)
		local data = raw and SafeJSONDecode(raw)
		if not data then return end
		if type(data.ThemeName) == "string" and Themes[data.ThemeName] then State.ThemeName = data.ThemeName end
		State.Width  = Clamp(tonumber(data.Width) or State.Width, 340, 1400)
		State.Height = Clamp(tonumber(data.Height) or State.Height, 260, 900)
		State.OffsetX = tonumber(data.OffsetX) or 0
		State.OffsetY = tonumber(data.OffsetY) or 0
		State.Roundness = Clamp(tonumber(data.Roundness) or State.Roundness, 0, 2)
		State.UIScale = Clamp(tonumber(data.UIScale) or State.UIScale, UI_SCALE_MIN, UI_SCALE_MAX)
		if type(data.Blur) == "boolean" then State.Blur = data.Blur end
		if type(data.ReducedMotion) == "boolean" then State.ReducedMotion = data.ReducedMotion end
		if data.Layout == "Side" or data.Layout == "Top" then State.Layout = data.Layout end
		if type(data.Hotkey) == "string" then
			local name = data.Hotkey:gsub("Enum.KeyCode.", "")
			if Enum.KeyCode[name] then State.Hotkey = Enum.KeyCode[name] end
		end
		if type(data.Flags) == "table" then
			for k, v in pairs(data.Flags) do
				if type(v) == "table" and v.__c then
					State.Flags[k] = HexToColor3(v.__c) or v
				else
					State.Flags[k] = v
				end
			end
		end
		if type(data.Profiles) == "table" then State.Profiles = data.Profiles end
		if type(data.ActiveProfile) == "string" then State.ActiveProfile = data.ActiveProfile end
		if type(data.Gemini) == "table" then
			for k, v in pairs(data.Gemini) do State.Gemini[k] = v end
		end
	end

