		New("UIPadding", { Parent = panel, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10) })
		local suppress = false
		local function Apply(c, silent)
			color = c
			swatch.BackgroundColor3 = c
			hexLbl.Text = Color3ToHex(c)
			if flag then State.Flags[flag] = c end
			if not silent then SafeCall(callback, c) Persist() end
		end
		local function Ch(name, get)
			return CreateSlider(panel, name, 0, 255, get(), function(v)
				if suppress then return end
				local r = math.floor(color.R * 255 + 0.5)
				local g = math.floor(color.G * 255 + 0.5)
				local b = math.floor(color.B * 255 + 0.5)
				if name == "R" then r = v elseif name == "G" then g = v else b = v end
				Apply(Color3.fromRGB(r, g, b))
			end, 1)
		end
		local slR = Ch("R", function() return math.floor(color.R * 255 + 0.5) end)
		local slG = Ch("G", function() return math.floor(color.G * 255 + 0.5) end)
		local slB = Ch("B", function() return math.floor(color.B * 255 + 0.5) end)
		swatch.MouseButton1Click:Connect(function()
			expanded = not expanded
			panel.Visible = expanded
		end)
		AddRefresher(function()
			row.BackgroundColor3 = Theme().Surface2
			label.TextColor3 = Theme().Text
			hexLbl.TextColor3 = Theme().TextDim
			Stroke(row, Theme().Stroke, 1)
		end)
		local api = { Instance = row }
		api.Get = Dual(function() return color end)
		api.Set = Dual(function(c, silent)
			if typeof(c) == "Color3" then
				suppress = true
				slR.Set(math.floor(c.R * 255 + 0.5), true)
				slG.Set(math.floor(c.G * 255 + 0.5), true)
				slB.Set(math.floor(c.B * 255 + 0.5), true)
				suppress = false
				Apply(c, silent)
			end
		end)
		if flag then RegisterFlag(flag, api.Set, function() return color end) end
		return WrapInstance(api, row)
	end

