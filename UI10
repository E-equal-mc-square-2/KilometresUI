local function SafeParent()
	if type(gethui) == "function" then
		local ok, ui = pcall(gethui)
		if ok and ui then return ui end
	end
	return PlayerGui or CoreGui
end

local function New(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then obj[k] = v end
	end
	if props and props.Parent then obj.Parent = props.Parent end
	return obj
end

local function Tween(obj, props, speed, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(speed or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function Clamp(v, mn, mx)
	return math.max(mn, math.min(mx, v))
end

local function Lerp(a, b, t)
	return a + (b - a) * t
end

local function ColorLerp(a, b, t)
	return Color3.new(Lerp(a.R, b.R, t), Lerp(a.G, b.G, t), Lerp(a.B, b.B, t))
end

local function SafeCall(fn, ...)
	if type(fn) == "function" then
		local args = { ... }
		task.spawn(function()
			pcall(fn, unpack(args))
		end)
	end
end

local function Trim(s)
	return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function Truncate(s, max)
	s = tostring(s or "")
	if #s > max then return s:sub(1, max - 3) .. "..." end
	return s
end

local function Esc(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	return s
end

local function FormatNumber(v, step)
	if step and step % 1 ~= 0 then
		local out = string.format("%.2f", v)
		return (out:gsub("0+$", ""):gsub("%.$", ""))
	end
	return tostring(math.floor(v + 0.5))
end

local function Color3ToHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5))
end

local function HexToColor3(s)
	s = tostring(s or ""):gsub("#", ""):gsub("%s", "")
	if #s == 3 then
		s = s:sub(1,1)..s:sub(1,1)..s:sub(2,2)..s:sub(2,2)..s:sub(3,3)..s:sub(3,3)
	end
	if #s ~= 6 then return nil end
	local r, g, b = tonumber(s:sub(1,2), 16), tonumber(s:sub(3,4), 16), tonumber(s:sub(5,6), 16)
	if not (r and g and b) then return nil end
	return Color3.fromRGB(r, g, b)
end

local function SafeJSONEncode(tbl)
	local ok, res = pcall(function() return HttpService:JSONEncode(tbl) end)
	return ok and res or nil
end

local function SafeJSONDecode(str)
	if type(str) ~= "string" or str == "" then return nil end
	local ok, res = pcall(function() return HttpService:JSONDecode(str) end)
	if ok and type(res) == "table" then return res end
	return nil
end

local function TryReadFile(path)
	if type(isfile) == "function" and type(readfile) == "function" and isfile(path) then
		local ok, data = pcall(readfile, path)
		if ok and type(data) == "string" then return data end
	end
	return nil
end

local function TryWriteFile(path, data)
	if type(makefolder) == "function" then
		local folder = path:match("^(.*)/[^/]+$")
		if folder and folder ~= "" then
			pcall(function()
				if type(isfolder) ~= "function" or not isfolder(folder) then
					makefolder(folder)
				end
			end)
		end
	end
	if type(writefile) == "function" then
		pcall(writefile, path, data)
	end
end

local SetClip = (type(setclipboard) == "function" and setclipboard)
	or (type(toclipboard) == "function" and toclipboard)
	or nil

local function SetClipboardText(text)
	if SetClip then return pcall(SetClip, tostring(text)) end
	return false
end

local RawRequest =
	(type(request) == "function" and request)
	or (type(http_request) == "function" and http_request)
	or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
	or (type(http) == "table" and type(http.request) == "function" and http.request)
	or nil

local function HttpPost(url, jsonBody)
	if RawRequest then
		return RawRequest({
			Url = url, Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" },
			Body = jsonBody,
		})
	end
	return HttpService:RequestAsync({
		Url = url, Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = jsonBody,
	})
end

local function Dual(fn)
	return function(a, b, c)
		if type(a) == "table" and rawget(a, "__KMUI") == true then
			return fn(b, c)
		end
		return fn(a, b)
	end
end

local function WrapInstance(api, inst)
	api.__KMUI = true
	return setmetatable(api, {
		__index = inst,
		__newindex = function(_, k, v) inst[k] = v end,
	})
end

local function Stroke(obj, color, thickness)
	local s = obj:FindFirstChildOfClass("UIStroke")
	if not s then
		s = Instance.new("UIStroke")
		s.Thickness = thickness or 1
		s.Parent = obj
	end
	s.Color = color
	if thickness then s.Thickness = thickness end
	return s
end

local function Gradient(obj, c1, c2, rotation)
	local g = obj:FindFirstChildOfClass("UIGradient")
	if not g then
		g = Instance.new("UIGradient")
		g.Parent = obj
	end
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(1, c2),
	})
	g.Rotation = rotation or 0
	return g
end

local function Corner(obj, radius, roundness)
	radius = radius or 14
	roundness = roundness or 1
	local r = radius >= 900 and radius or math.max(0, math.floor(radius * roundness + 0.5))
	local c = obj:FindFirstChildOfClass("UICorner")
	if not c then
		c = New("UICorner", { Parent = obj })
		c:SetAttribute("KM_BaseRadius", radius)
	end
	c.CornerRadius = UDim.new(0, r)
	return c
end

local SHADOW_ASSET = "rbxassetid://6015045625"

local function Shadow(host, target, spread, transparency)
	local sh = Instance.new("ImageLabel")
	sh.Name = "KM_Shadow"
	sh.BackgroundTransparency = 1
	sh.Image = SHADOW_ASSET
	sh.ImageColor3 = Color3.new(0, 0, 0)
	sh.ImageTransparency = transparency or 0.5
	sh.ScaleType = Enum.ScaleType.Slice
	sh.SliceCenter = Rect.new(49, 49, 450, 450)
	sh.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
	sh.AnchorPoint = target.AnchorPoint
	sh.Parent = host
	spread = spread or 22
	local function sync()
		sh.Size = UDim2.new(
			target.Size.X.Scale, target.Size.X.Offset + spread * 2,
			target.Size.Y.Scale, target.Size.Y.Offset + spread * 2
		)
		sh.Position = UDim2.new(
			target.Position.X.Scale, target.Position.X.Offset,
			target.Position.Y.Scale, target.Position.Y.Offset + 4
		)
		sh.Visible = target.Visible
	end
	sync()
	target:GetPropertyChangedSignal("Size"):Connect(sync)
	target:GetPropertyChangedSignal("Position"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	return sh
end

-- vector chevron (no tofu glyphs)
local CHEVRON = {
	down  = {{0.273, 0.500,  45}, {0.727, 0.500, -45}},
	up    = {{0.273, 0.500, -45}, {0.727, 0.500,  45}},
	right = {{0.500, 0.273,  45}, {0.500, 0.727, -45}},
	left  = {{0.500, 0.273, -45}, {0.500, 0.727,  45}},
}

local function Chevron(parent, size, color, direction, zindex)
	size = size or 14
	zindex = zindex or ((parent and parent.ZIndex or 1) + 1)
	local holder = New("Frame", {
		Name = "KM_Chevron", Parent = parent, BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = zindex,
	})
	local thickness = math.max(1.6, size * 0.155)
	local armLen = size * 0.62
	local arms = {}
	for i = 1, 2 do
		local a = New("Frame", {
			Name = "Arm" .. i, Parent = holder, AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0, BackgroundColor3 = color or Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(armLen, thickness), ZIndex = zindex,
		})
		New("UICorner", { Parent = a, CornerRadius = UDim.new(1, 0) })
		arms[i] = a
	end
	local api = { Holder = holder, Arms = arms }
	function api:SetDirection(dir, animated)
		local spec = CHEVRON[tostring(dir):lower()] or CHEVRON.down
		for i = 1, 2 do
			local px, py, rot = spec[i][1], spec[i][2], spec[i][3]
			if animated then
				Tween(arms[i], { Position = UDim2.fromScale(px, py), Rotation = rot }, 0.18)
			else
				arms[i].Position = UDim2.fromScale(px, py)
				arms[i].Rotation = rot
			end
		end
	end
	function api:SetColor(c)
		arms[1].BackgroundColor3 = c
		arms[2].BackgroundColor3 = c
	end
	api:SetDirection(direction or "down", false)
	return api
end

local function GripPips(parent, color, zindex)
	zindex = zindex or ((parent and parent.ZIndex or 1) + 1)
	local pips = {}
	for i, def in ipairs({ {11, 3}, {7, 7}, {3, 11} }) do
		local len, off = def[1], def[2]
		local bar = New("Frame", {
			Name = "Pip" .. i, Parent = parent, AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0, BackgroundColor3 = color or Color3.new(1, 1, 1),
			BackgroundTransparency = 0.35, Rotation = -45,
			Size = UDim2.fromOffset(len, 2),
			Position = UDim2.new(1, -off - len * 0.35, 1, -off - len * 0.35),
			ZIndex = zindex,
		})
		New("UICorner", { Parent = bar, CornerRadius = UDim.new(1, 0) })
		pips[i] = bar
	end
	return pips
end

-- tiny geometric icons so we never depend on a font atlas
local function GeoIcon(parent, kind, size, color, z)
	size = size or 14
	z = z or 2
	local h = New("Frame", {
		Parent = parent, BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = z,
	})
	local function pip(props)
		props.Parent = h
		props.BorderSizePixel = 0
		props.BackgroundColor3 = color or Color3.new(1, 1, 1)
		props.ZIndex = z + 1
		local f = New("Frame", props)
		New("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
		return f
	end
	if kind == "close" then
		pip({ Size = UDim2.fromOffset(size * 0.72, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45 })
		pip({ Size = UDim2.fromOffset(size * 0.72, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = -45 })
	elseif kind == "min" then
		pip({ Size = UDim2.fromOffset(size * 0.62, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5) })
	elseif kind == "search" then
		local ring = New("Frame", {
			Parent = h, BackgroundTransparency = 1, Size = UDim2.fromScale(0.58, 0.58),
			Position = UDim2.fromScale(0.38, 0.38), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 1,
		})
		New("UICorner", { Parent = ring, CornerRadius = UDim.new(1, 0) })
		local st = New("UIStroke", { Parent = ring, Thickness = 1.6, Color = color or Color3.new(1, 1, 1) })
		pip({ Size = UDim2.fromOffset(size * 0.34, 2), Position = UDim2.fromScale(0.78, 0.78), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45 })
		h:SetAttribute("KM_Stroke", true)
	elseif kind == "gear" then
		pip({ Size = UDim2.fromOffset(size * 0.42, size * 0.42), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5) })
		New("UIStroke", { Parent = h:FindFirstChildOfClass("Frame"), Thickness = 2, Color = color or Color3.new(1, 1, 1) })
	else -- spark / default
		pip({ Size = UDim2.fromOffset(size * 0.22, size * 0.22), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5) })
	end
	function h:SetColor(c)
		for _, d in ipairs(h:GetDescendants()) do
			if d:IsA("Frame") then d.BackgroundColor3 = c
			elseif d:IsA("UIStroke") then d.Color = c end
		end
	end
	return h
end

