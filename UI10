	-- filter
	local function ApplyTabFilter(query)
		query = Trim(query):lower()
		local page = State.ActiveTab and State.ActiveTab.Page
		if not page then return end
		local function walk(inst)
			for _, ch in ipairs(inst:GetChildren()) do
				if ch:IsA("Frame") and ch:FindFirstChildWhichIsA("TextLabel", true) then
					if query == "" then
						ch.Visible = true
					else
						local hay = ""
						for _, t in ipairs(ch:GetDescendants()) do
							if t:IsA("TextLabel") or t:IsA("TextButton") then
								hay = hay .. " " .. string.lower(t.Text or "")
							end
						end
						ch.Visible = hay:find(query, 1, true) ~= nil
					end
				end
				walk(ch)
			end
		end
		-- only collapse section children, not the page itself
		for _, sec in ipairs(page:GetChildren()) do
			if sec:IsA("Frame") then
				if query == "" then
					sec.Visible = true
				else
					local hay = ""
					for _, t in ipairs(sec:GetDescendants()) do
						if t:IsA("TextLabel") or t:IsA("TextButton") then
							hay = hay .. " " .. string.lower(t.Text or "")
						end
					end
					sec.Visible = hay:find(query, 1, true) ~= nil
				end
			end
		end
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		ApplyTabFilter(SearchBox.Text)
	end)

