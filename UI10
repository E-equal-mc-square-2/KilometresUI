	local function CreateButton(parent, text, callback, opts)
		opts = opts or {}
		local enabled = true
		local btn = New("TextButton", {
			Parent = parent, Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 90,
		})
		Round(btn, 12)
		Stroke(btn, Theme().Stroke, 1).Transparency = 0.35
		local lbl = New("TextLabel", {
			Parent = btn, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -24, 1, 0), Text = text, TextColor3 = Theme().Text,
			TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 91,
		})
		local bscale = New("UIScale", { Parent = btn, Scale = 1 })
		btn.MouseEnter:Connect(function()
			if enabled then Tween(btn, { BackgroundColor3 = ColorLerp(Theme().Surface2, Theme().Accent, 0.2) }, Motion(0.12)) end
		end)
		btn.MouseLeave:Connect(function()
			Tween(btn, { BackgroundColor3 = Theme().Surface2 }, Motion(0.14))
			Tween(bscale, { Scale = 1 }, Motion(0.12))
		end)
		btn.MouseButton1Down:Connect(function() if enabled then Tween(bscale, { Scale = 0.97 }, Motion(0.07)) end end)
		btn.MouseButton1Up:Connect(function() Tween(bscale, { Scale = 1 }, Motion(0.1)) end)
		btn.MouseButton1Click:Connect(function()
			if not enabled then return end
			Tween(btn, { BackgroundColor3 = Theme().Accent }, Motion(0.07))
			task.delay(0.08, function()
				if btn.Parent then Tween(btn, { BackgroundColor3 = Theme().Surface2 }, Motion(0.14)) end
			end)
			SafeCall(callback)
		end)
		AddRefresher(function()
			btn.BackgroundColor3 = Theme().Surface2
			btn.BackgroundTransparency = Theme().Surface2Transparency
			lbl.TextColor3 = Theme().Text
			Stroke(btn, Theme().Stroke, 1)
		end)
		local api = { Instance = btn }
		api.SetEnabled = Dual(function(v) enabled = v and true or false btn.Active = enabled end)
		api.SetText = Dual(function(t) lbl.Text = tostring(t) end)
		api.GetText = Dual(function() return lbl.Text end)
		return WrapInstance(api, btn)
	end

	local function CreateToggle(parent, text, default, callback, flag)
		local value = default and true or false
		if flag and State.Flags[flag] ~= nil then value = State.Flags[flag] and true or false end
		local toggle = New("TextButton", {
			Parent = parent, Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 90,
		})
		Round(toggle, 12)
		Stroke(toggle, Theme().Stroke, 1)
		local label = New("TextLabel", {
			Parent = toggle, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -80, 1, 0), Text = text, TextColor3 = Theme().Text,
			TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 91,
		})
		local switch = New("Frame", {
			Parent = toggle, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(44, 22),
			BackgroundColor3 = value and Theme().Accent or Color3.fromRGB(60, 60, 70),
			BorderSizePixel = 0, ZIndex = 92,
		})
		Round(switch, 999)
		local knob = New("Frame", {
			Parent = switch, Size = UDim2.fromOffset(16, 16),
			Position = value and UDim2.fromOffset(24, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 93,
		})
		Round(knob, 999)
