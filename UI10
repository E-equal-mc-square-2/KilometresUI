	t.BackgroundTransparency = t.BackgroundTransparency or 0
	t.SurfaceTransparency    = t.SurfaceTransparency or 0
	t.Surface2Transparency   = t.Surface2Transparency or 0
	t.Success = t.Success or Color3.fromRGB(80, 220, 130)
	t.Warning = t.Warning or Color3.fromRGB(250, 190, 80)
	t.Error   = t.Error   or Color3.fromRGB(255, 95, 95)
	return t
end

