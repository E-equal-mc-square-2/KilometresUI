			Tween(knob, { Position = value and UDim2.fromOffset(24, 3) or UDim2.fromOffset(3, 3) }, Motion(0.14))
		end
		local function Set(v, silent)
			value = v and true or false
			Render()
			if flag then State.Flags[flag] = value end
			if not silent then SafeCall(callback, value) Persist() end
		end
		toggle.MouseButton1Click:Connect(function() Set(not value) end)
		AddRefresher(function()
			toggle.BackgroundColor3 = Theme().Surface2
			toggle.BackgroundTransparency = Theme().Surface2Transparency
