	local function EffectiveSize()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local ew = Clamp(State.Width, 300, math.max(320, math.floor(vp.X) - 16))
		local eh = Clamp(State.Height, 220, math.max(240, math.floor(vp.Y) - 16))
		return ew, eh
	end

	ClampOffsets = function()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local ew, eh = EffectiveSize()
		local shownH = State.Minimized and 54 or eh
		local maxX = math.max(0, math.floor((vp.X - ew) / 2 - 8))
		local maxY = math.max(0, math.floor((vp.Y - shownH) / 2 - 8))
		State.OffsetX = Clamp(State.OffsetX, -maxX, maxX)
		State.OffsetY = Clamp(State.OffsetY, -maxY, maxY)
		Main.Position = UDim2.new(0.5, State.OffsetX, 0.5, State.OffsetY)
	end

	UpdateLayout = function()
		if State.Minimized then ClampOffsets() return end
		local ew, eh = EffectiveSize()
		Main.Size = UDim2.fromOffset(ew, eh)
		ClampOffsets()
		local side = State.Layout == "Side"
		local barH, barW = 42, 132
		if side then
			TabBar.Position = UDim2.new(0, 12, 0, 60)
			TabBar.Size = UDim2.new(0, barW, 1, -78)
