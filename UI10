			SearchBox.Size = UDim2.new(1, -24, 0, 26)
			PageHolder.Position = UDim2.new(0, 12, 0, 60 + barH + 36)
			PageHolder.Size = UDim2.new(1, -24, 1, -(60 + barH + 48))
		end
		TabBar.Visible = not SettingsOverlay.Visible
		SearchBox.Visible = SearchBox.Visible and not SettingsOverlay.Visible and not State.Minimized
		if SyncTabIndicator then task.defer(function() pcall(SyncTabIndicator, false) end) end
	end

	SyncTabIndicator = function(animated)
		local active
		for _, t in ipairs(Tabs) do if t.Active then active = t break end end
		if not active or not TabBar.Visible then TabIndicator.Visible = false return end
		local uiScale = (MainScale.Scale and MainScale.Scale > 0) and MainScale.Scale or 1
		local width = active.Button.AbsoluteSize.X / uiScale
		if width <= 0 then
			task.delay(0.08, function() if not State.Destroyed then pcall(SyncTabIndicator, false) end end)
			return
		end
		local x = ((active.Button.AbsolutePosition.X - TabBar.AbsolutePosition.X) / uiScale) + TabBar.CanvasPosition.X
		TabIndicator.Visible = true
		local goal = { Position = UDim2.new(0, x, 1, -4), Size = UDim2.fromOffset(width, 3) }
		if animated == false or State.ReducedMotion then
			TabIndicator.Position = goal.Position
			TabIndicator.Size = goal.Size
		else
			Tween(TabIndicator, goal, 0.22)
		end
	end

	SetHidden = function(hidden)
		State.Hidden = hidden and true or false
		if State.Hidden then
			Tween(MainScale, { Scale = 0.94 * State.UIScale }, Motion(0.14))
			task.delay(0.14, function() if State.Hidden then Main.Visible = false end end)
			SettingsOverlay.Visible = false
			PalOverlay.Visible = false
			Orb.Visible = true
			ClampOrb()
			if State.Blur then ApplyBlur(true) end
		else
			Main.Visible = true
			Orb.Visible = false
			if State.Minimized then State.Minimized = false UpdateLayout() end
			Tween(MainScale, { Scale = State.UIScale }, Motion(0.22), Enum.EasingStyle.Back)
			ClampOffsets()
		end
	end

	SetMinimized = function(flag)
		if State.Hidden then return end
		State.Minimized = flag and true or false
		local ew = EffectiveSize()
		if State.Minimized then
			TabBar.Visible = false
			PageHolder.Visible = false
			SearchBox.Visible = false
			SettingsOverlay.Visible = false
			ResizeGrip.Visible = false
			Tween(Main, { Size = UDim2.fromOffset(ew, 54) }, Motion(0.2))
			task.delay(0.22, ClampOffsets)
		else
			ResizeGrip.Visible = true
			Tween(Main, { Size = UDim2.fromOffset(EffectiveSize()) }, Motion(0.2))
			task.delay(0.05, function() if UpdateLayout then UpdateLayout() end end)
		end
	end

	SetTheme = function(name)
		if not Themes[name] then name = "Default" end
		State.ThemeName = name
		RefreshAll()
		local T = Theme()
		Tween(Main, { BackgroundColor3 = T.Background, BackgroundTransparency = T.BackgroundTransparency }, Motion(0.25))
		Tween(TabBar, { BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency }, Motion(0.25))
		Tween(TabIndicator, { BackgroundColor3 = T.Accent }, Motion(0.25))
		Tween(SettingsPanel, { BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency }, Motion(0.25))
		Tween(Orb, { BackgroundColor3 = T.Accent }, Motion(0.25))
		Gradient(TitleLabel, Color3.new(1, 1, 1), T.Accent, 25)
		Persist()
	end

	-- drag / resize / orb drag
	do
		local dragging, dragInput, dragStart, sx, sy = false, nil, nil, 0, 0
		Topbar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				sx, sy = State.OffsetX, State.OffsetY
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false Persist() end
				end)
			end
		end)
		Topbar.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and input == dragInput and dragStart then
				local d = input.Position - dragStart
				State.OffsetX, State.OffsetY = sx + d.X, sy + d.Y
				ClampOffsets()
			end
		end))
	end
	do
		local resizing, resizeInput, resizeStart, sw, sh = false, nil, nil, 0, 0
		ResizeGrip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				sw, sh = State.Width, State.Height
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then resizing = false Persist() end
				end)
			end
		end)
		ResizeGrip.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				resizeInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if resizing and input == resizeInput and resizeStart then
				local d = input.Position - resizeStart
				State.Width  = Clamp(math.floor(sw + d.X), 340, 1400)
				State.Height = Clamp(math.floor(sh + d.Y), 260, 900)
				if WidthSlider then WidthSlider.Set(State.Width, true) end
				if HeightSlider then HeightSlider.Set(State.Height, true) end
				UpdateLayout()
			end
		end))
	end
	do
		local dragging, dragInput, dragStart, sx, sy = false, nil, nil, 0, 0
		Orb.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				sx, sy = OrbCenter.X, OrbCenter.Y
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		Orb.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and input == dragInput and dragStart and Orb.Visible then
				local d = input.Position - dragStart
				OrbCenter.X, OrbCenter.Y = sx + d.X, sy + d.Y
				ClampOrb()
			end
		end))
	end

	AddConn(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		Camera = workspace.CurrentCamera or Camera
	end))
	if Camera then
		AddConn(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if not State.Destroyed then pcall(UpdateLayout) pcall(ClampOrb) end
		end))
	end

	-- flags
	local function SetFlag(flag, value, silent)
		if type(flag) ~= "string" or flag == "" then return end
		State.Flags[flag] = value
		local meta = State.FlagMeta[flag]
		if meta and meta.Apply and not silent then
			pcall(meta.Apply, value, true)
		end
		if not silent then Persist() end
	end

	local function RegisterFlag(flag, apply, get)
		if type(flag) ~= "string" or flag == "" then return end
		State.FlagMeta[flag] = { Apply = apply, Get = get }
		if State.Flags[flag] ~= nil and apply then
			pcall(apply, State.Flags[flag], true)
		end
	end

