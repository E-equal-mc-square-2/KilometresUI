	local function ParseElementArgs(a, b, c, d, e)
		-- supports both (text, default, cb) and (text, {Flag=, Default=, Callback=})
		if type(b) == "table" and (b.Flag or b.Default ~= nil or b.Callback or b.Min) then
			return b
		end
		return nil
	end

	local function AttachSectionAPI(Section, Content)
		function Section:Button(text, callback, options)
			return CreateButton(Content, text, callback, options)
		end
		function Section:Toggle(text, default, callback)
			local opt = ParseElementArgs(text, default)
			if opt then
				return CreateToggle(Content, text, opt.Default, opt.Callback, opt.Flag)
			end
			return CreateToggle(Content, text, default, callback)
		end
		function Section:Slider(text, min, max, default, callback, increment)
			local opt = ParseElementArgs(text, min)
			if opt then
				return CreateSlider(Content, text, opt.Min, opt.Max, opt.Default, opt.Callback, opt.Increment or opt.Step, opt.Flag)
			end
			return CreateSlider(Content, text, min, max, default, callback, increment)
		end
		function Section:Input(text, a2, a3, a4)
			return CreateInput(Content, text, a2, a3, a4)
		end
		function Section:Textbox(text, placeholder, callback)
			return CreateInput(Content, text, placeholder, callback)
		end
		function Section:Dropdown(text, options, default, callback)
			local opt = ParseElementArgs(text, options)
			if opt then
				return CreateDropdown(Content, text, opt.Options or opt.List, opt.Default, opt.Callback, opt.Flag)
			end
			return CreateDropdown(Content, text, options, default, callback)
		end
		function Section:Keybind(text, defaultKey, callback)
			local opt = ParseElementArgs(text, defaultKey)
			if opt then
				return CreateKeybind(Content, text, opt.Default, opt.Callback, opt.Flag)
			end
			return CreateKeybind(Content, text, defaultKey, callback)
		end
		function Section:ColorPicker(text, defaultColor, callback)
			local opt = ParseElementArgs(text, defaultColor)
			if opt then
				return CreateColorPicker(Content, text, opt.Default, opt.Callback, opt.Flag)
			end
			return CreateColorPicker(Content, text, defaultColor, callback)
		end
		function Section:Label(text) return CreateLabel(Content, text) end
		function Section:Paragraph(a, b) return CreateParagraph(Content, a, b) end
		function Section:Divider() return CreateDivider(Content) end
		function Section:Info(text) return CreateInfo(Content, text) end
	end

