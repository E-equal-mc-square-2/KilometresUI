			sending = true
			task.spawn(function()
				local url = tostring(State.Gemini.Endpoint)
				url = url:gsub("{MODEL}", State.Gemini.Model):gsub("{KEY}", State.Gemini.ApiKey)
				local body = SafeJSONEncode({
					contents = ChatHistory,
					generationConfig = { temperature = State.Gemini.Temperature, maxOutputTokens = State.Gemini.MaxTokens },
				})
				local ok, res = pcall(function() return HttpPost(url, body) end)
				sending = false
				local textOut = "No reply."
				if ok and type(res) == "table" and type(res.Body) == "string" then
					local data = SafeJSONDecode(res.Body)
					local parts = data and data.candidates and data.candidates[1] and data.candidates[1].content and data.candidates[1].content.parts
					if type(parts) == "table" then
						local buf = {}
						for _, p in ipairs(parts) do if type(p.text) == "string" then table.insert(buf, p.text) end end
						textOut = table.concat(buf, "")
					elseif data and data.error then
						textOut = tostring(data.error.message or "API error")
					end
				end
				table.insert(ChatHistory, { role = "model", parts = { { text = textOut } } })
				bubble("ai", textOut)
			end)
		end
