	local function CreateParagraph(parent, titleText, bodyText)
		local wrap = New("Frame", {
			Parent = parent,
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			ZIndex = 90,
		})
