	--// live corner-roundness control: rescales every UICorner already made
	ApplyRoundness = function(mult)
		State.Roundness = Clamp(tonumber(mult) or 1, 0, 2)
		RoundnessMult = State.Roundness
		for _, d in ipairs(Screen:GetDescendants()) do
			if d:IsA("UICorner") then
				local base = d:GetAttribute("KM_BaseRadius")
				if base and base < 900 then
					d.CornerRadius = UDim.new(0, math.max(0, math.floor(base * RoundnessMult + 0.5)))
				end
			end
		end
	end

	--// V9 GLOBAL UI SCALE  ·  100% (1.0) down to 20% (0.2)
	--// A single UIScale on Main scales *everything* inside the window at once
	--// (tab bar, titles, header, buttons, elements and every font), which is
	--// far cheaper than resizing thousands of instances by hand.
	ApplyUIScale = function(scale)
		State.UIScale = Clamp(tonumber(scale) or Defaults.UIScale, UI_SCALE_MIN, UI_SCALE_MAX)
		if not State.Hidden then
			Tween(MainScale, {Scale = State.UIScale}, 0.16)
		else
			MainScale.Scale = State.UIScale
		end
		-- the AI window is a sibling ScreenGui child, so it needs its own push
		if GeminiWindowScaleHook then
			pcall(GeminiWindowScaleHook, State.UIScale)
		end
		-- V9.1: and so does the music player
		if Music and Music.Scale then
			pcall(Music.Scale, State.UIScale)
		end
		-- offsets are computed from the *visual* size, which just changed
		if ClampOffsets then
			task.defer(function()
				if not State.Destroyed then
					pcall(ClampOffsets)
				end
			end)
		end
	end

	--// real glassmorphism: blur the 3D world behind the window
	local WorldBlur = nil
	ApplyBlur = function(on)
		State.Blur = on and true or false
		if State.Blur then
			if not WorldBlur or not WorldBlur.Parent then
				WorldBlur = Instance.new("BlurEffect")
				WorldBlur.Name = "KM_UIBlur"
				WorldBlur.Size = 0
				WorldBlur.Parent = game:GetService("Lighting")
			end
			WorldBlur.Enabled = true
			Tween(WorldBlur, {Size = (not State.Hidden and not State.Minimized) and 16 or 0}, 0.3)
		elseif WorldBlur then
			Tween(WorldBlur, {Size = 0}, 0.25)
			task.delay(0.3, function()
				if WorldBlur and WorldBlur.Parent then
					WorldBlur.Enabled = false
				end
			end)
		end
	end

