	-- the disc itself is the drag handle for the orb; a tiny movement
	-- counts as a click and restores the window instead
	DragHandle(OrbDiscBox,
		function() return MState.OrbX, MState.OrbY end,
		function(x, y)
			local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
			local maxX = math.max(0, math.floor(vp.X / 2 - 110))
			local maxY = math.max(0, math.floor(vp.Y / 2 - 40))
			MState.OrbX = Clamp(x, -maxX, maxX)
			MState.OrbY = Clamp(y, -maxY, maxY)
			OrbHost.Position = UDim2.new(0.5, MState.OrbX, 0.5, MState.OrbY)
		end,
		function(moved)
			if moved < 5 then
				SetMinimized(false)
			end
		end)

	------------------------------------------------------------------
	-- SPIN + PROGRESS LOOP
	------------------------------------------------------------------

	do
		local angle = 0
		local acc = 0
		AddConn(RunService.RenderStepped:Connect(function(dt)
			if State.Destroyed then
				return
			end
			local visible = (MState.Open and MWindow.Visible) or OrbHost.Visible
			if not visible then
				return
			end

			-- spin: only while audio is actually playing, and at the
			-- current playback speed so it reads as a real turntable
			if MusicState.Playing then
				angle = (angle + dt * 72 * MusicState.Speed) % 360
				if MWindow.Visible then
					Disc.Rotation = angle
				end
				if OrbHost.Visible then
					OrbDisc.Rotation = angle
				end
			end

			-- progress bar + clock, refreshed 8x a second
			acc = acc + dt
			if acc < 0.125 then
				return
			end
			acc = 0

			if MWindow.Visible then
				local len = Sound.TimeLength or 0
				local pos = Sound.TimePosition or 0
				if not MusicState.Seeking then
					ProgressFill.Size = UDim2.fromScale(len > 0 and Clamp(pos / len, 0, 1) or 0, 1)
				end
				TimeLabel.Text = FormatTime(pos) .. " / " .. FormatTime(len)
			end
		end))
	end

