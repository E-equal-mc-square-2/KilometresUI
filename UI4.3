			b.BackgroundTransparency = math.max(0.08, T.Surface2Transparency)
			b.TextColor3 = T.Text
			SetIconColor(TopbarIcons[b], T.Text)
			local vec = TopbarVectors[b]
			if vec then
				vec:SetColor(T.Text)
			end
			Stroke(b, T.Stroke, 1)
		end
		SettingsClose.BackgroundColor3 = T.Surface2
		SettingsClose.BackgroundTransparency = T.Surface2Transparency
		SettingsClose.TextColor3 = T.Text
		Stroke(SettingsClose, T.Stroke, 1)
		TopbarRule.BackgroundColor3 = T.Accent
		TitleLabel.TextColor3 = T.Text
		SubtitleLabel.TextColor3 = T.TextDim
		Gradient(TitleLabel, Color3.new(1, 1, 1), T.Accent, 25)
		TabBar.BackgroundColor3 = T.Surface
		TabBar.BackgroundTransparency = T.SurfaceTransparency
		TabIndicator.BackgroundColor3 = T.Accent
		Gradient(TabIndicator, T.Accent, ColorLerp(T.Accent, Color3.new(1, 1, 1), 0.55), 0)
		local ind = TabBar:FindFirstChild("KM_Glow")
		if ind then
			ind.ImageColor3 = T.Accent
		end
		Stroke(TabBar, T.Stroke, 1)
		if UIBGWash then
			UIBGWash.BackgroundColor3 = T.Accent
		end
		SettingsPanel.BackgroundColor3 = T.Surface
		SettingsPanel.BackgroundTransparency = T.SurfaceTransparency
		Stroke(SettingsPanel, T.Stroke, 1)
		SettingsTitle.TextColor3 = T.Text
		Orb.BackgroundColor3 = T.Accent
		Gradient(Orb, ColorLerp(T.Accent, Color3.new(1, 1, 1), 0.25), ColorLerp(T.Accent, Color3.new(0, 0, 0), 0.25), 90)
		ResizeGrip.TextColor3 = T.TextDim
		if GripMarks then
			for _, pip in ipairs(GripMarks) do
				pip.BackgroundColor3 = T.TextDim
			end
		end
	end)

	------------------------------------------------------------------
	-- STARTUP
	------------------------------------------------------------------

	if State.UIBG.Shuffle and Trim(State.UIBG.CustomId) == "" then
		State.UIBG.Index = math.random(1, #WALLPAPERS)
		if UIBGRefs.Refresh then
			UIBGRefs.Refresh()
		end
	end
	ApplyWallpaper(true)
	ApplyRoundness(State.Roundness)
	if State.Blur then
		ApplyBlur(true)
	end

	UpdateLayout()
	RefreshAll()
	ClampOffsets()

	-- open animation
	Tween(MainScale, {Scale = State.UIScale}, 0.28)

	-- auto-activate first non-internal tab once user tabs exist
	task.defer(function()
		if State.Destroyed then
			return
		end
		for _, t in ipairs(Tabs) do
			if not t.Internal then
				t.Activate()
				return
			end
		end
		-- nothing but internal tabs: fall back to the first one
		if Tabs[1] then
			Tabs[1].Activate()
		end
	end)

	------------------------------------------------------------------
	-- PUBLIC API
	------------------------------------------------------------------

	local API = {}

	function API:Notify(title, text, duration, ntype, onClick)
		return Notify(title, text, duration, ntype, onClick)
	end

	function API:SetTheme(name)
		SetTheme(name)
	end
	function API:GetTheme()
		return State.ThemeName
	end
	function API:GetThemes()
		local out = {}
		for _, t in ipairs(ThemeList) do
			table.insert(out, t.Key)
		end
		return out
	end

	function API:Hide()
		SetHidden(true)
	end
	function API:Show()
		SetHidden(false)
	end
	function API:Toggle()
		SetHidden(not State.Hidden)
	end
	function API:Minimize()
		SetMinimized(true)
	end
	function API:Restore()
		SetMinimized(false)
		SetHidden(false)
	end
	function API:Destroy()
		Destroy()
	end

	function API:SetSize(width, height)
		State.Width = Clamp(tonumber(width) or State.Width, 340, 1400)
		State.Height = Clamp(tonumber(height) or State.Height, 260, 900)
		WidthSlider.Set(State.Width, true)
		HeightSlider.Set(State.Height, true)
		UpdateLayout()
		Persist()
	end

	function API:SetHotkey(key)
		if typeof(key) == "EnumItem" then
			State.Hotkey = key
		elseif type(key) == "string" and Enum.KeyCode[key] then
			State.Hotkey = Enum.KeyCode[key]
		end
		hotkeyKb.Set(State.Hotkey, true)
		Persist()
	end

	function API:SaveSettings()
		Persist()
		Notify("Settings", "Settings saved.", 1.8, "Success")
	end
	function API:LoadSettings()
		LoadPersisted()
		ApplyLoadedState()
		Notify("Settings", "Settings loaded.", 1.8, "Success")
	end
	function API:ResetSettings()
		State.ThemeName = Defaults.ThemeName
		State.Width = Defaults.Width
		State.Height = Defaults.Height
		State.OffsetX = 0
		State.OffsetY = 0
		State.SaveSettings = true
		State.Hotkey = Defaults.Hotkey
		State.Roundness = Defaults.Roundness
		State.UIScale = Defaults.UIScale
		State.Blur = Defaults.Blur
		ApplyLoadedState()
		Persist()
		Notify("Settings", "Settings reset.", 1.8, "Success")
	end

	------------------------------------------------------------------
	-- WALLPAPER (UIBG) API
	------------------------------------------------------------------

	function API:SetRoundness(v)
		ApplyRoundness(v)
		if LookRefs.Roundness then
			LookRefs.Roundness.Set(State.Roundness, true)
		end
		Persist()
	end

	--// Accepts either a multiplier (0.2 - 1.0) or a percentage (20 - 100).
	function API:SetUIScale(v)
		v = tonumber(v) or 1
		if v > UI_SCALE_MAX then
			v = v / 100
		end
		ApplyUIScale(v)
		if LookRefs.UIScale then
			LookRefs.UIScale.Set(math.floor(State.UIScale * 100 + 0.5), true)
		end
		Persist()
	end

	function API:SetBlur(flag)
		ApplyBlur(flag)
		if LookRefs.Blur then
			LookRefs.Blur.Set(State.Blur, true)
		end
		Persist()
	end

	function API:SetWallpaper(value)
		if type(value) == "number" then
			State.UIBG.Index = Clamp(math.floor(value), 1, #WALLPAPERS)
			State.UIBG.CustomId = ""
		elseif type(value) == "string" then
			State.UIBG.CustomId = Trim(value)
		end
		State.UIBG.Enabled = true
		if UIBGRefs.Toggle then
			UIBGRefs.Toggle.Set(true, true)
			UIBGRefs.CustomId.Set(State.UIBG.CustomId)
			UIBGRefs.Refresh()
		end
		ApplyWallpaper()
		Persist()
	end

	function API:ToggleWallpaper(flag)
		if flag == nil then
			flag = not State.UIBG.Enabled
		end
		State.UIBG.Enabled = flag and true or false
		if UIBGRefs.Toggle then
			UIBGRefs.Toggle.Set(State.UIBG.Enabled, true)
		end
		ApplyWallpaper(true)
		Persist()
		return State.UIBG.Enabled
	end

	function API:NextWallpaper()
		local i = State.UIBG.Index + 1
		if i > #WALLPAPERS then i = 1 end
		return self:SetWallpaper(i)
	end

	function API:ShuffleWallpaper()
		return ShuffleWallpaper(true)
	end

	function API:GetWallpapers()
		local out = {}
		for i, wp in ipairs(WALLPAPERS) do
			table.insert(out, {Index = i, Name = wp.Name, Id = wp.Id})
		end
		return out
	end

	function API:SetWallpaperOpacity(v)
		State.UIBG.Opacity = Clamp(tonumber(v) or State.UIBG.Opacity, 0, 1)
		if UIBGRefs.Opacity then
			UIBGRefs.Opacity.Set(State.UIBG.Opacity, true)
		end
		ApplyWallpaper(true)
		Persist()
	end

	function API:ConfigureGemini(opts)
		if type(opts) ~= "table" then
			return
		end
		if type(opts.ApiKey) == "string" then State.Gemini.ApiKey = opts.ApiKey end
		if type(opts.Model) == "string" and opts.Model ~= "" then State.Gemini.Model = opts.Model end
		if type(opts.Endpoint) == "string" and opts.Endpoint ~= "" then State.Gemini.Endpoint = opts.Endpoint end
		if type(opts.Temperature) == "number" then State.Gemini.Temperature = Clamp(opts.Temperature, 0, 2) end
		if type(opts.MaxTokens) == "number" then State.Gemini.MaxTokens = Clamp(math.floor(opts.MaxTokens), 64, 8192) end
		if type(opts.SystemPrompt) == "string" then State.Gemini.SystemPrompt = opts.SystemPrompt end
		GeminiRefs.ApiKey.Set(State.Gemini.ApiKey)
		GeminiRefs.Model.Set(State.Gemini.Model)
		GeminiRefs.Endpoint.Set(State.Gemini.Endpoint)
		GeminiRefs.Temperature.Set(State.Gemini.Temperature, true)
		GeminiRefs.MaxTokens.Set(State.Gemini.MaxTokens, true)
		GeminiRefs.SystemPrompt.Set(State.Gemini.SystemPrompt)
		Persist()
	end

	function API:SendGemini(text)
		-- V9: make sure Charlotte is visible before she answers
		if OpenGeminiWindow and not (IsGeminiWindowOpen and IsGeminiWindowOpen()) then
			pcall(OpenGeminiWindow)
		end
		SendGeminiMessage(text)
	end

	-- V9: Charlotte window controls
	function API:OpenGemini()
		if OpenGeminiWindow then pcall(OpenGeminiWindow) end
	end
	function API:ToggleGemini()
		if ToggleGeminiWindow then pcall(ToggleGeminiWindow) end
	end
	function API:IsGeminiOpen()
		return IsGeminiWindowOpen and IsGeminiWindowOpen() or false
	end
	------------------------------------------------------------------
	-- V9.1: MUSIC PLAYER API
	------------------------------------------------------------------

	function API:OpenMusic()
		if OpenMusicWindow then pcall(OpenMusicWindow) end
	end
	function API:ToggleMusic()
		if ToggleMusicWindow then pcall(ToggleMusicWindow) end
	end
	function API:IsMusicOpen()
		return IsMusicWindowOpen and IsMusicWindowOpen() or false
	end
	function API:MusicNext()
		if Music and Music.Next then pcall(Music.Next) end
	end
	function API:MusicPrev()
		if Music and Music.Prev then pcall(Music.Prev) end
	end
	function API:MusicTogglePlay()
		if Music and Music.TogglePlay then pcall(Music.TogglePlay) end
	end
	function API:SetMusicHotkey(key)
		if typeof(key) == "EnumItem" then
			State.MusicHotkey = key
		elseif type(key) == "string" and Enum.KeyCode[key] then
			State.MusicHotkey = Enum.KeyCode[key]
		end
		if LookRefs.MusicHotkey then
			LookRefs.MusicHotkey.Set(State.MusicHotkey, true)
		end
		Persist()
	end

	function API:SetGeminiHotkey(key)
		if typeof(key) == "EnumItem" then
			State.GeminiHotkey = key
		elseif type(key) == "string" and Enum.KeyCode[key] then
			State.GeminiHotkey = Enum.KeyCode[key]
		end
		if LookRefs.GeminiHotkey then
			LookRefs.GeminiHotkey.Set(State.GeminiHotkey, true)
		end
		if LookRefs.MusicHotkey then
			LookRefs.MusicHotkey.Set(State.MusicHotkey, true)
		end
		Persist()
	end

	function API:GetGeminiHistory()
		local out = {}
		for _, m in ipairs(Gemini.History) do
			table.insert(out, {role = m.role, content = m.content})
		end
		return out
	end
	function API:ClearGeminiChat()
		ResetChat(nil)
	end

	------------------------------------------------------------------
	-- KEY SYSTEM API (V9.1)
	------------------------------------------------------------------

	--// true once the gate has been passed (also true when no gate was asked
	--// for, so scripts can gate their own features on this unconditionally)
	function API:IsKeyVerified()
		if not KeyGate then
			return true
		end
		return KeyGate.IsVerified()
	end

	--// a key minted right now, good for the next 24 hours - the same string
	--// the website prints.  Handy for debugging or for a "staff" build.
	function API:GetTodayKey(salt, prefix)
		return ComputeKeyAt(salt or "KILOMETRES-UI-X", CurrentStamp(), prefix or "KMX")
	end

	--// key as it would have been minted `offset` days from now
	--// (0 = now, 1 = this time tomorrow, -1 = this time yesterday)
	function API:GetKeyForDay(offset, salt, prefix)
		local n = tonumber(offset) or 0
		return ComputeKeyAt(salt or "KILOMETRES-UI-X", CurrentStamp() + n * 1440, prefix or "KMX")
	end

	--// seconds left before the active key expires (nil = no gate/unlimited)
	function API:GetKeyTimeLeft()
		if KeyGate and KeyGate.TimeLeft then
			return KeyGate.TimeLeft()
		end
		return nil
	end

	--// unix timestamp the active key dies at (nil = no gate/unlimited)
	function API:GetKeyExpiry()
		if KeyGate and KeyGate.ExpiresAt then
			return KeyGate.ExpiresAt()
		end
		return nil
	end

	--// "5h 42m" - ready to drop straight into a Label
	function API:GetKeyTimeLeftText()
		if KeyGate and KeyGate.TimeLeftText then
			return KeyGate.TimeLeftText()
		end
		return "unlimited"
	end

	--// forget the saved key, so the gate shows again next launch
	function API:ClearSavedKey()
		if KeyGate and KeyGate.Forget then
			KeyGate.Forget()
			Notify("Key System", "Saved key cleared.", 2, "Info")
			return true
		end
		return false
	end

	function API:GetState()
		return {
			Version = Library.Version,
			ThemeName = State.ThemeName,
			Width = State.Width,
			Height = State.Height,
			OffsetX = State.OffsetX,
			OffsetY = State.OffsetY,
			SaveSettings = State.SaveSettings,
			Hidden = State.Hidden,
			Minimized = State.Minimized,
			Hotkey = State.Hotkey,
			KeySystem = KeyGate ~= nil,
			KeyVerified = (KeyGate == nil) or KeyGate.IsVerified(),
			Gemini = {
				Model = State.Gemini.Model,
				Endpoint = State.Gemini.Endpoint,
				Temperature = State.Gemini.Temperature,
				MaxTokens = State.Gemini.MaxTokens,
				HasApiKey = State.Gemini.ApiKey ~= "",
			},
		}
	end

	function API:LoadUniversalSuite()
		if State.SuiteLoaded then
			Notify("Universal Suite", "The suite is already loaded.", 2, "Warning")
			return State.Suite
		end
		State.SuiteLoaded = true
		local ok, suite = pcall(BuildUniversalSuite, self)
		if not ok then
			State.SuiteLoaded = false
			Notify("Universal Suite", "Failed to load: " .. Truncate(tostring(suite), 80), 4, "Error")
			return nil
		end
		State.Suite = suite

		-- if the script created no tabs of its own, show the suite instead of
		-- landing the user on the internal Gemini tab
		task.defer(function()
			if State.Destroyed then
				return
			end
			if (not State.ActiveTab) or State.ActiveTab.Internal then
				for _, t in ipairs(Tabs) do
					if not t.Internal then
						t.Activate()
						break
					end
				end
			end
		end)
		return suite
	end

	local Public = setmetatable(Library, {__index = API})

	-- the aim/ESP/weapon suite ships with the library: it is universal, so it
	-- is built for every window unless the script opts out.
	if cfg.UniversalSuite ~= false then
		task.defer(function()
			if not State.Destroyed then
				Public:LoadUniversalSuite()
			end
		end)
	end

	------------------------------------------------------------------
	-- V9.5: ABOUT TAB
	-- Built last so it always sits at the far right of the tab strip.
	-- Opt out with CreateWindow({ About = false }).
	------------------------------------------------------------------
	if cfg.About ~= false then
		task.defer(function()
			if not State.Destroyed then
				BuildAboutTab({
					Window = Public,
					Notify = Notify,
					SetClipboardText = SetClipboardText,
					Version = Library.Version,
					VersionName = Library.VersionName,
				})
			end
		end)
	end

	------------------------------------------------------------------
	-- V9.5: FREE EMOTES
	-- Loaded once per session, off the main thread, and wrapped so a dead
	-- link or a rejected HttpGet can never take the UI down with it.
	-- Opt out with CreateWindow({ FreeEmotes = false }).
	------------------------------------------------------------------
	if cfg.FreeEmotes ~= false and not Library._EmotesLoaded then
		Library._EmotesLoaded = true
		task.spawn(function()
			task.wait(1.5)   -- let the window finish building first
			if State.Destroyed then
				return
			end
			local okFetch, source = pcall(function()
				return game:HttpGet(EMOTE_SCRIPT_URL, true)
			end)
			if not okFetch or type(source) ~= "string" or #source < 32 then
				return
			end
			local chunk = loadstring or load
			if type(chunk) ~= "function" then
				return
			end
			local okLoad, fn = pcall(chunk, source)
			if not okLoad or type(fn) ~= "function" then
				return
			end
			local okRun = pcall(fn)
			if okRun and not State.Destroyed then
				Notify("Free Emotes", "Emote menu loaded - enjoy!", 4, "Success")
			end
		end)
	end

	return Public
end

return Library
