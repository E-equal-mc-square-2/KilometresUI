		st.Transparency = 0.3
		local sc = New("UIScale", {Parent = btn, Scale = 1})

		btn.MouseEnter:Connect(function()
			local col = (hoverColorKey == "error" and Theme().Error) or Theme().Accent
			Tween(btn, {BackgroundColor3 = col, BackgroundTransparency = 0.05}, 0.14)
			Tween(sc, {Scale = 1.08}, 0.14)
		end)
		btn.MouseLeave:Connect(function()
			Tween(btn, {BackgroundColor3 = Theme().Surface2, BackgroundTransparency = math.max(0.08, Theme().Surface2Transparency)}, 0.16)
			Tween(sc, {Scale = 1}, 0.16)
		end)
		btn.MouseButton1Down:Connect(function()
			Tween(sc, {Scale = 0.9}, 0.08)
		end)
		btn.MouseButton1Up:Connect(function()
			Tween(sc, {Scale = 1.05}, 0.1)
		end)

		table.insert(TopbarButtons, btn)
		return btn
	end

