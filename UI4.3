	local StatusPulse = false

	local function SetStatus(text, colorKey)
		local T = Theme()
		StatusLabel.Text = tostring(text)
		if colorKey == "accent" then
			StatusLabel.TextColor3 = T.Accent
		elseif colorKey == "error" then
			StatusLabel.TextColor3 = T.Error
		elseif colorKey == "success" then
			StatusLabel.TextColor3 = T.Success
		else
			StatusLabel.TextColor3 = T.TextDim
		end
	end

	local function StartStatusPulse()
		if StatusPulse then
			return
		end
		StatusPulse = true
		task.spawn(function()
			while StatusPulse and not State.Destroyed do
				Tween(StatusLabel, {TextTransparency = 0.55}, 0.45)
				task.wait(0.5)
				Tween(StatusLabel, {TextTransparency = 0}, 0.45)
				task.wait(0.5)
			end
			StatusLabel.TextTransparency = 0
		end)
	end

	local function StopStatusPulse()
		StatusPulse = false
		StatusLabel.TextTransparency = 0
	end

	SetGeminiMode = function(modeName, notifyIt)
		if modeName ~= "Chat" and modeName ~= "Coder" then
			modeName = "Chat"
		end
		State.Gemini.Mode = modeName
		RefreshModePills()
		SendBtn.Text = (modeName == "Coder") and "Build" or "Send"
		ChatInput.PlaceholderText = (modeName == "Coder")
			and "Describe the script you want...  (/help)"
			or "Message Gemini...  (/help)"
		if not Gemini.Sending then
			SetStatus(modeName == "Coder" and "CODER MODE - AI WRITES LUAU" or "CHAT MODE - READY", "idle")
		end
		if GeminiRefs.Mode then
			GeminiRefs.Mode.Set(modeName, true)
		end
		Persist()
		if notifyIt then
			Notify("Gemini AI", modeName .. " mode enabled.", 1.5, "Info")
		end
	end

	GeminiHooks.SetMode = function(modeName)
		SetGeminiMode(modeName, false)
