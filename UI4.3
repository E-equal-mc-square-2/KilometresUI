			sys.Text = FormatChunk(text, 11)
			ScrollBottom()
			return row
		end

		local bubble = New("Frame", {
			Parent = row,
			AnchorPoint = Vector2.new(isUser and 1 or 0, 0),
			Position = UDim2.new(isUser and 1 or 0, 0, 0, 0),
			Size = UDim2.new(0.82, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = isUser and T.Accent or (isError and T.Error or T.Surface2),
			BackgroundTransparency = isError and 0.25 or (isUser and 0.05 or T.Surface2Transparency),
			BorderSizePixel = 0,
			ZIndex = 53,
		})
		Corner(bubble, 16)
		if isUser then
			Gradient(bubble, ColorLerp(T.Accent, Color3.new(1, 1, 1), 0.18), ColorLerp(T.Accent, Color3.new(0, 0, 0), 0.22), 90)
		else
			local s = Stroke(bubble, isError and T.Error or T.Stroke, 1)
			s.Transparency = 0.3
		end
		New("UIPadding", {Parent = bubble, PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)})
		New("UIListLayout", {Parent = bubble, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder})

		local whoText = isUser and "You" or (isError and "Error" or "Gemini")
		if stamp then
			whoText = whoText .. "  -  " .. stamp
		end
		local meta = New("TextLabel", {
			Parent = bubble,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 12),
			Text = whoText,
			TextColor3 = isUser and Color3.new(1, 1, 1) or T.TextDim,
			TextTransparency = isUser and 0.25 or 0,
			TextSize = 10,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
			ZIndex = 54,
		})

		local textColor = isUser and Color3.new(1, 1, 1) or (isError and Color3.fromRGB(255, 226, 226) or T.Text)

		if isUser or isError then
			local lbl = New("TextLabel", {
				Parent = bubble,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = " ",
				RichText = true,
				TextColor3 = textColor,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				LayoutOrder = 2,
				ZIndex = 54,
			})
			lbl.Text = Esc(StripUnsupportedGlyphs(text))
		else
			local order = 2
			for _, seg in ipairs(SplitCodeBlocks(text)) do
				if seg.code then
					AddCodeBlock(bubble, seg.text, order)
				else
					local lbl = New("TextLabel", {
						Parent = bubble,
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						RichText = true,
						Text = " ",
						TextColor3 = textColor,
						TextSize = 13,
						Font = Enum.Font.Gotham,
						TextWrapped = true,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						LayoutOrder = order,
						ZIndex = 54,
					})

					local plain = StripUnsupportedGlyphs(seg.text or "")
					if animate and State.Gemini.Typewriter and #plain > 0 and #plain <= 1400 then
						-- typewriter reveal (plain text first, formatted at the end)
						local myGen = Gemini.Generation
						lbl.RichText = false
						lbl.Text = ""
						task.spawn(function()
							local i = 0
							local step = math.max(2, math.floor(#plain / 90))
							while i < #plain do
								if State.Destroyed or myGen ~= Gemini.Generation or not lbl.Parent then
									break
								end
								i = math.min(#plain, i + step)
								lbl.Text = plain:sub(1, i)
								ScrollBottom()
								task.wait(0.016)
							end
							if lbl and lbl.Parent then
								lbl.RichText = true
								lbl.Text = FormatChunk(plain, 13)
							end
						end)
					else
						lbl.Text = FormatChunk(plain, 13)
					end
				end
				order = order + 1
			end

			local actions = New("Frame", {
				Parent = bubble,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				LayoutOrder = order + 1,
				ZIndex = 54,
			})
			New("UIListLayout", {
				Parent = actions,
				Padding = UDim.new(0, 6),
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
			})
			MakeSmallButton(actions, "Copy", 1, 50, function()
				if SetClipboardText(text) then
					Notify("Copied", "Response copied to clipboard.", 1.4, "Success")
				else
					Notify("Clipboard", "setclipboard is not supported here.", 2, "Warning")
				end
			end)
			MakeSmallButton(actions, "Speak Again", 2, 78, function()
				if GeminiHooks.Regenerate then
					GeminiHooks.Regenerate()
				end
			end)
		end

		local bs = New("UIScale", {Parent = bubble, Scale = 0.94})
		Tween(bs, {Scale = 1}, 0.18)

		AddRefresher(function()
			if not (bubble and bubble.Parent) then
				return
			end
			local T2 = Theme()
			bubble.BackgroundColor3 = isUser and T2.Accent or (isError and T2.Error or T2.Surface2)
			bubble.BackgroundTransparency = isError and 0.25 or (isUser and 0.05 or T2.Surface2Transparency)
			if not isUser then
				Stroke(bubble, isError and T2.Error or T2.Stroke, 1)
			end
			meta.TextColor3 = isUser and Color3.new(1, 1, 1) or T2.TextDim
		end)

		ScrollBottom()
		return row
	end

