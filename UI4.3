	------------------------------------------------------------------
	-- TRANSPORT ROW  ·  prev / play / next / shuffle / repeat
	------------------------------------------------------------------

	local TransportRow = New("Frame", {
		Parent = DiscHost,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 206),
		Size = UDim2.new(1, 0, 0, 38),
		ZIndex = 37,
	})
	New("UIListLayout", {
		Parent = TransportRow,
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local TransportButtons = {}

	local function TransportButton(order, diameter, primary)
		local btn = New("TextButton", {
			Parent = TransportRow,
			LayoutOrder = order,
			Size = UDim2.fromOffset(diameter, diameter),
			BackgroundColor3 = primary and Theme().Accent or Theme().Surface2,
			BackgroundTransparency = primary and 0 or math.max(0.08, Theme().Surface2Transparency),
			BorderSizePixel = 0,
			Text = "",
			TextColor3 = primary and Color3.new(1, 1, 1) or Theme().Text,
			TextSize = primary and 12 or 11,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			ZIndex = 38,
		})
		Corner(btn, 999)
		local st = Stroke(btn, Theme().Stroke, 1)
		st.Transparency = 0.35
		local sc = New("UIScale", {Parent = btn, Scale = 1})
		btn.MouseEnter:Connect(function()
			Tween(sc, {Scale = 1.1}, 0.12)
		end)
		btn.MouseLeave:Connect(function()
			Tween(sc, {Scale = 1}, 0.14)
		end)
		btn.MouseButton1Down:Connect(function()
			Tween(sc, {Scale = 0.88}, 0.07)
		end)
		btn.MouseButton1Up:Connect(function()
			Tween(sc, {Scale = 1.06}, 0.1)
		end)
		TransportButtons[btn] = primary and true or false
		return btn
	end

	local ShuffleBtn = TransportButton(1, 28, false)
	local PrevBtn    = TransportButton(2, 32, false)
	local PlayBtn    = TransportButton(3, 40, true)
	local NextBtn    = TransportButton(4, 32, false)
