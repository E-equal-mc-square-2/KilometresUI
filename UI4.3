--// V9.1: play / pause / stop drawn from plain Frames.  Two rounded bars make
--// the pause and stop states; the play triangle is faked by stacking three
--// bars of decreasing height, which reads correctly at icon sizes and needs
--// no image asset at all.
local function MediaGlyph(parent, kind, size, color, zindex)
	size = size or 14
	zindex = zindex or ((parent and parent.ZIndex or 1) + 1)

	local holder = Instance.new("Frame")
	holder.Name = "KM_MediaGlyph"
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(size, size)
	holder.BackgroundTransparency = 1
	holder.ZIndex = zindex
	holder.Parent = parent

	local bars = {}
	for i = 1, 3 do
		local b = Instance.new("Frame")
		b.Name = "Bar" .. i
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.BorderSizePixel = 0
		b.BackgroundColor3 = color or Color3.new(1, 1, 1)
		b.ZIndex = zindex + 1
		b.Parent = holder
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 1)
		c.Parent = b
		bars[i] = b
	end

	local api = {Holder = holder, Bars = bars}

	function api:SetKind(k)
		api.Kind = k
		local w = math.max(2, size * 0.2)
		if k == "pause" then
			bars[3].Visible = false
			for i = 1, 2 do
				bars[i].Visible = true
				bars[i].Size = UDim2.fromOffset(w, size * 0.78)
				bars[i].Position = UDim2.fromScale(i == 1 and 0.34 or 0.66, 0.5)
			end
		elseif k == "stop" then
			bars[2].Visible = false
			bars[3].Visible = false
			bars[1].Visible = true
			bars[1].Size = UDim2.fromOffset(size * 0.68, size * 0.68)
			bars[1].Position = UDim2.fromScale(0.5, 0.5)
		else -- "play"
			-- three slivers, tallest at the left, form a right-pointing wedge
			local heights = {0.80, 0.54, 0.24}
			for i = 1, 3 do
				bars[i].Visible = true
				bars[i].Size = UDim2.fromOffset(math.max(2, size * 0.16), size * heights[i])
				bars[i].Position = UDim2.fromScale(0.33 + (i - 1) * 0.18, 0.5)
			end
		end
	end

	function api:SetColor(c)
		for i = 1, 3 do
			bars[i].BackgroundColor3 = c
		end
	end

	api:SetKind(kind or "play")
	return api
end

--// V9.1: skip-track glyph - a media wedge plus the end bar, mirrored for prev
local function SkipGlyph(parent, forward, size, color, zindex)
	size = size or 13
	zindex = zindex or ((parent and parent.ZIndex or 1) + 1)

	local holder = Instance.new("Frame")
	holder.Name = "KM_SkipGlyph"
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(size, size)
	holder.BackgroundTransparency = 1
	holder.ZIndex = zindex
	holder.Parent = parent

	local wedge = MediaGlyph(holder, "play", size * 0.82, color, zindex + 1)
	wedge.Holder.Position = UDim2.fromScale(forward and 0.40 or 0.60, 0.5)
	wedge.Holder.Rotation = forward and 0 or 180

	local cap = Instance.new("Frame")
	cap.Name = "Cap"
	cap.AnchorPoint = Vector2.new(0.5, 0.5)
	cap.Position = UDim2.fromScale(forward and 0.82 or 0.18, 0.5)
	cap.Size = UDim2.fromOffset(math.max(2, size * 0.15), size * 0.72)
	cap.BackgroundColor3 = color or Color3.new(1, 1, 1)
	cap.BorderSizePixel = 0
	cap.ZIndex = zindex + 1
	cap.Parent = holder
	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(0, 1)
	cc.Parent = cap

	local api = {Holder = holder, Wedge = wedge, Cap = cap}
	function api:SetColor(c)
		wedge:SetColor(c)
		cap.BackgroundColor3 = c
	end
	return api
end

local function Tween(obj, props, speed, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(speed or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function Clamp(v, mn, mx)
	return math.max(mn, math.min(mx, v))
end

local function Lerp(a, b, t)
	return a + (b - a) * t
end

local function ColorLerp(a, b, t)
	return Color3.new(Lerp(a.R, b.R, t), Lerp(a.G, b.G, t), Lerp(a.B, b.B, t))
end

local function SafeCall(fn, ...)
	if type(fn) == "function" then
		local args = {...}
		task.spawn(function()
			pcall(fn, unpack(args))
		end)
	end
end

local function IsPortrait()
	local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
	return vp.Y > vp.X
end

local function TryReadFile(path)
	if type(isfile) == "function" and type(readfile) == "function" and isfile(path) then
		local ok, data = pcall(readfile, path)
		if ok and type(data) == "string" then
			return data
		end
	end
	return nil
end

local function TryWriteFile(path, data)
	if type(makefolder) == "function" then
		local folder = path:match("^(.*)/[^/]+$")
		if folder and folder ~= "" then
			pcall(function()
				if type(isfolder) == "function" and not isfolder(folder) then
					makefolder(folder)
				end
			end)
		end
	end
	if type(writefile) == "function" then
		pcall(writefile, path, data)
	end
end

local function SafeJSONEncode(tbl)
	local ok, res = pcall(function()
		return HttpService:JSONEncode(tbl)
	end)
	if ok then
		return res
	end
	return nil
end

local function SafeJSONDecode(str)
	if type(str) ~= "string" or str == "" then
		return nil
	end
	local ok, res = pcall(function()
		return HttpService:JSONDecode(str)
	end)
	if ok and type(res) == "table" then
		return res
	end
	return nil
end

--// Executor HTTP bridge: request / http_request / syn.request / http.request
--// with a Studio-safe HttpService:RequestAsync fallback.
local RawRequest =
	(type(request) == "function" and request)
	or (type(http_request) == "function" and http_request)
	or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
	or (type(http) == "table" and type(http.request) == "function" and http.request)
	or (type(fluxus) == "table" and type(fluxus.request) == "function" and fluxus.request)

local function HttpPost(url, jsonBody)
	if RawRequest then
		return RawRequest({
			Url = url,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Accept"] = "application/json",
			},
			Body = jsonBody,
		})
	end
	-- fallback (Studio / local testing)
	return HttpService:RequestAsync({
		Url = url,
		Method = "POST",
		Headers = {["Content-Type"] = "application/json"},
		Body = jsonBody,
	})
end

local SetClip =
	(type(setclipboard) == "function" and setclipboard)
	or (type(toclipboard) == "function" and toclipboard)
	or nil

local function SetClipboardText(text)
	if SetClip then
		local ok = pcall(SetClip, tostring(text))
		return ok
	end
	return false
end

--// RichText escaping (used before any richtext formatting)
local function Esc(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	s = s:gsub('"', "&quot;")
	s = s:gsub("'", "&apos;")
	return s
end

--// Roblox's Gotham has no emoji glyphs, so unsupported codepoints render as
--// a tofu box. Strip them for display (the raw text is kept for copy/execute).
local function StripUnsupportedGlyphs(s)
	s = tostring(s or "")
	if type(utf8) ~= "table" or type(utf8.codes) ~= "function" then
		return s
	end
	local ok, out = pcall(function()
		local parts = {}
		for _, code in utf8.codes(s) do
			local drop =
				code >= 0x1F000                      -- emoji + pictographs
				or code == 0xFE0F or code == 0xFE0E  -- variation selectors
				or code == 0x200D or code == 0x20E3  -- ZWJ / keycap
				or (code >= 0xE000 and code <= 0xF8FF) -- private use
			if not drop then
				table.insert(parts, utf8.char(code))
			end
		end
		return table.concat(parts)
	end)
	if ok and type(out) == "string" then
		return out
	end
	return s
end

local function Truncate(s, max)
	s = tostring(s or "")
	if #s > max then
		return s:sub(1, max - 3) .. "..."
	end
	return s
end

local function Trim(s)
	return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function Color3ToHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5))
end

local function HexToColor3(s)
	s = tostring(s or ""):gsub("#", ""):gsub("%s", "")
	if #s == 3 then
		s = s:sub(1, 1) .. s:sub(1, 1) .. s:sub(2, 2) .. s:sub(2, 2) .. s:sub(3, 3) .. s:sub(3, 3)
	end
	if #s ~= 6 or s:find("[^0-9a-fA-F]") then
		return nil
	end
	local r = tonumber(s:sub(1, 2), 16)
	local g = tonumber(s:sub(3, 4), 16)
	local b = tonumber(s:sub(5, 6), 16)
	if not (r and g and b) then
		return nil
	end
	return Color3.fromRGB(r, g, b)
end

local function FormatNumber(v, step)
	if step and step % 1 ~= 0 then
		local out = string.format("%.2f", v)
		out = out:gsub("0+$", ""):gsub("%.$", "")
		return out
	end
	return tostring(math.floor(v + 0.5))
end

--// ======================================================================
--// MARKDOWN-LITE  (safe RichText formatting for Gemini responses)
--// ======================================================================

local function SplitCodeBlocks(text)
	local parts = {}
	text = tostring(text or "")
	local i = 1
	while true do
		local s, e = text:find("```", i, true)
		if not s then
			local rest = text:sub(i)
			if rest ~= "" then
				table.insert(parts, {code = false, text = rest})
			end
			break
		end
		if s > i then
			table.insert(parts, {code = false, text = text:sub(i, s - 1)})
		end
		local s2, e2 = text:find("```", e + 1, true)
		if not s2 then
			-- unterminated fence: treat the remainder as code
			table.insert(parts, {code = true, text = text:sub(e + 1)})
			break
		end
		local body = text:sub(e + 1, s2 - 1)
		body = body:gsub("^%w+\n", "") -- strip optional language tag line
		body = body:gsub("^\n", ""):gsub("\n$", "")
		table.insert(parts, {code = true, text = body})
		i = e2 + 1
	end
	if #parts == 0 then
		table.insert(parts, {code = false, text = ""})
	end
	return parts
end

local function FormatInline(s)
	s = Esc(s)
	s = s:gsub("%*%*(.-)%*%*", "<b>%1</b>")
	s = s:gsub("__(.-)__", "<b>%1</b>")
	s = s:gsub("%*([^%s*][^*]-)%*", "<i>%1</i>")
	s = s:gsub("`([^`]+)`", '<font color="#9CDCFE">%1</font>')
	return s
end

local function FormatChunk(text, baseSize)
	text = StripUnsupportedGlyphs(text)
	baseSize = baseSize or 13
	local out = {}
	for line in (tostring(text or "") .. "\n"):gmatch("(.-)\n") do
		local hashes, headerBody = line:match("^(#+)%s+(.+)$")
		if hashes and headerBody then
			local lvl = math.min(3, #hashes)
			local size = baseSize + (4 - lvl) * 2
			table.insert(out, string.format('<font size="%d"><b>%s</b></font>', size, FormatInline(headerBody)))
		else
			local listBody = line:match("^%s*[%-%*%+]%s+(.+)$")
			if listBody then
				table.insert(out, "  •  " .. FormatInline(listBody))
			else
				table.insert(out, FormatInline(line))
			end
		end
	end
	local result = table.concat(out, "\n")
	if result == "" then
		result = " "
	end
	return result
end

