	local WallpaperStatus = {Downloading = false, Message = ""}

	local function CurrentWallpaper()
		local w = State.UIBG
		if Trim(w.CustomId) ~= "" then
			return nil
		end
		return WALLPAPERS[w.Index]
	end

	ApplyWallpaper = function(silent)
		local w = State.UIBG
		local asset, isLocal = nil, false
		local custom = Trim(w.CustomId)

		if custom ~= "" then
			if custom:match("^%d+$") then
				asset = "rbxassetid://" .. custom
			else
				asset = custom
			end
		else
			asset, isLocal = WallpaperAsset(WALLPAPERS[w.Index])
		end

		local on = w.Enabled and asset ~= nil
		UIBGImage.Visible = on
		UIBGScrim.Visible = on
		UIBGWash.Visible = on
		UIBGSheen.Visible = on and w.Motion

		if not on then
			return
		end

		UIBGImage.Image = asset
		UIBGImage.ScaleType = ScaleTypeFromName(w.ScaleMode)
		if w.ScaleMode == "Tile" then
			UIBGImage.TileSize = UDim2.fromScale(0.34, 0.34)
		end
		UIBGWash.BackgroundColor3 = Theme().Accent

		if silent then
			UIBGImage.ImageTransparency = Clamp(w.Opacity, 0, 1)
			UIBGScrim.BackgroundTransparency = 1 - Clamp(w.Darken, 0, 1)
		else
			UIBGImage.ImageTransparency = 1
			Tween(UIBGImage, {ImageTransparency = Clamp(w.Opacity, 0, 1)}, 0.4)
			Tween(UIBGScrim, {BackgroundTransparency = 1 - Clamp(w.Darken, 0, 1)}, 0.3)
		end

		-- lazily pull the picture into  img/  the first time it is used
		if custom == "" and not isLocal and FileSystemOK then
			local wp = WALLPAPERS[w.Index]
			if wp and wp.Url and not WallpaperStatus.Downloading then
				WallpaperStatus.Downloading = true
				task.spawn(function()
					local ok = CacheWallpaper(wp)
					WallpaperStatus.Downloading = false
					if ok and not State.Destroyed and State.UIBG.Index == w.Index then
						local newAsset = WallpaperAsset(wp)
						if newAsset then
							UIBGImage.Image = newAsset
						end
					end
				end)
			end
		end
	end

	local function ShuffleWallpaper()
		if #WALLPAPERS == 0 then
			return State.UIBG.Index
		end
		local newIndex = State.UIBG.Index
		if #WALLPAPERS > 1 then
			repeat
				newIndex = math.random(1, #WALLPAPERS)
			until newIndex ~= State.UIBG.Index
		end
		State.UIBG.Index = newIndex
		State.UIBG.CustomId = ""
		ApplyWallpaper()
		Persist()
		if UIBGRefs.Refresh then
			UIBGRefs.Refresh()
		end
		return newIndex
	end

	-- sheen animation loop (only alive while motion + wallpaper are on)
	task.spawn(function()
		while not State.Destroyed do
			if State.UIBG.Enabled and State.UIBG.Motion and UIBGSheen.Visible then
				SheenGradient.Offset = Vector2.new(-1.2, 0)
				Tween(SheenGradient, {Offset = Vector2.new(1.2, 0)}, 3.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(6.5)
			else
				task.wait(1)
			end
		end
	end)

