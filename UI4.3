		Links:Paragraph(
			"The owner's hub",
			"Every account, page and project in one place: " .. ABOUT_HUB_URL
		)
		Links:Button("Copy the owner's hub link", function()
			if SetClipboardText(ABOUT_HUB_URL) then
				Notify("About", "Hub link copied to your clipboard.", "Success")
			else
				Notify("About", ABOUT_HUB_URL, "Info", 6)
			end
		end, {Icon = "link"})
		Links:Button("Copy the library website", function()
			if SetClipboardText(ABOUT_SITE_URL) then
				Notify("About", "Website link copied.", "Success")
			else
				Notify("About", ABOUT_SITE_URL, "Info", 6)
			end
		end, {Icon = "link"})

		----------------------------------------------------------------
		local Credits = Tab:CreateSection("Which AI actually helped - honestly")
		Credits:Info(
			"No exaggerating and no made-up names. This is the real list."
		)
		for _, row in ipairs(ABOUT_AI_CREDITS) do
			Credits:Paragraph(row[1], row[2])
		end

		----------------------------------------------------------------
		local Thanks = Tab:CreateSection("Credits")
		Thanks:Paragraph(
			"Human work",
			"Direction, design decisions, testing in real games and every "
				.. "'no, do it properly' - the owner of this script."
		)
		Thanks:Paragraph(
			"Third party",
			"Music hosted by archive.org. Free emote menu by 7yd7. "
				.. "Fonts and rendering by Roblox. Everything else is "
				.. "original to this project."
		)
		Thanks:Divider()
		Thanks:Label("Made with care, not with copy-paste.")

		return Tab
	end)

	if not ok then
		return nil, err
	end
	return true
end

--// ======================================================================
--// UNIVERSAL SUITE  (built in: aimbot, ESP, weapons, player, relocation)
--//   Created automatically for every window unless you pass
--//   UniversalSuite = false to CreateWindow, or call Window:LoadUniversalSuite()
--// ======================================================================

local function BuildUniversalSuite(Window)
	--// ----------------------------------------------------------------------
	--// 1. SERVICES / SHORTCUTS
	--// ----------------------------------------------------------------------

	local Players       = game:GetService("Players")
	local RunService    = game:GetService("RunService")
	local UIS           = game:GetService("UserInputService")
	local Lighting      = game:GetService("Lighting")
	local StarterGui    = game:GetService("StarterGui")
	local TeleportSvc   = game:GetService("TeleportService")
	local Stats         = game:FindService("Stats")

	local LocalPlayer = Players.LocalPlayer
	local Camera      = workspace.CurrentCamera
	local Mouse       = LocalPlayer:GetMouse()

	local HasDrawing    = (type(Drawing) == "table" and type(Drawing.new) == "function")
	local MouseMoveRel  = (type(mousemoverel) == "function" and mousemoverel) or nil
	local Mouse1Press   = (type(mouse1press) == "function" and mouse1press) or nil
	local Mouse1Release = (type(mouse1release) == "function" and mouse1release) or nil
	local SetClip       = (type(setclipboard) == "function" and setclipboard) or nil

	--// ----------------------------------------------------------------------
	--// 2. STATE
	--// ----------------------------------------------------------------------

	local S = {
		-- aimbot
		AimEnabled       = false,
		AimMode          = "Camera Lock",   -- Camera Lock | Aim Assist
		AimKeyHold       = true,            -- true = hold key, false = toggle
		AimKey           = Enum.KeyCode.E,
		AimActive        = false,           -- toggle-mode state
		TargetPart       = "Head",          -- Head | Torso | Nearest | Random
		Smoothing        = 0.18,            -- 0 = instant, 1 = molasses
		FOV              = 160,
		ShowFOV          = true,
		FOVColor         = Color3.fromRGB(130, 110, 255),
		WallCheck        = true,
		TeamCheck        = true,
		AliveCheck       = true,
		MaxDistance      = 1500,
		Prediction       = false,
		PredictionAmount = 0.14,
		StickyAim        = true,
		SnapOnFire       = false,
		FFA              = false,
		StayBehind       = false,
		StayBehindOffset = 4,

		-- triggerbot
		TriggerBot       = false,
		TriggerDelay     = 0.08,
		TriggerHoldTime  = 0.05,

		-- esp
		ESPEnabled       = false,
		ESPBox           = true,
		ESPName          = true,
		ESPHealth        = true,
		ESPDistance      = true,
		ESPTracer        = false,
		ESPSkeleton      = false,
		ESPChams         = false,
		ESPTeamColor     = true,
		ESPMaxDistance   = 2000,
		ESPEnemyColor    = Color3.fromRGB(255, 70, 70),
		ESPAllyColor     = Color3.fromRGB(90, 255, 140),

		-- weapons
		UnlimitedAmmo    = false,
		NoReload         = false,
		NoRecoil         = false,
		NoSpread         = false,
		FastFire         = false,
		FireRateScale    = 0.35,

		-- player
		WalkSpeed        = 16,
		JumpPower        = 50,
		CustomSpeed      = false,
		CustomJump       = false,
		InfiniteJump     = false,
		NoClip           = false,
		Flying           = false,
		FlySpeed         = 60,
		HitboxExpand     = false,
		HitboxSize       = 6,
		AntiAFK          = true,
		Spinbot          = false,

		ClickTP          = false,

		-- world
		FullBright       = false,
		NoFog            = false,
		XRay             = false,
		FPSBoost         = false,
		CameraFOV        = 70,
	}

	local Connections = {}
	local Drawings = {}
	local ESPObjects = {}
	local Waypoints = {}
	local Unloading = false

	local function Bind(signal, fn)
		local conn = signal:Connect(fn)
		table.insert(Connections, conn)
		return conn
	end

	local function Try(fn, ...)
		local ok, err = pcall(fn, ...)
		if not ok and not Unloading then
			-- silent: a single odd game should never spam the console
		end
		return ok, err
	end

	--// ----------------------------------------------------------------------
	--// 3. NOTIFY SHIM (uses the host window)
	--// ----------------------------------------------------------------------

	local function Notify(title, text, ntype, dur)
		Try(function()
			Window:Notify(title, text, dur or 2.2, ntype or "Info")
		end)
	end

	--// ----------------------------------------------------------------------
	--// 4. CORE HELPERS
	--// ----------------------------------------------------------------------

	local function GetChar(plr)
		return plr and plr.Character
	end

	local function GetHum(plr)
		local c = GetChar(plr)
		return c and c:FindFirstChildOfClass("Humanoid")
	end

	local function GetRoot(plr)
		local c = GetChar(plr)
		return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
	end

	local function IsAlive(plr)
		local hum = GetHum(plr)
		return hum ~= nil and hum.Health > 0
	end

	local function MyRoot()
		return GetRoot(LocalPlayer)
	end

	local function TeamOk(plr)
		if S.FFA or not S.TeamCheck then
			return true
		end
		if not LocalPlayer.Team or not plr.Team then
			return true
		end
		return LocalPlayer.Team ~= plr.Team
	end

	-- V9: real frame delta, refreshed by the RenderStepped loop below. Used to
	-- keep aim smoothing framerate-independent.
	local FrameDelta = 1 / 60

	local function ShouldTarget(plr)
		if not plr or plr == LocalPlayer then
			return false
		end
		if not GetChar(plr) or not GetRoot(plr) then
			return false
		end
		if S.AliveCheck and not IsAlive(plr) then
			return false
		end
		return TeamOk(plr)
	end

	local function PartFor(plr)
		local c = GetChar(plr)
		if not c then
			return nil
		end
		local mode = S.TargetPart
		if mode == "Head" then
			return c:FindFirstChild("Head") or GetRoot(plr)
		elseif mode == "Torso" then
			return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or GetRoot(plr)
		elseif mode == "Random" then
			local pool = {"Head", "UpperTorso", "Torso", "HumanoidRootPart", "LeftHand", "RightHand"}
			local pick = c:FindFirstChild(pool[math.random(1, #pool)])
			return pick or GetRoot(plr)
		end
		-- Nearest: closest body part to the crosshair
		local best, bestDist = nil, math.huge
		local center = Camera.ViewportSize * 0.5
		for _, part in ipairs(c:GetChildren()) do
			if part:IsA("BasePart") then
				local sp, on = Camera:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if d < bestDist then
						best, bestDist = part, d
					end
				end
			end
		end
		return best or GetRoot(plr)
	end

	--// newer clients use Exclude, older ones only have Blacklist
	local EXCLUDE_FILTER
	do
		local ok, value = pcall(function()
			return Enum.RaycastFilterType.Exclude
		end)
		if ok and value then
			EXCLUDE_FILTER = value
		else
			EXCLUDE_FILTER = Enum.RaycastFilterType.Blacklist
		end
	end

	local function IsVisible(part, plr)
		if not S.WallCheck or not part then
			return true
		end
		local params = RaycastParams.new()
		params.FilterType = EXCLUDE_FILTER
		params.FilterDescendantsInstances = {GetChar(LocalPlayer), GetChar(plr)}
		params.IgnoreWater = true
		local origin = Camera.CFrame.Position
		local hit = workspace:Raycast(origin, part.Position - origin, params)
		return hit == nil
	end

	-- V9 FIX: prediction now uses velocity RELATIVE to the local player, so it
	-- no longer over-leads while you are moving alongside the target.
	local function PredictedPosition(part)
		if not part then
			return Vector3.new()
		end
		if not S.Prediction then
			return part.Position
		end
		local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.new()
		local myRoot = MyRoot()
		if myRoot then
			local myVel = myRoot.AssemblyLinearVelocity or myRoot.Velocity or Vector3.new()
			vel = vel - myVel
		end
		return part.Position + (vel * S.PredictionAmount)
	end

	--// screen-space picker: closest enemy to the crosshair inside the FOV ring
	local CurrentTarget = nil

	local function AcquireTarget()
		local center = Camera.ViewportSize * 0.5
		local myRoot = MyRoot()
		local best, bestScore = nil, math.huge

		-- V9 PERF/FIX: sticky aim is now checked FIRST. Previously the full
		-- player scan ran every frame even when the locked target was still
		-- perfectly valid, and the result was thrown away.
		if S.StickyAim and CurrentTarget and ShouldTarget(CurrentTarget) then
			local part = PartFor(CurrentTarget)
			if part then
				local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					local wd = myRoot and (myRoot.Position - part.Position).Magnitude or 0
					if d <= S.FOV * 1.25 and wd <= S.MaxDistance and IsVisible(part, CurrentTarget) then
						return CurrentTarget
					end
				end
			end
		end

		for _, plr in ipairs(Players:GetPlayers()) do
			if ShouldTarget(plr) then
				local part = PartFor(plr)
				if part then
					local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						local worldDist = myRoot and (myRoot.Position - part.Position).Magnitude or 0
						if screenDist <= S.FOV and worldDist <= S.MaxDistance then
							if IsVisible(part, plr) then
								if screenDist < bestScore then
									best, bestScore = plr, screenDist
								end
							end
						end
					end
				end
			end
		end

		CurrentTarget = best
		return best
	end

	--// ----------------------------------------------------------------------
	--// 5. FOV CIRCLE
	--// ----------------------------------------------------------------------

	local FOVCircle
	if HasDrawing then
		FOVCircle = Drawing.new("Circle")
		FOVCircle.Thickness = 1.5
		FOVCircle.NumSides = 90
		FOVCircle.Filled = false
		FOVCircle.Transparency = 0.9
		FOVCircle.Visible = false
		FOVCircle.Color = S.FOVColor
		table.insert(Drawings, FOVCircle)
	end

	local function UpdateFOVCircle()
		if not FOVCircle then
			return
		end
		FOVCircle.Visible = S.ShowFOV and S.AimEnabled and not Unloading
		FOVCircle.Radius = S.FOV
		FOVCircle.Color = S.FOVColor
		FOVCircle.Position = Camera.ViewportSize * 0.5
	end

	--// ----------------------------------------------------------------------
	--// 6. AIMBOT
	--// ----------------------------------------------------------------------

	local function AimKeyDown()
		if not S.AimKeyHold then
			return S.AimActive
		end
		if UIS:IsKeyDown(S.AimKey) then
			return true
		end
		-- touch devices: aim while the player is holding the screen
		if UIS.TouchEnabled and not UIS.KeyboardEnabled then
			return S.AimActive
		end
		return false
	end

	local function AimAt(part)
		if not part then
			return
		end
		local goalPos = PredictedPosition(part)

		if S.AimMode == "Aim Assist" and MouseMoveRel then
			-- soft pull: nudge the real mouse a fraction of the way each frame
			local sp = Camera:WorldToViewportPoint(goalPos)
			local center = Camera.ViewportSize * 0.5
			local dx = (sp.X - center.X)
			local dy = (sp.Y - center.Y)
			local pull = 1 - math.clamp(S.Smoothing, 0, 0.95)
			Try(MouseMoveRel, dx * pull * 0.35, dy * pull * 0.35)
			return
		end

		local goal = CFrame.new(Camera.CFrame.Position, goalPos)
		if S.Smoothing <= 0.01 then
			Camera.CFrame = goal
		else
			-- V9 FIX: the old lerp used a fixed alpha, so the aim was twice as
			-- fast at 120 FPS as at 60 FPS. Now normalised against real delta
			-- time, giving identical feel on every machine.
			local dt = math.clamp(FrameDelta, 1 / 240, 1 / 15)
			local base = math.clamp(1 - S.Smoothing, 0.03, 1)
			local alpha = 1 - (1 - base) ^ (dt * 60)
			Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(alpha, 0.01, 1))
		end
	end

	--// ----------------------------------------------------------------------
	--// 7. ESP
	--// ----------------------------------------------------------------------

	local SKELETON_LINKS = {
		{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
		{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
		{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
		{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
		{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
	}

	local function NewDrawing(class, props)
		if not HasDrawing then
			return nil
		end
		local d = Drawing.new(class)
		for k, v in pairs(props or {}) do
			d[k] = v
		end
		d.Visible = false
		table.insert(Drawings, d)
		return d
	end

	local function CreateESP(plr)
		if plr == LocalPlayer or ESPObjects[plr] then
			return
		end

		local obj = {
			Box        = NewDrawing("Square", {Thickness = 1, Filled = false, Transparency = 1, Color = S.ESPEnemyColor}),
			BoxOutline = NewDrawing("Square", {Thickness = 3, Filled = false, Transparency = 0.5, Color = Color3.new(0, 0, 0)}),
			Name       = NewDrawing("Text",   {Size = 13, Center = true, Outline = true, Color = Color3.new(1, 1, 1)}),
			Info       = NewDrawing("Text",   {Size = 12, Center = true, Outline = true, Color = Color3.fromRGB(210, 210, 210)}),
			HealthBar  = NewDrawing("Line",   {Thickness = 3, Color = Color3.fromRGB(80, 230, 120)}),
			HealthBg   = NewDrawing("Line",   {Thickness = 3, Color = Color3.new(0, 0, 0), Transparency = 0.6}),
			Tracer     = NewDrawing("Line",   {Thickness = 1, Color = S.ESPEnemyColor, Transparency = 0.8}),
			Bones      = {},
			Highlight  = nil,
		}

		for i = 1, #SKELETON_LINKS do
			obj.Bones[i] = NewDrawing("Line", {Thickness = 1, Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7})
		end

		ESPObjects[plr] = obj
	end

	-- V9 PERF: this key list used to be re-allocated on every call, i.e. once
	-- per off-screen player per frame. Hoisted to a single shared constant.
	local ESP_HIDE_KEYS = {"Box", "BoxOutline", "Name", "Info", "HealthBar", "HealthBg", "Tracer"}

	local function HideESP(obj)
		if not obj then
			return
		end
		if obj.Hidden then
			return
		end
		for _, key in ipairs(ESP_HIDE_KEYS) do
			if obj[key] then
				obj[key].Visible = false
			end
		end
		for _, bone in ipairs(obj.Bones) do
			if bone then
				bone.Visible = false
			end
		end
		if obj.Highlight then
			obj.Highlight.Enabled = false
		end
		obj.Hidden = true
	end

	local function DestroyESP(plr)
		local obj = ESPObjects[plr]
		if not obj then
			return
		end
		for _, key in ipairs({"Box", "BoxOutline", "Name", "Info", "HealthBar", "HealthBg", "Tracer"}) do
			if obj[key] then
				Try(function() obj[key]:Remove() end)
			end
		end
		for _, bone in ipairs(obj.Bones) do
			if bone then
				Try(function() bone:Remove() end)
			end
		end
		if obj.Highlight then
			Try(function() obj.Highlight:Destroy() end)
		end
		ESPObjects[plr] = nil
	end

	local function ColorFor(plr)
		if not S.ESPTeamColor then
			return S.ESPEnemyColor
		end
		return TeamOk(plr) and S.ESPEnemyColor or S.ESPAllyColor
	end

	local function UpdateChams(plr, obj, enabled, color)
		local char = GetChar(plr)
		if not enabled or not char then
			if obj.Highlight then
				obj.Highlight.Enabled = false
			end
			return
		end
		if not obj.Highlight or obj.Highlight.Parent ~= char then
			if obj.Highlight then
				Try(function() obj.Highlight:Destroy() end)
			end
			local hl = Instance.new("Highlight")
			hl.Name = "KM_Cham"
			hl.FillTransparency = 0.62
			hl.OutlineTransparency = 0
			pcall(function()
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			end)
			hl.Parent = char
			obj.Highlight = hl
		end
		obj.Highlight.Enabled = true
		obj.Highlight.FillColor = color
		obj.Highlight.OutlineColor = color
	end

	local function UpdateESP()
		if not S.ESPEnabled then
			for _, obj in pairs(ESPObjects) do
				HideESP(obj)
			end
			return
		end

		local myRoot = MyRoot()
		local viewport = Camera.ViewportSize

		for plr, obj in pairs(ESPObjects) do
			local char = GetChar(plr)
			local root = GetRoot(plr)
			local hum  = GetHum(plr)

			if not char or not root or not hum or hum.Health <= 0 then
				HideESP(obj)
			else
				local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 0
				if dist > S.ESPMaxDistance then
					HideESP(obj)
				else
					local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
					if not onScreen then
						HideESP(obj)
					else
						obj.Hidden = false
						local color = ColorFor(plr)
						local headTop = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3.2, 0))
						local legBot  = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.6, 0))
						local height  = math.abs(headTop.Y - legBot.Y)
						local width   = height / 1.9
						local left    = rootPos.X - width / 2
						local top     = rootPos.Y - height / 2

						-- box
						if S.ESPBox and obj.Box then
							obj.BoxOutline.Size = Vector2.new(width, height)
							obj.BoxOutline.Position = Vector2.new(left, top)
							obj.BoxOutline.Visible = true
							obj.Box.Size = Vector2.new(width, height)
							obj.Box.Position = Vector2.new(left, top)
							obj.Box.Color = color
							obj.Box.Visible = true
						else
							if obj.Box then obj.Box.Visible = false end
							if obj.BoxOutline then obj.BoxOutline.Visible = false end
						end

						-- name
						if S.ESPName and obj.Name then
							obj.Name.Text = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
							obj.Name.Position = Vector2.new(rootPos.X, top - 16)
							obj.Name.Color = color
							obj.Name.Visible = true
						elseif obj.Name then
							obj.Name.Visible = false
						end

						-- distance + health text
						if S.ESPDistance and obj.Info then
							obj.Info.Text = string.format("%dm  |  %d hp", math.floor(dist), math.floor(hum.Health))
							obj.Info.Position = Vector2.new(rootPos.X, top + height + 2)
							obj.Info.Visible = true
						elseif obj.Info then
							obj.Info.Visible = false
						end

						-- health bar
						if S.ESPHealth and obj.HealthBar then
							local pct = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
							local barX = left - 6
							obj.HealthBg.From = Vector2.new(barX, top)
							obj.HealthBg.To = Vector2.new(barX, top + height)
							obj.HealthBg.Visible = true
							obj.HealthBar.From = Vector2.new(barX, top + height)
							obj.HealthBar.To = Vector2.new(barX, top + height - (height * pct))
							obj.HealthBar.Color = Color3.fromRGB(255 - math.floor(205 * pct), 60 + math.floor(170 * pct), 90)
							obj.HealthBar.Visible = true
						else
							if obj.HealthBar then obj.HealthBar.Visible = false end
							if obj.HealthBg then obj.HealthBg.Visible = false end
						end

						-- tracer
						if S.ESPTracer and obj.Tracer then
							obj.Tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
							obj.Tracer.To = Vector2.new(rootPos.X, top + height)
							obj.Tracer.Color = color
							obj.Tracer.Visible = true
						elseif obj.Tracer then
							obj.Tracer.Visible = false
						end

						-- skeleton
						if S.ESPSkeleton then
							for i, link in ipairs(SKELETON_LINKS) do
								local bone = obj.Bones[i]
								local a = char:FindFirstChild(link[1])
								local b = char:FindFirstChild(link[2])
								if bone and a and b then
									local pa, va = Camera:WorldToViewportPoint(a.Position)
									local pb, vb = Camera:WorldToViewportPoint(b.Position)
									if va and vb then
										bone.From = Vector2.new(pa.X, pa.Y)
										bone.To = Vector2.new(pb.X, pb.Y)
										bone.Color = color
										bone.Visible = true
									else
										bone.Visible = false
									end
								elseif bone then
									bone.Visible = false
								end
							end
						else
							for _, bone in ipairs(obj.Bones) do
								if bone then bone.Visible = false end
							end
						end

						UpdateChams(plr, obj, S.ESPChams, color)
					end
				end
			end
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		CreateESP(plr)
	end
	Bind(Players.PlayerAdded, CreateESP)
	Bind(Players.PlayerRemoving, DestroyESP)

	--// ----------------------------------------------------------------------
	--// 8. WEAPON MODULE (generic value patcher - works in most shooters)
	--// ----------------------------------------------------------------------

	local AMMO_NAMES  = {"Ammo", "AmmoCount", "CurrentAmmo", "Bullets", "Rounds", "Clip", "ClipAmmo", "MagAmmo", "StoredAmmo"}
	local MAX_NAMES   = {"MaxAmmo", "ClipSize", "MagSize", "MaxClip", "AmmoMax"}
	local RELOAD_NAMES = {"Reloading", "IsReloading", "Reload"}
	local RECOIL_NAMES = {"Recoil", "RecoilPower", "CameraRecoil", "Kick", "RecoilAmount"}
	local SPREAD_NAMES = {"Spread", "Bloom", "Inaccuracy", "SpreadAmount", "Accuracy"}
	local RATE_NAMES   = {"FireRate", "Firerate", "RPM", "ShootDelay", "Cooldown", "Delay"}

	local function InList(name, list)
		for _, n in ipairs(list) do
			if name == n then
				return true
			end
		end
		return false
	end

	local function ToolRoots()
		local out = {}
		local char = GetChar(LocalPlayer)
		if char then
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") then
					table.insert(out, t)
				end
			end
		end
		local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") then
					table.insert(out, t)
				end
			end
		end
		return out
	end

	local BaseRates = {}

	local function PatchWeapons()
		if not (S.UnlimitedAmmo or S.NoReload or S.NoRecoil or S.NoSpread or S.FastFire) then
			return
		end
		for _, tool in ipairs(ToolRoots()) do
			for _, v in ipairs(tool:GetDescendants()) do
				local cls = v.ClassName
				if cls == "NumberValue" or cls == "IntValue" then
					if S.UnlimitedAmmo and InList(v.Name, AMMO_NAMES) then
						Try(function() v.Value = 9999 end)
					elseif S.UnlimitedAmmo and InList(v.Name, MAX_NAMES) then
						Try(function() v.Value = 9999 end)
					elseif S.NoRecoil and InList(v.Name, RECOIL_NAMES) then
						Try(function() v.Value = 0 end)
					elseif S.NoSpread and InList(v.Name, SPREAD_NAMES) then
						Try(function() v.Value = 0 end)
					elseif S.FastFire and InList(v.Name, RATE_NAMES) then
						if BaseRates[v] == nil then
							BaseRates[v] = v.Value
						end
						Try(function() v.Value = math.max(0.01, BaseRates[v] * S.FireRateScale) end)
					end
				elseif cls == "BoolValue" then
					if S.NoReload and InList(v.Name, RELOAD_NAMES) then
						Try(function() v.Value = false end)
					end
				elseif cls == "ModuleScript" then
					-- most weapon configs live in a settings module; try the common
					-- "Settings"/"Config" table shape without breaking anything
					if S.NoRecoil or S.NoSpread or S.UnlimitedAmmo then
						Try(function()
							local cfg = require(v)
							if type(cfg) == "table" then
								if S.NoRecoil then
									if cfg.Recoil ~= nil then cfg.Recoil = 0 end
									if cfg.CameraRecoil ~= nil then cfg.CameraRecoil = 0 end
								end
								if S.NoSpread then
									if cfg.Spread ~= nil then cfg.Spread = 0 end
									if cfg.Bloom ~= nil then cfg.Bloom = 0 end
								end
								if S.UnlimitedAmmo then
									if cfg.Ammo ~= nil then cfg.Ammo = 9999 end
									if cfg.MaxAmmo ~= nil then cfg.MaxAmmo = 9999 end
									if cfg.StoredAmmo ~= nil then cfg.StoredAmmo = 9999 end
								end
							end
						end)
					end
				end
			end
		end
	end

	local function RestoreRates()
		for v, base in pairs(BaseRates) do
			Try(function()
				if v and v.Parent then
					v.Value = base
				end
			end)
		end
		BaseRates = {}
	end

	--// ----------------------------------------------------------------------
	--// 9. PLAYER MODULE
	--// ----------------------------------------------------------------------

	local FlyVelocity, FlyGyro
	local OriginalHitboxSizes = {}

	local function StopFly()
		if FlyVelocity then Try(function() FlyVelocity:Destroy() end) end
		if FlyGyro then Try(function() FlyGyro:Destroy() end) end
		FlyVelocity, FlyGyro = nil, nil
	end

	local function StartFly()
		StopFly()
		local root = MyRoot()
		if not root then
			return
		end
		FlyVelocity = Instance.new("BodyVelocity")
		FlyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		FlyVelocity.Velocity = Vector3.new()
		FlyVelocity.Parent = root

		FlyGyro = Instance.new("BodyGyro")
		FlyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		FlyGyro.P = 9000
		FlyGyro.CFrame = Camera.CFrame
		FlyGyro.Parent = root
	end

	local function FlyStep()
		if not S.Flying or not FlyVelocity or not FlyGyro then
			return
		end
		local dir = Vector3.new()
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end

		-- mobile: fly forward while the humanoid has a move direction
		local hum = GetHum(LocalPlayer)
		if dir.Magnitude == 0 and hum and hum.MoveDirection.Magnitude > 0 then
			dir = hum.MoveDirection
		end

		FlyGyro.CFrame = Camera.CFrame
		FlyVelocity.Velocity = (dir.Magnitude > 0 and dir.Unit or Vector3.new()) * S.FlySpeed
	end

	-- V9 PERF: the old version walked every descendant of the character on
	-- EVERY rendered frame. We now cache the BasePart list and only rebuild
	-- it when the character changes or a part is added/removed.
	local NoClipChar, NoClipParts, NoClipDirty = nil, {}, true
	local NoClipConns = {}

	local function RebuildNoClipCache(char)
		for _, c in ipairs(NoClipConns) do
			pcall(function() c:Disconnect() end)
		end
		NoClipConns = {}
		NoClipParts = {}
		if not char then
			return
		end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				table.insert(NoClipParts, part)
			end
		end
		table.insert(NoClipConns, char.DescendantAdded:Connect(function()
			NoClipDirty = true
		end))
		table.insert(NoClipConns, char.DescendantRemoving:Connect(function()
			NoClipDirty = true
		end))
		NoClipDirty = false
	end

	local function ApplyNoClip()
		if not S.NoClip then
			return
		end
		local char = GetChar(LocalPlayer)
		if not char then
			return
		end
		if char ~= NoClipChar or NoClipDirty then
			NoClipChar = char
			RebuildNoClipCache(char)
		end
		for i = #NoClipParts, 1, -1 do
			local part = NoClipParts[i]
			if not part or not part.Parent then
				table.remove(NoClipParts, i)
			elseif part.CanCollide then
				part.CanCollide = false
			end
		end
	end

	local function ApplyHitbox()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local char = GetChar(plr)
				local head = char and char:FindFirstChild("Head")
				if head then
					if S.HitboxExpand then
						if OriginalHitboxSizes[head] == nil then
							OriginalHitboxSizes[head] = head.Size
						end
						Try(function()
							head.Size = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
							head.Transparency = 0.65
							head.CanCollide = false
							head.Massless = true
						end)
					elseif OriginalHitboxSizes[head] then
						Try(function()
							head.Size = OriginalHitboxSizes[head]
							head.Transparency = 0
						end)
						OriginalHitboxSizes[head] = nil
					end
				end
			end
		end
	end

	local function ApplyMovement()
		local hum = GetHum(LocalPlayer)
		if not hum then
			return
		end
		if S.CustomSpeed then
			hum.WalkSpeed = S.WalkSpeed
		end
		if S.CustomJump then
			if hum.UseJumpPower ~= nil then
				hum.UseJumpPower = true
			end
			hum.JumpPower = S.JumpPower
		end
	end

	--// ----------------------------------------------------------------------
	--// 10. WORLD MODULE
	--// ----------------------------------------------------------------------

	local WorldBackup = {
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		GlobalShadows = Lighting.GlobalShadows,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
	}

	local XRayBackup = {}
	local XRayConn = nil

	-- V9 FIX: fog/atmosphere and FPS-boost changes were never recorded, so
	-- turning those features back off left the game permanently altered.
	-- Everything is now backed up and fully restorable.
	local AtmoBackup = {}
	local FPSBackup = { Parts = {}, Decals = {}, Effects = {}, Post = {}, Quality = nil }
	local FPSConn = nil
	local BrightConn = nil

	local function ApplyFullBright(on)
		Try(function()
			if on then
				Lighting.Brightness = 3
				Lighting.ClockTime = 14
				Lighting.GlobalShadows = false
				Lighting.Ambient = Color3.fromRGB(178, 178, 178)
				Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
				-- V9 FIX: many games run a day/night cycle that stomped these
				-- values a second later. Re-assert them whenever ClockTime moves.
				if not BrightConn then
					BrightConn = Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
						if S.FullBright and not Unloading then
							Try(function()
								Lighting.ClockTime = 14
								Lighting.Brightness = 3
								Lighting.GlobalShadows = false
							end)
						end
					end)
				end
			else
				if BrightConn then
					Try(function() BrightConn:Disconnect() end)
					BrightConn = nil
				end
				Lighting.Brightness = WorldBackup.Brightness
				Lighting.ClockTime = WorldBackup.ClockTime
				Lighting.GlobalShadows = WorldBackup.GlobalShadows
				Lighting.Ambient = WorldBackup.Ambient
				Lighting.OutdoorAmbient = WorldBackup.OutdoorAmbient
			end
		end)
	end

	local function ApplyNoFog(on)
		Try(function()
			if on then
				Lighting.FogEnd = 1e6
				Lighting.FogStart = 1e6
				for _, v in ipairs(Lighting:GetDescendants()) do
					if v:IsA("Atmosphere") then
						if AtmoBackup[v] == nil then
							AtmoBackup[v] = { Density = v.Density, Haze = v.Haze }
						end
						v.Density = 0
						v.Haze = 0
					end
				end
			else
				Lighting.FogEnd = WorldBackup.FogEnd
				Lighting.FogStart = WorldBackup.FogStart
				-- V9 FIX: restore every Atmosphere we zeroed out
				for atmo, saved in pairs(AtmoBackup) do
					if atmo and atmo.Parent then
						Try(function()
							atmo.Density = saved.Density
							atmo.Haze = saved.Haze
						end)
					end
				end
				AtmoBackup = {}
			end
		end)
	end

	local function XRayPart(v)
		if not v:IsA("BasePart") then
			return
		end
		local char = GetChar(LocalPlayer)
		if char and v:IsDescendantOf(char) then
			return
		end
		if v.Parent and Players:GetPlayerFromCharacter(v.Parent) then
			return
		end
		if XRayBackup[v] == nil and v.Transparency < 1 then
			XRayBackup[v] = v.Transparency
			v.Transparency = 0.72
		end
	end

	local function ApplyXRay(on)
		Try(function()
			if on then
				for _, v in ipairs(workspace:GetDescendants()) do
					XRayPart(v)
				end
				-- V9 FIX: streamed-in / newly spawned parts stayed solid.
				if not XRayConn then
					XRayConn = workspace.DescendantAdded:Connect(function(v)
						if S.XRay and not Unloading then
							task.defer(function()
								Try(function() XRayPart(v) end)
							end)
						end
					end)
				end
			else
				if XRayConn then
					Try(function() XRayConn:Disconnect() end)
					XRayConn = nil
				end
				for part, t in pairs(XRayBackup) do
					if part and part.Parent then
						Try(function() part.Transparency = t end)
					end
				end
				XRayBackup = {}
			end
		end)
	end

	local function FPSStripPart(v)
		if v:IsA("BasePart") then
			if FPSBackup.Parts[v] == nil then
				FPSBackup.Parts[v] = { Material = v.Material, Reflectance = v.Reflectance }
			end
			v.Material = Enum.Material.SmoothPlastic
			v.Reflectance = 0
		elseif v:IsA("Decal") or v:IsA("Texture") then
			if FPSBackup.Decals[v] == nil then
				FPSBackup.Decals[v] = v.Transparency
			end
			v.Transparency = 1
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke")
			or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") then
			if FPSBackup.Effects[v] == nil then
				FPSBackup.Effects[v] = v.Enabled
			end
			v.Enabled = false
		end
	end

	-- V9 FIX: FPS Boost used to be a one-way trip. It is now a real toggle
	-- that records every property it touches and puts them all back.
	local function ApplyFPSBoost(on)
		Try(function()
			if on then
				for _, v in ipairs(workspace:GetDescendants()) do
					Try(function() FPSStripPart(v) end)
				end
				for _, v in ipairs(Lighting:GetDescendants()) do
					if v:IsA("BlurEffect") or v:IsA("SunRaysEffect")
						or v:IsA("DepthOfFieldEffect") or v:IsA("BloomEffect") then
						if FPSBackup.Post[v] == nil then
							FPSBackup.Post[v] = v.Enabled
						end
						v.Enabled = false
					end
				end
				Try(function()
					if FPSBackup.Quality == nil then
						FPSBackup.Quality = settings().Rendering.QualityLevel
					end
					settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
				end)
				-- keep newly streamed geometry stripped too
				if not FPSConn then
					FPSConn = workspace.DescendantAdded:Connect(function(v)
						if S.FPSBoost and not Unloading then
							task.defer(function()
								Try(function() FPSStripPart(v) end)
							end)
						end
					end)
				end
			else
				if FPSConn then
					Try(function() FPSConn:Disconnect() end)
					FPSConn = nil
				end
				for part, saved in pairs(FPSBackup.Parts) do
					if part and part.Parent then
						Try(function()
							part.Material = saved.Material
							part.Reflectance = saved.Reflectance
						end)
					end
				end
				for d, t in pairs(FPSBackup.Decals) do
					if d and d.Parent then
						Try(function() d.Transparency = t end)
					end
				end
				for e, en in pairs(FPSBackup.Effects) do
					if e and e.Parent then
						Try(function() e.Enabled = en end)
					end
				end
				for e, en in pairs(FPSBackup.Post) do
					if e and e.Parent then
						Try(function() e.Enabled = en end)
					end
				end
				if FPSBackup.Quality then
					Try(function() settings().Rendering.QualityLevel = FPSBackup.Quality end)
				end
				FPSBackup = { Parts = {}, Decals = {}, Effects = {}, Post = {}, Quality = nil }
			end
		end)
	end

	--// ----------------------------------------------------------------------
	--// 11. MAIN LOOPS (exactly three, all guarded)
	--// ----------------------------------------------------------------------

	local lastTrigger = 0

	-- V9 PERF: frame budget for the ESP.
	--   Drawing updates are by far the heaviest part of the loop, so they run
	--   on their own interval instead of every single frame. 60 Hz of aimbot
	--   with 30 Hz of ESP feels identical but roughly halves the cost.
	local ESP_INTERVAL = 1 / 30
	local lastESP = 0

	Bind(RunService.RenderStepped, function(dt)
		if Unloading then
			return
		end
		FrameDelta = (type(dt) == "number" and dt > 0) and dt or (1 / 60)
		Camera = workspace.CurrentCamera or Camera

		UpdateFOVCircle()

		-- aimbot
		if S.AimEnabled and AimKeyDown() then
			local target = AcquireTarget()
			if target then
				local part = PartFor(target)
				AimAt(part)
				if S.StayBehind then
					local myRoot, theirRoot = MyRoot(), GetRoot(target)
					if myRoot and theirRoot then
						myRoot.CFrame = theirRoot.CFrame * CFrame.new(0, 0, S.StayBehindOffset)
					end
				end
			end
		else
			if not S.StickyAim then
				CurrentTarget = nil
			end
		end

		-- triggerbot
		if S.TriggerBot and Mouse1Press and Mouse1Release and os.clock() - lastTrigger > S.TriggerDelay then
			local hitPlr = nil
			local target = Mouse.Target
			if target then
				local model = target:FindFirstAncestorOfClass("Model")
				hitPlr = model and Players:GetPlayerFromCharacter(model)
			end
			if hitPlr and ShouldTarget(hitPlr) then
				lastTrigger = os.clock()
				task.spawn(function()
					Try(Mouse1Press)
					task.wait(S.TriggerHoldTime)
					Try(Mouse1Release)
				end)
			end
		end

		-- esp (throttled - see ESP_INTERVAL above)
		local now = os.clock()
		if now - lastESP >= ESP_INTERVAL then
			lastESP = now
			UpdateESP()
		end

		-- fly / noclip / spinbot
		if S.Flying then
			FlyStep()
		end
		if S.NoClip then
			ApplyNoClip()
		end
		if S.Spinbot then
			local root = MyRoot()
			if root then
				root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad((tick() * 900) % 360), 0)
			end
		end
	end)

	-- V9 PERF: staggered housekeeping.
	--   PatchWeapons require()s ModuleScripts and was the single worst
	--   offender at 4x/second. Hitbox and movement stay responsive at
	--   ~3x/second; weapons are re-patched once per second, and every
	--   job is skipped outright when its feature is off.
	task.spawn(function()
		local tickCount = 0
		while not Unloading do
			tickCount = tickCount + 1

			if S.HitboxExpand or next(OriginalHitboxSizes) ~= nil then
				Try(ApplyHitbox)
			end

			Try(ApplyMovement)

			-- weapons only every 3rd pass (~1s)
			if tickCount % 3 == 0 then
				if S.UnlimitedAmmo or S.NoReload or S.NoRecoil or S.NoSpread or S.FastFire then
					Try(PatchWeapons)
				end
			end

			task.wait(0.33)
		end
	end)

	-- infinite jump
	Bind(UIS.JumpRequest, function()
		if S.InfiniteJump and not Unloading then
			local hum = GetHum(LocalPlayer)
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)

	-- aim key (toggle mode) + snap on fire
	Bind(UIS.InputBegan, function(input, gp)
		if gp or Unloading then
			return
		end
		if input.KeyCode == S.AimKey and not S.AimKeyHold then
			S.AimActive = not S.AimActive
			Notify("Aimbot", S.AimActive and "Aim locked ON" or "Aim locked OFF", S.AimActive and "Success" or "Info", 1.4)
		end
		if S.SnapOnFire and input.UserInputType == Enum.UserInputType.MouseButton1 and S.AimEnabled then
			local target = AcquireTarget()
			if target then
				local part = PartFor(target)
				if part then
					Camera.CFrame = CFrame.new(Camera.CFrame.Position, PredictedPosition(part))
				end
			end
		end
		if input.UserInputType == Enum.UserInputType.Touch and S.AimEnabled and S.AimKeyHold then
			S.AimActive = true
		end
	end)

	Bind(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.Touch and S.AimKeyHold then
			S.AimActive = false
		end
	end)

	-- anti-AFK
	Bind(LocalPlayer.Idled, function()
		if not S.AntiAFK or Unloading then
			return
		end
		Try(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end)

	-- V9 FIX: respawn housekeeping used to only restore fly + movement, so
	-- speed/jump came back but noclip, hitbox, X-Ray, full-bright and the FOV
	-- override silently died after every death. All of it is re-applied now.
	Bind(LocalPlayer.CharacterAdded, function(char)
		task.wait(1)
		if Unloading then
			return
		end

		-- force the noclip cache to rebuild against the new character
		NoClipChar, NoClipDirty = nil, true

		if S.Flying then
			StartFly()
		end
		ApplyMovement()

		if S.FullBright then
			ApplyFullBright(true)
		end
		if S.NoFog then
			ApplyNoFog(true)
		end
		if S.XRay then
			ApplyXRay(true)
		end
		Try(function()
			if S.CameraFOV and S.CameraFOV ~= 70 then
				Camera = workspace.CurrentCamera or Camera
				Camera.FieldOfView = S.CameraFOV
			end
		end)
	end)

