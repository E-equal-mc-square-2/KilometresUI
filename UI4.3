				BackgroundTransparency = Theme().SurfaceTransparency,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = tonumber(subOpts.Order) or (#Data.SubTabs + 1),
				ZIndex = 37,
			})
			Corner(Btn, 999)
			do
				local st = Stroke(Btn, Theme().Stroke, 1)
				st.Transparency = 0.45
			end
			New("UIPadding", {Parent = Btn, PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)})
			New("UIListLayout", {
				Parent = Btn,
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 5),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			})

			local BtnIcon
			if subIcon then
				BtnIcon = MakeIconNode(Btn, subIcon, 13, Theme().TextDim, 38, 1)
				if BtnIcon and BtnIcon:IsA("TextLabel") then
					BtnIcon.AutomaticSize = Enum.AutomaticSize.X
					BtnIcon.Size = UDim2.new(0, 0, 1, 0)
					BtnIcon.TextSize = 12
				end
			end

			local BtnLabel = New("TextLabel", {
				Parent = Btn,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
				Text = name,
				TextColor3 = Theme().TextDim,
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				LayoutOrder = 2,
				ZIndex = 38,
			})

			local SubPage = New("ScrollingFrame", {
				Parent = SubHost,
				Visible = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				CanvasSize = UDim2.fromOffset(0, 0),
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ScrollBarThickness = 4,
				ZIndex = 35,
			})
			New("UIPadding", {Parent = SubPage, PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)})
			New("UIListLayout", {Parent = SubPage, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder})

			SubData.Button = Btn
			SubData.Label = BtnLabel
			SubData.Icon = BtnIcon
			SubData.Page = SubPage
			table.insert(Data.SubTabs, SubData)

			local BtnScale = New("UIScale", {Parent = Btn, Scale = 1})

			function SubData.Activate()
				for _, st in ipairs(Data.SubTabs) do
					st.Active = false
					st.Page.Visible = false
					Tween(st.Button, {BackgroundColor3 = Theme().Surface, BackgroundTransparency = Theme().SurfaceTransparency}, 0.14)
					Tween(st.Label, {TextColor3 = Theme().TextDim}, 0.14)
					if st.Icon then
						SetIconColor(st.Icon, Theme().TextDim)
					end
				end
				SubData.Active = true
				SubPage.Visible = true
				Tween(Btn, {BackgroundColor3 = Theme().Accent, BackgroundTransparency = 0.08}, 0.14)
				Tween(BtnLabel, {TextColor3 = Color3.new(1, 1, 1)}, 0.14)
				if BtnIcon then
					SetIconColor(BtnIcon, Color3.new(1, 1, 1))
				end
				BtnScale.Scale = 0.94
				Tween(BtnScale, {Scale = 1}, 0.16, Enum.EasingStyle.Back)
				Data.ActiveSubTab = SubData
			end

			Btn.MouseButton1Click:Connect(SubData.Activate)
			Btn.MouseEnter:Connect(function()
				if not SubData.Active then
					Tween(Btn, {BackgroundColor3 = ColorLerp(Theme().Surface, Theme().Accent, 0.25)}, 0.12)
				end
			end)
			Btn.MouseLeave:Connect(function()
				if not SubData.Active then
					Tween(Btn, {BackgroundColor3 = Theme().Surface}, 0.14)
				end
			end)

			AddRefresher(function()
				Btn.BackgroundColor3 = SubData.Active and Theme().Accent or Theme().Surface
				Btn.BackgroundTransparency = SubData.Active and 0.08 or Theme().SurfaceTransparency
				BtnLabel.TextColor3 = SubData.Active and Color3.new(1, 1, 1) or Theme().TextDim
				if BtnIcon then
					SetIconColor(BtnIcon, SubData.Active and Color3.new(1, 1, 1) or Theme().TextDim)
				end
				Stroke(Btn, Theme().Stroke, 1)
			end)

			-- first sub-tab opens by default
			if #Data.SubTabs == 1 then
				SubData.Activate()
			end

			local SubTab = {}
			function SubTab:CreateSection(title)
				return MakeSection(SubPage, title)
			end
			SubTab.Page = SubPage
			SubTab.Activate = SubData.Activate
			return SubTab
		end

		return setmetatable(Tab, {__index = function(_, k)
			return Data[k]
		end})
	end

