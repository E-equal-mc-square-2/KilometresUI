	aim = "\u{25CE}", eye = "\u{25C7}", weapon = "\u{2316}", player = "\u{2617}",
	teleport = "\u{27A4}", spark = "\u{2726}", ai = "AI", home = "\u{25A6}",
	layers = "\u{2261}", palette = "\u{25D0}", window = "\u{25A1}", save = "S",
	folder = "L", download = "D", trash = "C", copy = "\u{29C9}", play = "\u{25B6}",
	help = "?", plus = "+", shuffle = "\u{21C4}", next = "\u{203A}", prev = "\u{2039}",
	power = "\u{23FB}", warning = "!", keyboard = "K", image = "W", send = "\u{27A4}",
	stop = "\u{25A0}", check = "\u{2713}", info = "i", gauge = "G", wand = "\u{2727}",
	target = "\u{25CE}", shield = "\u{26E8}", zap = "\u{26A1}", map = "\u{25C9}",
	music = "\u{266B}", vinyl = "\u{25C9}", key = "\u{26B7}",
