			Parent = panel,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			Text = titleText,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 85,
		})
		AddRefresher(function()
			panel.BackgroundColor3 = Theme().Surface2
			panel.BackgroundTransparency = Theme().Surface2Transparency
			header.TextColor3 = Theme().Text
			Stroke(panel, Theme().Stroke, 1)
		end)
		return panel
	end

	local ThemePanel     = MakePanel("Appearance", 1)
	local WallpaperPanel = MakePanel("Wallpaper (UIBG)", 2)
	local LayoutPanel    = MakePanel("Layout", 3)
	local GeminiPanel    = MakePanel("Gemini AI", 4)
	local MiscPanel      = MakePanel("Options", 5)

	------------------------------------------------------------------
	-- FLOATING RESTORE ORB (draggable, clamped, pulsing)
	------------------------------------------------------------------

	local Orb = New("TextButton", {
		Parent = Screen,
		Visible = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(64, 64),
		Size = UDim2.fromOffset(54, 54),
		BackgroundColor3 = Theme().Accent,
		BorderSizePixel = 0,
		Text = "UI",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
		ZIndex = 999,
	})
	Corner(Orb, 999)
	Gradient(Orb, ColorLerp(Theme().Accent, Color3.new(1, 1, 1), 0.25), ColorLerp(Theme().Accent, Color3.new(0, 0, 0), 0.25), 90)
	Glow(Screen, Orb, Theme().Accent, 16, 0.45)
	local OrbScale = New("UIScale", {Parent = Orb, Scale = 1})

	-- V9.5: the minimised orb wears Charlotte's face instead of the "UI" text.
	-- The PNG is already circular (baked alpha), so it drops straight onto the
	-- round button. If the executor has no filesystem we silently keep the text.
	local OrbFace do
		local asset = IconAsset("charlotte")
		if asset then
			Orb.Text = ""
			OrbFace = New("ImageLabel", {
				Parent = Orb,
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1, -4, 1, -4),
				Image = asset,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 1000,
			})
			Corner(OrbFace, 999)
		end
	end

	local OrbCenter = {X = 64, Y = 64}

	local function ClampOrb()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		OrbCenter.X = Clamp(OrbCenter.X, 36, math.max(36, vp.X - 36))
		OrbCenter.Y = Clamp(OrbCenter.Y, 36, math.max(36, vp.Y - 36))
		Orb.Position = UDim2.fromOffset(OrbCenter.X, OrbCenter.Y)
	end

	-- place orb bottom-right on first use
	do
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		OrbCenter.X = math.max(64, vp.X - 64)
		OrbCenter.Y = math.max(64, vp.Y - 64)
		ClampOrb()
	end

	do
		local dragging = false
		local dragInput, dragStart, startX, startY

		Orb.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				Tween(OrbScale, {Scale = 0.9}, 0.08)
				dragging = true
				dragStart = input.Position
				startX, startY = OrbCenter.X, OrbCenter.Y
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						Tween(OrbScale, {Scale = 1}, 0.12)
					end
				end)
			end
		end)

		Orb.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		AddConn(UIS.InputChanged:Connect(function(input)
			if input == dragInput and dragging and dragStart and Orb.Visible then
				local delta = input.Position - dragStart
				OrbCenter.X = (startX or 0) + delta.X
				OrbCenter.Y = (startY or 0) + delta.Y
				ClampOrb()
			end
		end))

		-- idle pulse (loop exits on destroy, no RenderStepped used)
		task.spawn(function()
			while Orb and Orb.Parent and not State.Destroyed do
				if Orb.Visible and not dragging then
					Tween(OrbScale, {Scale = 1.05}, 0.7)
					task.wait(0.7)
					if Orb and Orb.Parent and Orb.Visible and not dragging and not State.Destroyed then
						Tween(OrbScale, {Scale = 0.98}, 0.7)
						task.wait(0.7)
					end
				else
					task.wait(0.2)
				end
			end
		end)
	end

	------------------------------------------------------------------
	-- DRAGGING (safe-edge clamp, mouse + touch)
	------------------------------------------------------------------

	ClampOffsets = function()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local ew, eh = EffectiveSize()
		local shownH = State.Minimized and 58 or eh
		local margin = 8
		local maxX = math.floor((vp.X - ew) / 2 - margin)
		local maxY = math.floor((vp.Y - shownH) / 2 - margin)
		maxX = math.max(0, maxX)
		maxY = math.max(0, maxY)
		State.OffsetX = Clamp(State.OffsetX, -maxX, maxX)
		State.OffsetY = Clamp(State.OffsetY, -maxY, maxY)
		Main.Position = UDim2.new(0.5, State.OffsetX, 0.5, State.OffsetY)
	end

	do
		local dragging = false
		local dragInput, dragStart, startOffsetX, startOffsetY

		Topbar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startOffsetX = State.OffsetX
				startOffsetY = State.OffsetY
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						Persist()
					end
				end)
			end
		end)

		Topbar.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and input == dragInput and dragStart then
				local delta = input.Position - dragStart
				State.OffsetX = (startOffsetX or 0) + delta.X
				State.OffsetY = (startOffsetY or 0) + delta.Y
				ClampOffsets()
			end
		end))
	end

	-- resize grip logic
	do
		local resizing = false
		local resizeInput, resizeStart, startW, startH

		ResizeGrip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				startW, startH = State.Width, State.Height
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						Persist()
					end
				end)
			end
		end)

		ResizeGrip.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				resizeInput = input
			end
		end)

		AddConn(UIS.InputChanged:Connect(function(input)
			if resizing and input == resizeInput and resizeStart then
				local delta = input.Position - resizeStart
				State.Width = Clamp(math.floor(startW + delta.X), 340, 1400)
				State.Height = Clamp(math.floor(startH + delta.Y), 260, 900)
				if WidthSlider then WidthSlider.Set(State.Width, true) end
				if HeightSlider then HeightSlider.Set(State.Height, true) end
				if UpdateLayout then UpdateLayout() end
			end
		end))
	end

	------------------------------------------------------------------
	-- WINDOW STATE FUNCTIONS
	------------------------------------------------------------------

	SetHidden = function(hidden)
		State.Hidden = hidden and true or false
		if State.Hidden then
			Tween(MainScale, {Scale = 0.94 * State.UIScale}, 0.15)
			task.delay(0.14, function()
				if State.Hidden then
					Main.Visible = false
				end
			end)
			SettingsOverlay.Visible = false
			if ApplyBlur and State.Blur then
				ApplyBlur(true)
			end
			Orb.Visible = true
			ClampOrb()
			Tween(OrbScale, {Scale = 0}, 0.01)
			Tween(OrbScale, {Scale = 1}, 0.3, Enum.EasingStyle.Back)
		else
			Main.Visible = true
			Orb.Visible = false
			if State.Minimized then
				State.Minimized = false
				if UpdateLayout then UpdateLayout() end
			end
			Tween(MainScale, {Scale = State.UIScale}, 0.22, Enum.EasingStyle.Back)
			PageHolder.Visible = not SettingsOverlay.Visible
			if not SettingsOverlay.Visible then
				TabBar.Visible = true
			end
			ClampOffsets()
		end
	end

	SetMinimized = function(flag)
		if State.Hidden then
			return
		end
		State.Minimized = flag and true or false
		local ew = EffectiveSize()
		if State.Minimized then
			TabBar.Visible = false
			PageHolder.Visible = false
			SettingsOverlay.Visible = false
			ResizeGrip.Visible = false
			local s = {Size = UDim2.fromOffset(ew, 58)}
			Tween(Main, s, 0.22)
			task.delay(0.23, ClampOffsets)
		else
			ResizeGrip.Visible = true
			Tween(Main, {Size = UDim2.fromOffset(EffectiveSize())}, 0.22)
			task.delay(0.06, function()
				if UpdateLayout then UpdateLayout() end
			end)
		end
	end

	SetTheme = function(name)
		if not Themes[name] then
			name = "Default"
		end
		State.ThemeName = name
		RefreshAll()
		-- animated transitions on the structural surfaces
		local T = Theme()
		Tween(Main, {BackgroundColor3 = T.Background, BackgroundTransparency = T.BackgroundTransparency}, 0.28)
		Tween(TabBar, {BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency}, 0.28)
		Tween(TabIndicator, {BackgroundColor3 = T.Accent}, 0.28)
		if UIBGWash then
			Tween(UIBGWash, {BackgroundColor3 = T.Accent}, 0.28)
		end
		Tween(SettingsPanel, {BackgroundColor3 = T.Surface, BackgroundTransparency = T.SurfaceTransparency}, 0.28)
		Tween(Orb, {BackgroundColor3 = T.Accent}, 0.28)
		Persist()
	end

	UpdateLayout = function()
		if State.Minimized then
			ClampOffsets()
			return
		end
		local ew, eh = EffectiveSize()
		Main.Size = UDim2.fromOffset(ew, eh)
		ClampOffsets()
		local portrait = IsPortrait()
		TabBar.Visible = not SettingsOverlay.Visible

		local barHeight = portrait and 44 or 46
		TabBar.Position = UDim2.new(0, 12, 0, 60)
		TabBar.Size = UDim2.new(1, -24, 0, barHeight)

		PageHolder.Position = UDim2.new(0, 12, 0, 60 + barHeight + 8)
		PageHolder.Size = UDim2.new(1, -24, 1, -(60 + barHeight + 18))

		if SyncTabIndicator then
			task.defer(function()
				pcall(SyncTabIndicator, false)
			end)
		end
	end

	AddConn(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		Camera = workspace.CurrentCamera or Camera
		if Camera then
			AddConn(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				if not State.Destroyed then
					pcall(UpdateLayout)
					pcall(ClampOrb)
				end
			end))
			pcall(UpdateLayout)
			pcall(ClampOrb)
		end
	end))

	if Camera then
		AddConn(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if not State.Destroyed then
				pcall(UpdateLayout)
				pcall(ClampOrb)
			end
		end))
	end

	------------------------------------------------------------------
	-- ELEMENT CREATORS
	------------------------------------------------------------------

	local function WrapInstance(api, inst)
		api.__KMUI = true
		return setmetatable(api, {
			__index = inst,
			__newindex = function(_, k, v)
				inst[k] = v
			end,
		})
	end

	--// Element methods accept BOTH V5 dot-calls (obj.Set(v)) and
	--// colon-calls (obj:Set(v)) so old scripts and new both work.
	local function Dual(fn)
		return function(a, b, c)
			if type(a) == "table" and rawget(a, "__KMUI") == true then
				return fn(b, c)
			end
			return fn(a, b)
		end
	end

	-- BUTTON v2: hover, press, disabled state, optional icon
	local function CreateButton(parent, text, callback, opts)
		opts = opts or {}
		local enabled = true
		local icon = opts.Icon and tostring(opts.Icon) or nil

		local btn = New("TextButton", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 90,
		})
		Corner(btn, 14)
		do
			local s = Stroke(btn, Theme().Stroke, 1)
			s.Transparency = 0.35
		end
		New("UIGradient", {
			Parent = btn,
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.02),
				NumberSequenceKeypoint.new(1, 0.16),
			}),
		})
		local bscale = New("UIScale", {Parent = btn, Scale = 1})

		local iconLbl
		if icon then
			iconLbl = MakeIconNode(btn, icon, 18, Theme().Accent, 91)
			if iconLbl then
				iconLbl.AnchorPoint = Vector2.new(0, 0.5)
				iconLbl.Position = UDim2.new(0, 13, 0.5, 0)
				if iconLbl:IsA("TextLabel") then
					iconLbl.Size = UDim2.new(0, 24, 1, 0)
					iconLbl.TextSize = 15
				end
			end
		end

		local lbl = New("TextLabel", {
			Parent = btn,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(icon and 40 or 14, 0),
			Size = UDim2.new(1, (icon and -52 or -28), 1, 0),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = opts.Align or Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local hovered = false
		local function RestColor()
			if not enabled then
				return ColorLerp(Theme().Surface2, Theme().Background, 0.35)
			end
			if hovered then
				return ColorLerp(Theme().Surface2, Theme().Accent, 0.18)
			end
			return Theme().Surface2
		end

		local function Render()
			Tween(btn, {BackgroundColor3 = RestColor()}, 0.15)
			lbl.TextTransparency = enabled and 0 or 0.55
			if iconLbl then
				if iconLbl:IsA("ImageLabel") then
					iconLbl.ImageTransparency = enabled and 0 or 0.55
				else
					iconLbl.TextTransparency = enabled and 0 or 0.55
				end
			end
		end

		btn.MouseEnter:Connect(function()
			hovered = true
			Render()
		end)
		btn.MouseLeave:Connect(function()
			hovered = false
			Tween(bscale, {Scale = 1}, 0.12)
			Render()
		end)
		btn.MouseButton1Down:Connect(function()
			if enabled then
				Tween(bscale, {Scale = 0.97}, 0.08)
			end
		end)
		btn.MouseButton1Up:Connect(function()
			Tween(bscale, {Scale = 1}, 0.12)
		end)

		btn.MouseButton1Click:Connect(function()
			if not enabled then
				return
			end
			local T = Theme()
			Tween(btn, {BackgroundColor3 = T.Accent}, 0.07)
			task.delay(0.09, function()
				if btn and btn.Parent then
					Tween(btn, {BackgroundColor3 = RestColor()}, 0.16)
				end
			end)
			SafeCall(callback)
		end)

		AddRefresher(function()
			btn.BackgroundColor3 = RestColor()
			btn.BackgroundTransparency = Theme().Surface2Transparency
			lbl.TextColor3 = Theme().Text
			if iconLbl then
				SetIconColor(iconLbl, Theme().Accent)
			end
			Stroke(btn, Theme().Stroke, 1)
		end)

		local api = {Instance = btn}
		api.SetEnabled = Dual(function(v)
			enabled = v and true or false
			btn.Active = enabled
			Render()
		end)
		api.IsEnabled = Dual(function()
			return enabled
		end)
		api.SetText = Dual(function(t)
			lbl.Text = tostring(t)
		end)
		api.GetText = Dual(function()
			return lbl.Text
		end)
		return WrapInstance(api, btn)
	end

	-- TOGGLE
	local function CreateToggle(parent, text, default, callback)
		local value = default and true or false

		local toggle = New("TextButton", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 50),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 90,
		})
		Corner(toggle, 14)
		Stroke(toggle, Theme().Stroke, 1)

		local label = New("TextLabel", {
			Parent = toggle,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -90, 1, 0),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local switch = New("Frame", {
			Parent = toggle,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(50, 24),
			BackgroundColor3 = value and Theme().Accent or Color3.fromRGB(60, 60, 70),
			BorderSizePixel = 0,
			ZIndex = 92,
		})
		Corner(switch, 999)
		New("UIGradient", {
			Parent = switch,
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.05),
				NumberSequenceKeypoint.new(1, 0.25),
			}),
		})

		local knob = New("Frame", {
			Parent = switch,
			Size = UDim2.fromOffset(18, 18),
			Position = value and UDim2.fromOffset(28, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 93,
		})
		Corner(knob, 999)

		local function Render()
			if value then
				Tween(switch, {BackgroundColor3 = Theme().Accent}, 0.15)
				Tween(knob, {Position = UDim2.fromOffset(28, 3)}, 0.15)
			else
				Tween(switch, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}, 0.15)
				Tween(knob, {Position = UDim2.fromOffset(3, 3)}, 0.15)
			end
		end

		toggle.MouseButton1Click:Connect(function()
			value = not value
			Render()
			SafeCall(callback, value)
			Persist()
		end)

		AddRefresher(function()
			toggle.BackgroundColor3 = Theme().Surface2
			toggle.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			switch.BackgroundColor3 = value and Theme().Accent or Color3.fromRGB(60, 60, 70)
			Stroke(toggle, Theme().Stroke, 1)
		end)

		Render()

		local api = {Instance = toggle}
		api.Set = Dual(function(v, silent)
			value = v and true or false
			Render()
			if not silent then
				SafeCall(callback, value)
			end
		end)
		api.Get = Dual(function()
			return value
		end)
		return WrapInstance(api, toggle)
	end

	-- SLIDER: min / max / default / increment / callback
	local function CreateSlider(parent, text, min, max, default, callback, step)
		min = tonumber(min) or 0
		max = tonumber(max) or 100
		step = tonumber(step) or 1
		local value = Clamp(tonumber(default) or min, min, max)

		local slider = New("Frame", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 64),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			ZIndex = 90,
		})
		Corner(slider, 14)
		Stroke(slider, Theme().Stroke, 1)

		local label = New("TextLabel", {
			Parent = slider,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -110, 0, 16),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local valueLabel = New("TextLabel", {
			Parent = slider,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 8),
			Size = UDim2.fromOffset(88, 16),
			Text = FormatNumber(value, step),
			TextColor3 = Theme().TextDim,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 91,
		})

		local bar = New("Frame", {
			Parent = slider,
			Position = UDim2.fromOffset(14, 38),
			Size = UDim2.new(1, -28, 0, 8),
			BackgroundColor3 = Color3.fromRGB(45, 45, 55),
			BorderSizePixel = 0,
			ZIndex = 91,
		})
		Corner(bar, 999)

		local fill = New("Frame", {
			Parent = bar,
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Theme().Accent,
			BorderSizePixel = 0,
			ZIndex = 92,
		})
		Corner(fill, 999)
		New("UIGradient", {
			Parent = fill,
			Rotation = 0,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(1, 0),
			}),
		})

		local knob = New("Frame", {
			Parent = bar,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 93,
		})
		Corner(knob, 999)

		local dragging = false

		local function SetValue(v, silent)
			v = Clamp(tonumber(v) or min, min, max)
			if step and step > 0 then
				v = math.floor((v / step) + 0.5) * step
			end
			v = Clamp(v, min, max)
			value = v
			valueLabel.Text = FormatNumber(value, step)
			local pct = (value - min) / math.max(1e-9, max - min)
			Tween(fill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.08)
			Tween(knob, {Position = UDim2.new(pct, 0, 0.5, 0)}, 0.08)
			if not silent then
				SafeCall(callback, value)
			end
		end

		local function UpdateFromInput(input)
			local rel = (input.Position.X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X)
			SetValue(min + (max - min) * Clamp(rel, 0, 1))
		end

		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				UpdateFromInput(input)
			end
		end)

		AddConn(UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				if dragging then
					dragging = false
					Persist()
				end
			end
		end))

		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				UpdateFromInput(input)
			end
		end))

		AddRefresher(function()
			slider.BackgroundColor3 = Theme().Surface2
			slider.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			valueLabel.TextColor3 = Theme().TextDim
			fill.BackgroundColor3 = Theme().Accent
			Stroke(slider, Theme().Stroke, 1)
		end)

		SetValue(value, true)

		local api = {Instance = slider, Frame = slider}
		api.Set = Dual(function(v, silent)
			SetValue(v, silent)
		end)
		api.Get = Dual(function()
			return value
		end)
		return WrapInstance(api, slider)
	end

	-- INPUT (Textbox v2): placeholder, default text, clear button, blur save
	local function CreateInput(parent, text, a2, a3, a4)
		local placeholder, defaultText, callback, clearable, onBlur = "", "", nil, true, true
		if type(a2) == "table" then
			local o = a2
			placeholder = o.Placeholder or ""
			defaultText = o.Default or o.Text or ""
			callback = o.Callback
			if o.Clear ~= nil then clearable = o.Clear and true or false end
			if o.OnBlur ~= nil then onBlur = o.OnBlur and true or false end
		else
			placeholder = tostring(a2 or "")
			if type(a3) == "function" then
				callback = a3
			else
				defaultText = tostring(a3 or "")
				callback = a4
			end
		end

		local wrap = New("Frame", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 68),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			ZIndex = 90,
		})
		Corner(wrap, 14)
		Stroke(wrap, Theme().Stroke, 1)

		local label = New("TextLabel", {
			Parent = wrap,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -28, 0, 16),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local box = New("TextBox", {
			Parent = wrap,
			Position = UDim2.fromOffset(14, 30),
			Size = UDim2.new(1, clearable and -54 or -28, 0, 26),
			BackgroundColor3 = Theme().Background,
			BackgroundTransparency = Theme().BackgroundTransparency,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Text = tostring(defaultText or ""),
			PlaceholderText = placeholder,
			TextColor3 = Theme().Text,
			PlaceholderColor3 = Theme().TextDim,
			TextSize = 13,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClipsDescendants = true,
			ZIndex = 91,
		})
		Corner(box, 8)
		Stroke(box, Theme().Stroke, 1)
		New("UIPadding", {Parent = box, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)})

		local clearBtn
		if clearable then
			clearBtn = New("TextButton", {
				Parent = wrap,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 30),
				Size = UDim2.fromOffset(26, 26),
				BackgroundColor3 = Theme().Background,
				BackgroundTransparency = Theme().BackgroundTransparency,
				BorderSizePixel = 0,
				Text = "×",
				TextSize = 14,
				Font = Enum.Font.GothamBold,
				TextColor3 = Theme().TextDim,
				AutoButtonColor = false,
				ZIndex = 91,
			})
			Corner(clearBtn, 8)
			Stroke(clearBtn, Theme().Stroke, 1)
		end

		local function Commit(enterPressed)
			if (enterPressed or onBlur) and callback then
				SafeCall(callback, box.Text)
				Persist()
			end
		end

		box.FocusLost:Connect(Commit)

		if clearBtn then
			clearBtn.MouseButton1Click:Connect(function()
				box.Text = ""
				SafeCall(callback, "")
				Persist()
			end)
		end

		AddRefresher(function()
			wrap.BackgroundColor3 = Theme().Surface2
			wrap.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			box.BackgroundColor3 = Theme().Background
			box.BackgroundTransparency = Theme().BackgroundTransparency
			box.TextColor3 = Theme().Text
			box.PlaceholderColor3 = Theme().TextDim
			if clearBtn then
				clearBtn.BackgroundColor3 = Theme().Background
				clearBtn.BackgroundTransparency = Theme().BackgroundTransparency
				clearBtn.TextColor3 = Theme().TextDim
				Stroke(clearBtn, Theme().Stroke, 1)
			end
			Stroke(wrap, Theme().Stroke, 1)
			Stroke(box, Theme().Stroke, 1)
		end)

		local api = {Instance = wrap, Box = box}
		api.Get = Dual(function()
			return box.Text
		end)
		api.Set = Dual(function(v)
			box.Text = tostring(v or "")
		end)
		api.Clear = Dual(function()
			box.Text = ""
		end)
		return WrapInstance(api, wrap), box
	end

	-- DROPDOWN: real list, dynamic options, current selection
	local function CreateDropdown(parent, text, options, default, callback)
		options = options or {}
		local selected = default or options[1]
		local opened = false

		local Holder = New("Frame", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 50),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			ZIndex = 90,
		})
		Corner(Holder, 14)
		Stroke(Holder, Theme().Stroke, 1)

		local Label = New("TextLabel", {
			Parent = Holder,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -165, 1, 0),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local Value = New("TextLabel", {
			Parent = Holder,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -34, 0.5, 0),
			Size = UDim2.fromOffset(120, 20),
			Text = Truncate(tostring(selected or ""), 18),
			TextColor3 = Theme().TextDim,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 91,
		})

		-- V9.1 FIX: the "▾" glyph is missing from several executor font
		-- atlases and rendered as an empty tofu box.  Drawn as vectors now,
		-- and it flips up while the list is open.
		local Caret = Chevron(Holder, 12, Theme().TextDim, "down", 91)
		Caret.Holder.AnchorPoint = Vector2.new(1, 0.5)
		Caret.Holder.Position = UDim2.new(1, -14, 0.5, 0)

		local ClickArea = New("TextButton", {
			Parent = Holder,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			ZIndex = 92,
		})

		local Drop = New("Frame", {
			Parent = Holder,
			Position = UDim2.new(0, 0, 1, 6),
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = Theme().Surface,
			BackgroundTransparency = math.max(Theme().SurfaceTransparency, 0.05),
			BorderSizePixel = 0,
			Visible = false,
			ClipsDescendants = true,
			ZIndex = 200,
		})
		Corner(Drop, 12)
		Stroke(Drop, Theme().Stroke, 1)

		local List = New("ScrollingFrame", {
			Parent = Drop,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.fromOffset(0, 0),
			ZIndex = 201,
		})
		New("UIListLayout", {Parent = List, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder})
		New("UIPadding", {Parent = List, PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)})

		local function ToggleDrop(state)
			opened = state and true or false
			Caret:SetDirection(opened and "up" or "down", true)
			if opened then
				local sizeY = math.min(#options * 38 + 12, 210)
				Drop.Visible = true
				Tween(Drop, {Size = UDim2.new(1, 0, 0, sizeY)}, 0.18)
			else
				Tween(Drop, {Size = UDim2.new(1, 0, 0, 0)}, 0.14)
				task.delay(0.15, function()
					if not opened and Drop and Drop.Parent then
						Drop.Visible = false
					end
				end)
			end
		end

		local OptionButtons = {}

		local function BuildOptions(list)
			for _, b in ipairs(OptionButtons) do
				b:Destroy()
			end
			OptionButtons = {}
			for _, option in ipairs(list) do
				local Btn = New("TextButton", {
					Parent = List,
					Size = UDim2.new(1, 0, 0, 32),
					BackgroundColor3 = Theme().Surface2,
					BackgroundTransparency = Theme().Surface2Transparency,
					BorderSizePixel = 0,
					Text = tostring(option),
					TextColor3 = Theme().Text,
					TextSize = 13,
					Font = Enum.Font.Gotham,
					AutoButtonColor = false,
					ZIndex = 202,
				})
				Corner(Btn, 8)
				table.insert(OptionButtons, Btn)
				Btn.MouseButton1Click:Connect(function()
					selected = option
					Value.Text = Truncate(tostring(option), 18)
					ToggleDrop(false)
					SafeCall(callback, option)
					Persist()
				end)
			end
		end

		BuildOptions(options)

		ClickArea.MouseButton1Click:Connect(function()
			ToggleDrop(not opened)
		end)

		AddRefresher(function()
			Holder.BackgroundColor3 = Theme().Surface2
			Holder.BackgroundTransparency = Theme().Surface2Transparency
			Label.TextColor3 = Theme().Text
			Value.TextColor3 = Theme().TextDim
			Caret:SetColor(Theme().TextDim)
			Drop.BackgroundColor3 = Theme().Surface
			Drop.BackgroundTransparency = math.max(Theme().SurfaceTransparency, 0.05)
			for _, b in ipairs(OptionButtons) do
				b.BackgroundColor3 = Theme().Surface2
				b.BackgroundTransparency = Theme().Surface2Transparency
				b.TextColor3 = Theme().Text
			end
			Stroke(Holder, Theme().Stroke, 1)
			Stroke(Drop, Theme().Stroke, 1)
		end)

		local api = {Instance = Holder, Frame = Holder}
		api.Get = Dual(function()
			return selected
		end)
		api.Set = Dual(function(v, silent)
			selected = v
			Value.Text = Truncate(tostring(v), 18)
			if not silent then
				SafeCall(callback, v)
			end
		end)
		api.Refresh = Dual(function(newOptions, keepSelection)
			if type(newOptions) == "table" then
				options = newOptions
				BuildOptions(options)
				local found = false
				if keepSelection then
					for _, o in ipairs(options) do
						if o == selected then
							found = true
							break
						end
					end
				end
				if not found then
					selected = options[1]
					Value.Text = Truncate(tostring(selected or ""), 18)
				end
			end
		end)
		--// alias so scripts can do drop.SetOptions({...}) as well
		api.SetOptions = api.Refresh
		api.Options = Dual(function()
			return options
		end)
		return WrapInstance(api, Holder)
	end

	-- KEYBIND: click, press any key, rebind, callback
	local function CreateKeybind(parent, text, defaultKey, callback)
		local value = Enum.KeyCode.RightShift
		if typeof(defaultKey) == "EnumItem" then
			value = defaultKey
		elseif type(defaultKey) == "string" and Enum.KeyCode[defaultKey] then
			value = Enum.KeyCode[defaultKey]
		end
		local listening = false

		local row = New("Frame", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 50),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			ZIndex = 90,
		})
		Corner(row, 14)
		Stroke(row, Theme().Stroke, 1)

		local label = New("TextLabel", {
			Parent = row,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -140, 1, 0),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local keyBtn = New("TextButton", {
			Parent = row,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(112, 30),
			BackgroundColor3 = Theme().Background,
			BackgroundTransparency = Theme().BackgroundTransparency,
			BorderSizePixel = 0,
			Text = value.Name,
			TextColor3 = Theme().TextDim,
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			ZIndex = 91,
		})
		Corner(keyBtn, 8)
		Stroke(keyBtn, Theme().Stroke, 1)

		local function SetValue(v, silent)
			if typeof(v) == "EnumItem" then
				value = v
			elseif type(v) == "string" and Enum.KeyCode[v] then
				value = Enum.KeyCode[v]
			end
			keyBtn.Text = value.Name
			if not silent then
				SafeCall(callback, value)
			end
		end

		keyBtn.MouseButton1Click:Connect(function()
			listening = true
			keyBtn.Text = "..."
			keyBtn.TextColor3 = Theme().Accent
		end)

		AddConn(UIS.InputBegan:Connect(function(input, gp)
			if not listening then
				return
			end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = false
				keyBtn.Text = value.Name
				keyBtn.TextColor3 = Theme().TextDim
				return
			end
			listening = false
			keyBtn.TextColor3 = Theme().TextDim
			SetValue(input.KeyCode)
			Persist()
		end))

		AddRefresher(function()
			row.BackgroundColor3 = Theme().Surface2
			row.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			keyBtn.BackgroundColor3 = Theme().Background
			keyBtn.BackgroundTransparency = Theme().BackgroundTransparency
			if not listening then
				keyBtn.TextColor3 = Theme().TextDim
			end
			Stroke(row, Theme().Stroke, 1)
			Stroke(keyBtn, Theme().Stroke, 1)
		end)

		local api = {Instance = row}
		api.Get = Dual(function()
			return value
		end)
		api.Set = Dual(function(v, silent)
			SetValue(v, silent)
		end)
		return WrapInstance(api, row)
	end

	-- COLORPICKER: RGB sliders + hex + preview + callback
	local function CreateColorPicker(parent, text, defaultColor, callback)
		local color = defaultColor or Color3.fromRGB(130, 110, 255)
		local expanded = false

		local row = New("Frame", {
			Parent = parent,
			Size = UDim2.new(1, 0, 0, 50),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 90,
		})
		Corner(row, 14)
		Stroke(row, Theme().Stroke, 1)
		New("UIListLayout", {Parent = row, Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder})

		local topRow = New("Frame", {
			Parent = row,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 50),
			ZIndex = 91,
		})

		local label = New("TextLabel", {
			Parent = topRow,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -150, 1, 0),
			Text = text,
			TextColor3 = Theme().Text,
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 91,
		})

		local hexLbl = New("TextLabel", {
			Parent = topRow,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -56, 0.5, 0),
			Size = UDim2.fromOffset(70, 18),
			Text = Color3ToHex(color),
			TextColor3 = Theme().TextDim,
			TextSize = 11,
			Font = Enum.Font.Code,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 91,
		})

		local swatch = New("TextButton", {
			Parent = topRow,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(34, 24),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 91,
		})
		Corner(swatch, 7)
		Stroke(swatch, Theme().Stroke, 1)

		local panel = New("Frame", {
			Parent = row,
			BackgroundTransparency = 1,
			Visible = false,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 91,
		})
		New("UIListLayout", {Parent = panel, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder})
		New("UIPadding", {Parent = panel, PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingBottom = UDim.new(0, 10)})

		local suppress = false

		local function ApplyColor(c, silent)
			color = c
			swatch.BackgroundColor3 = c
			hexLbl.Text = Color3ToHex(c)
			if not silent then
				SafeCall(callback, c)
			end
			Persist()
		end

		local function ChannelValue(ch)
			if ch == "R" then return math.floor(color.R * 255 + 0.5) end
			if ch == "G" then return math.floor(color.G * 255 + 0.5) end
			return math.floor(color.B * 255 + 0.5)
		end

		local function MakeChannel(ch)
			return CreateSlider(panel, ch, 0, 255, ChannelValue(ch), function(v)
				if suppress then
					return
				end
				local r = ChannelValue("R")
				local g = ChannelValue("G")
				local b = ChannelValue("B")
				if ch == "R" then r = v elseif ch == "G" then g = v else b = v end
				ApplyColor(Color3.fromRGB(r, g, b))
			end, 1)
		end

		local slR = MakeChannel("R")
		local slG = MakeChannel("G")
		local slB = MakeChannel("B")

		local hexInput = CreateInput(panel, "Hex", {
			Placeholder = "#RRGGBB",
			Default = Color3ToHex(color),
			Clear = false,
			OnBlur = false,
			Callback = function(txt)
				local c = HexToColor3(txt)
				if c then
					suppress = true
					slR.Set(math.floor(c.R * 255 + 0.5), true)
					slG.Set(math.floor(c.G * 255 + 0.5), true)
					slB.Set(math.floor(c.B * 255 + 0.5), true)
					suppress = false
					ApplyColor(c)
				else
					Notify("ColorPicker", "Invalid hex color. Use #RRGGBB.", 2.4, "Warning")
				end
			end,
		})

		local function Toggle(state)
			expanded = state and true or false
			panel.Visible = expanded
		end

		swatch.MouseButton1Click:Connect(function()
			Toggle(not expanded)
		end)

		local topClick = New("TextButton", {
			Parent = topRow,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -60, 1, 0),
			Text = "",
			ZIndex = 90,
		})
		topClick.MouseButton1Click:Connect(function()
			Toggle(not expanded)
		end)

		AddRefresher(function()
			row.BackgroundColor3 = Theme().Surface2
			row.BackgroundTransparency = Theme().Surface2Transparency
			label.TextColor3 = Theme().Text
			hexLbl.TextColor3 = Theme().TextDim
			Stroke(row, Theme().Stroke, 1)
			Stroke(swatch, Theme().Stroke, 1)
		end)

		local api = {Instance = row}
		api.Get = Dual(function()
			return color
		end)
		api.Set = Dual(function(c, silent)
			if typeof(c) == "Color3" then
				suppress = true
				slR.Set(math.floor(c.R * 255 + 0.5), true)
				slG.Set(math.floor(c.G * 255 + 0.5), true)
				slB.Set(math.floor(c.B * 255 + 0.5), true)
				suppress = false
				hexInput.Set(Color3ToHex(c))
				ApplyColor(c, silent)
			end
		end)
		return WrapInstance(api, row)
	end

