	------------------------------------------------------------------
	-- PLAYBACK ENGINE
	------------------------------------------------------------------

	local function FormatTime(t)
		t = math.max(0, math.floor(tonumber(t) or 0))
		return string.format("%d:%02d", math.floor(t / 60), t % 60)
	end

	local RenderLibrary   -- forward: PlayIndex refreshes the row highlight
	local UpdateTransport

	--// V9.3: every request gets a ticket, so a slow download that
	--// finishes after the user already skipped is simply dropped.
	local LoadTicket = 0

	local function ApplySound(song, autoStart)
		local asset, isLocal = SongAsset(song)
		if not asset then
			ArtistLabel.Text = "download failed - try another track"
			MusicState.Playing = false
			if UpdateTransport then UpdateTransport() end
			return
		end
		pcall(function()
			Sound:Stop()
			Sound.TimePosition = 0
			Sound.SoundId = asset
			Sound.Volume = MusicState.Volume
			Sound.PlaybackSpeed = MusicState.Speed
		end)
		ArtistLabel.Text = ((song.Artist ~= "" and song.Artist) or "unknown artist")
			.. (isLocal and "  ·  local file" or "")
		if autoStart ~= false then
			pcall(function() Sound:Play() end)
			MusicState.Playing = true
		else
			MusicState.Playing = false
		end
		if UpdateTransport then UpdateTransport() end
		if RenderLibrary then RenderLibrary() end
	end

	local function PlayIndex(index, autoStart)
		if #Playlist == 0 then
			return
		end
		index = ((index - 1) % #Playlist) + 1
		CurrentIndex = index
		local song = Playlist[index]
		if not song then
			return
		end

		LoadTicket = LoadTicket + 1
		local myTicket = LoadTicket

		TrackLabel.Text = song.Name
		ArtistLabel.Text = (song.Artist ~= "" and song.Artist) or "unknown artist"
		OrbTrackName.Text = song.Name

		--// already on the device, or no filesystem at all: play now
		if not FileSystemOK or song.Url == "" or SongCached(song) then
			ApplySound(song, autoStart)
			return
		end

		--// first time we hear this one: pull the mp3 into snd/ on a
		--// worker thread so the UI never freezes.
		pcall(function() Sound:Stop() end)
		MusicState.Playing = false
		ArtistLabel.Text = "downloading..."
		if UpdateTransport then UpdateTransport() end
		if RenderLibrary then RenderLibrary() end

		task.spawn(function()
			local ok = CacheSong(song)
			if myTicket ~= LoadTicket then
				return  --// user moved on; this download is stale
			end
			if not ok then
				--// keep the rbxassetid fallback alive if the row has one
				if tostring(song.Id):gsub("%D", "") ~= "" then
					ApplySound(song, autoStart)
				else
					ArtistLabel.Text = "download failed - try another track"
					if UpdateTransport then UpdateTransport() end
				end
				return
			end
			ApplySound(song, autoStart)
		end)
	end

	local function TogglePlay()
		if #Playlist == 0 then
			return
		end
		if CurrentIndex == 0 then
			PlayIndex(1, true)
			return
		end
		if MusicState.Playing then
			pcall(function() Sound:Pause() end)
			MusicState.Playing = false
		else
			if Sound.SoundId == "" then
				PlayIndex(CurrentIndex, true)
				return
			end
			pcall(function() Sound:Resume() end)
			MusicState.Playing = true
		end
		if UpdateTransport then UpdateTransport() end
	end

	local function StepTrack(delta)
		if #Playlist == 0 then
			return
		end
		if Shuffle and #Playlist > 1 then
			local pick = CurrentIndex
			for _ = 1, 8 do
				pick = math.random(1, #Playlist)
				if pick ~= CurrentIndex then break end
			end
			PlayIndex(pick, true)
		else
			PlayIndex((CurrentIndex == 0 and 1 or CurrentIndex) + delta, true)
		end
	end

	-- these are what the orb buttons call: exactly the same engine
	MusicHooks.Next = function() StepTrack(1) end
	MusicHooks.Prev = function() StepTrack(-1) end
