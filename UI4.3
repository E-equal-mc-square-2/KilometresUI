	local cacheInfo = CreateInfo(WallpaperPanel, "img/ cache: checking...")
	local function RefreshCacheInfo()
		if not FileSystemOK then
			cacheInfo.Text = "This executor cannot write files - using Roblox asset ids."
			return
		end
		cacheInfo.Text = string.format("img/ cache: %d of %d wallpapers stored on device.", CachedCount(), #WALLPAPERS)
	end
	RefreshCacheInfo()
	UIBGRefs.RefreshCache = RefreshCacheInfo

	CreateButton(WallpaperPanel, "Download All Wallpapers To img/", function()
		if not FileSystemOK then
			Notify("UIBG", "This executor has no writefile/getcustomasset.", 3, "Warning")
			return
		end
		Notify("UIBG", "Downloading 20 wallpapers into img/ ...", 2.5, "Info")
		task.spawn(function()
			EnsureImgFolder()
			local done, failed = 0, 0
			for i, wp in ipairs(WALLPAPERS) do
				if State.Destroyed then
					return
				end
				if CacheWallpaper(wp) then
					done = done + 1
					if UIBGRefs.SetCellImage then
						UIBGRefs.SetCellImage(i)
					end
				else
					failed = failed + 1
				end
				cacheInfo.Text = string.format("Downloading... %d/%d (%d failed)", done, #WALLPAPERS, failed)
				task.wait(0.05)
			end
			RefreshCacheInfo()
			ApplyWallpaper(true)
			Notify("UIBG", string.format("img/ ready - %d saved, %d failed.", done, failed), 3, done > 0 and "Success" or "Error")
		end)
	end, {Icon = "download"})

