------------------------------------------------------------------
-- V9.1: MUSIC PLAYER  ·  ITS OWN FLOATING WINDOW
--   Same treatment as Charlotte: private ScreenGui, draggable,
--   resizable, scale-linked to the global UI-scale slider.
--   Minimising collapses it into a SPINNING VINYL ORB that carries
--   real prev / play / next buttons - they drive the same engine as
--   the full window, nothing is decorative.
--   Built by a top-level factory so it owns its own function scope:
--   CreateWindow spends exactly one local on it, which keeps that
--   function under Luau's 200-local ceiling.
------------------------------------------------------------------

local function BuildMusicPlayer(env)
	-- Everything the window needs from CreateWindow's scope arrives in `env`,
	-- so this whole player lives in its own function scope and costs the
	-- window exactly one local (Luau caps a function at 200).
	local Theme        = env.Theme
	local State        = env.State
	local AddConn      = env.AddConn
	local AddRefresher = env.AddRefresher
	local Notify       = env.Notify
	local SaveFile     = env.SaveFile

	local SoundService = game:GetService("SoundService")
	local RunService   = game:GetService("RunService")

	local MusicHooks = {}
	local MUSIC_FILE = (SaveFile:match("^(.*)/[^/]+$") or "KilometresUIX") .. "/music.json"

	------------------------------------------------------------------
	-- PLAYLIST MODEL
	------------------------------------------------------------------

	local Playlist = {}       -- { {Name=..., Artist=..., Id=...} }
	local Filtered = {}       -- search view (array of indices into Playlist)
	local CurrentIndex = 0
	local SearchQuery = ""
	local Shuffle = false
	local RepeatMode = "all"  -- "all" | "one" | "off"

	local function BuildDefaultPlaylist()
		local out = {}
		for _, row in ipairs(MUSIC_LIBRARY) do
			--// {Name, Artist, Genre, Url, FallbackId}
			table.insert(out, {
				Name   = row[1],
				Artist = row[2],
				Genre  = row[3] or "",
				Url    = row[4] or "",
				Id     = tostring(row[5] or ""),
			})
		end
		return out
	end

	local function SavePlaylist()
		local json = SafeJSONEncode({Version = "V9.3", Songs = Playlist})
		if json then
			TryWriteFile(MUSIC_FILE, json)
		end
	end

	local function LoadPlaylist()
		local raw = TryReadFile(MUSIC_FILE)
		local data = raw and SafeJSONDecode(raw)
		if data and type(data.Songs) == "table" and #data.Songs > 0 then
			Playlist = {}
			for _, s in ipairs(data.Songs) do
				--// a row is usable when it has EITHER a url or an id
				if type(s) == "table" and (s.Url or s.Id) then
					table.insert(Playlist, {
						Name   = tostring(s.Name or "Untitled"),
						Artist = tostring(s.Artist or ""),
						Genre  = tostring(s.Genre or ""),
						Url    = tostring(s.Url or ""),
						Id     = tostring(s.Id or ""),
					})
				end
			end
		end
		--// a playlist saved by V9.1/V9.2 has ids only; the V9.3 library is
		--// url-based, so a legacy file is upgraded instead of kept.
		if data and data.Version ~= "V9.3" and #Playlist > 0 then
			local hasUrl = false
			for _, s in ipairs(Playlist) do
				if s.Url ~= "" then hasUrl = true break end
			end
			if not hasUrl then
				Playlist = {}
			end
		end
		if #Playlist == 0 then
			Playlist = BuildDefaultPlaylist()
			SavePlaylist()
		end
	end

	LoadPlaylist()

	------------------------------------------------------------------
	-- AUDIO ENGINE  (one Sound instance, reused for every track)
	------------------------------------------------------------------

	local Sound = New("Sound", {
		Parent = SoundService,
		Name = "KM_MusicPlayer",
		Volume = 0.5,
		PlaybackSpeed = 1,
		Looped = false,
	})

	local MusicState = {
		Playing = false,
		Volume = 0.5,
		Speed = 1,
		Seeking = false,
	}

	------------------------------------------------------------------
	-- WINDOW CHROME
	------------------------------------------------------------------

	local MScreen = New("ScreenGui", {
		Name = "KilometresMusic",
		Parent = SafeParent(),
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 11,
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
	})

	local MState = {
		Width = 620,
		Height = 400,
		OffsetX = -70,
		OffsetY = 40,
		Open = false,
		Minimized = false,
		OrbX = 0,
		OrbY = 0,
	}

	local MWindow = New("Frame", {
		Parent = MScreen,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, MState.OffsetX, 0.5, MState.OffsetY),
		Size = UDim2.fromOffset(MState.Width, MState.Height),
		BackgroundColor3 = Theme().Background,
		BackgroundTransparency = Theme().BackgroundTransparency,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 1,
	})
	Corner(MWindow, WINDOW_RADIUS)
	do
		local st = Stroke(MWindow, Theme().Accent, 1.4)
		st.Transparency = 0.35
	end
	Shadow(MScreen, MWindow, 24, 0.5)

	local MScale = New("UIScale", {Parent = MWindow, Scale = State.UIScale})

	local MBar = New("Frame", {
		Parent = MWindow,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		ZIndex = 60,
	})

	local MTitle = New("TextLabel", {
		Parent = MBar,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -120, 0, 16),
		Text = "MUSIC",
		TextColor3 = Theme().Text,
		TextSize = 15,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 61,
	})
	Gradient(MTitle, Color3.new(1, 1, 1), Theme().Accent, 25)

	local MSub = New("TextLabel", {
		Parent = MBar,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 22),
		Size = UDim2.new(1, -120, 0, 13),
		Text = "vinyl player",
		TextColor3 = Theme().TextDim,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 61,
	})

	local MBarButtons = {}

	local function MBarButton(xOffset, iconName, size, hoverKey)
		local btn = New("TextButton", {
			Parent = MBar,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0, 20),
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = math.max(0.08, Theme().Surface2Transparency),
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 62,
		})
		local ic = MakeIconNode(btn, iconName, size or 14, Theme().Text, 63)
		if ic then
			ic.AnchorPoint = Vector2.new(0.5, 0.5)
			ic.Position = UDim2.fromScale(0.5, 0.5)
		end
		Corner(btn, 999)
		local st = Stroke(btn, Theme().Stroke, 1)
		st.Transparency = 0.3
		btn.MouseEnter:Connect(function()
			Tween(btn, {BackgroundColor3 = (hoverKey == "error" and Theme().Error) or Theme().Accent, BackgroundTransparency = 0.05}, 0.14)
		end)
		btn.MouseLeave:Connect(function()
			Tween(btn, {BackgroundColor3 = Theme().Surface2, BackgroundTransparency = math.max(0.08, Theme().Surface2Transparency)}, 0.16)
		end)
		MBarButtons[btn] = ic
		return btn
	end

	local MMinButton   = MBarButton(-42, "minimize", 14)
	local MCloseButton = MBarButton(-12, "close", 13, "error")

	local MRule = New("Frame", {
		Parent = MWindow,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		Size = UDim2.new(1, -28, 0, 1),
		BackgroundColor3 = Theme().Accent,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ZIndex = 61,
	})

	local MPage = New("Frame", {
		Parent = MWindow,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 48),
		Size = UDim2.new(1, -24, 1, -58),
		ZIndex = 35,
	})

	local MGrip = New("TextButton", {
		Parent = MWindow,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -5, 1, -5),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 90,
	})
	local MGripMarks = GripPips(MGrip, Theme().TextDim, 91)

	------------------------------------------------------------------
	-- LEFT COLUMN  ·  THE VINYL RECORD
	------------------------------------------------------------------

	local DiscHost = New("Frame", {
		Parent = MPage,
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.new(0.36, -6, 1, 0),
		ZIndex = 36,
	})

	local DiscBox = New("Frame", {
		Parent = DiscHost,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(140, 140),
		BackgroundTransparency = 1,
		ZIndex = 36,
	})

	-- the spinning part is a child so the label under it never rotates
	local Disc = New("Frame", {
		Parent = DiscBox,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(16, 16, 20),
		BorderSizePixel = 0,
		ZIndex = 37,
	})
	Corner(Disc, 999)
	do
		local st = Stroke(Disc, Theme().Accent, 1.5)
		st.Transparency = 0.45
	end

	-- concentric grooves
	local DiscGrooves = {}
	for i = 1, 4 do
		local inset = 10 + (i - 1) * 11
		local g = New("Frame", {
			Parent = Disc,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -inset * 2, 1, -inset * 2),
			BackgroundTransparency = 1,
			ZIndex = 38,
		})
		Corner(g, 999)
		local gs = Stroke(g, Color3.fromRGB(70, 70, 80), 1)
		gs.Transparency = 0.45 + i * 0.06
		DiscGrooves[i] = gs
	end

	-- a bright wedge so the rotation is actually visible
	local DiscSheen = New("Frame", {
		Parent = Disc,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		ZIndex = 38,
	})
	Corner(DiscSheen, 999)
	New("UIGradient", {
		Parent = DiscSheen,
		Rotation = 30,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0.00, 1),
			NumberSequenceKeypoint.new(0.44, 1),
			NumberSequenceKeypoint.new(0.50, 0.25),
			NumberSequenceKeypoint.new(0.56, 1),
			NumberSequenceKeypoint.new(1.00, 1),
		}),
	})

	-- accent label at the centre of the record
	local DiscHub = New("Frame", {
		Parent = Disc,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.38, 0.38),
		BackgroundColor3 = Theme().Accent,
		BorderSizePixel = 0,
		ZIndex = 39,
	})
	Corner(DiscHub, 999)
	Gradient(DiscHub, Theme().Accent, ColorLerp(Theme().Accent, Color3.new(0, 0, 0), 0.45), 45)

	-- the spindle hole
	local DiscHole = New("Frame", {
		Parent = Disc,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.fromRGB(10, 10, 12),
		BorderSizePixel = 0,
		ZIndex = 40,
	})
	Corner(DiscHole, 999)

	local NowLabel = New("TextLabel", {
		Parent = DiscHost,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 152),
		Size = UDim2.new(1, 0, 0, 12),
