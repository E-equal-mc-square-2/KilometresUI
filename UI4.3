	--// kind = "user" | "model" | "error" | "system"
	local function AddBubble(kind, text, stamp, animate)
		local T = Theme()
		local isUser = (kind == "user")
		local isError = (kind == "error")
		local isSystem = (kind == "system")

		local row = New("Frame", {
			Parent = ChatScroll,
