				Parent = row,
				BackgroundColor3 = T.Surface2,
				BackgroundTransparency = 0.45,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				RichText = true,
				Text = " ",
				TextColor3 = T.TextDim,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextWrapped = true,
				ZIndex = 53,
			})
