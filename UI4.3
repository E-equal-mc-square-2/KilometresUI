		PrevGlyph:SetColor(T.Text)
		NextGlyph:SetColor(T.Text)
		OrbPrevGlyph:SetColor(T.Text)
		OrbNextGlyph:SetColor(T.Text)
		OrbOpenChevron:SetColor(T.Text)
		for btn, primary in pairs(OrbButtons) do
			if not primary then
				btn.BackgroundColor3 = T.Surface2
				btn.BackgroundTransparency = math.max(0.05, T.Surface2Transparency)
				btn.TextColor3 = T.Text
			else
				btn.BackgroundColor3 = T.Accent
			end
			Stroke(btn, T.Stroke, 1)
		end
		UpdateTransport()
		RenderLibrary()
	end)

	MApplySize()
	UpdateTransport()
	RenderLibrary()

	return MusicHooks
end



--// ======================================================================
--// LUA SYNTAX HIGHLIGHTER (used by the Gemini code blocks)
--// ======================================================================

local SyntaxColors = {
	Keyword  = "#F86D7C",
	Global   = "#FFCB6B",
	Function = "#82AAFF",
	String   = "#C3E88D",
	Number   = "#F78C6C",
	Comment  = "#676E95",
}

local LuaKeywords = {
	"and", "break", "do", "elseif", "else", "end", "false", "for", "function",
	"if", "in", "local", "nil", "not", "or", "repeat", "return", "then",
	"true", "until", "while", "continue",
}

local LuaGlobals = {
	"game", "workspace", "script", "task", "wait", "spawn", "print", "warn",
	"pairs", "ipairs", "tostring", "tonumber", "typeof", "Instance", "Vector3",
	"Vector2", "CFrame", "Color3", "UDim2", "UDim", "Enum", "math", "string",
	"table", "os", "pcall", "loadstring",
}

local function HighlightLua(code)
	code = tostring(code or "")
	code = code:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	-- strings first so keywords inside them are not recolored
	code = code:gsub('("[^"\n]*")', '<font color="' .. SyntaxColors.String .. '">%1</font>')
	code = code:gsub("('[^'\n]*')", '<font color="' .. SyntaxColors.String .. '">%1</font>')
	code = code:gsub("(%W)(%d+%.?%d*)", '%1<font color="' .. SyntaxColors.Number .. '">%2</font>')
	for _, kw in ipairs(LuaKeywords) do
		code = code:gsub("([^%w_])(" .. kw .. ")([^%w_])", '%1<font color="' .. SyntaxColors.Keyword .. '">%2</font>%3')
		code = code:gsub("^(" .. kw .. ")([^%w_])", '<font color="' .. SyntaxColors.Keyword .. '">%1</font>%2')
	end
	for _, gl in ipairs(LuaGlobals) do
		code = code:gsub("([^%w_%.])(" .. gl .. ")([^%w_])", '%1<font color="' .. SyntaxColors.Global .. '">%2</font>%3')
	end
	code = code:gsub("([%w_]+)(%s*%()", '<font color="' .. SyntaxColors.Function .. '">%1</font>%2')
	code = code:gsub("(%-%-[^\n]*)", '<font color="' .. SyntaxColors.Comment .. '">%1</font>')
	return code
end

--// ======================================================================
--// KEY SYSTEM (V9.1)
--// ======================================================================
--// Enabled with `KeySystem = true` (or a config table) on CreateWindow.
--// The gate is a standalone ScreenGui: the main window is built as usual
--// but stays disabled until a key is accepted, so nothing the script does
--// afterwards has to know the gate exists.
--//
--// Keys are verified OFFLINE.  A key is a pure function of (salt, day),
--// so the KilometresUIX website can mint the exact same string in the
--// browser with no server and no HTTP round-trip from the executor.

local KEY_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" -- no I/O/0/1

--// 32-bit XOR written out by hand: bit32 is Luau-only and Studio-only
--// builds of this file must produce byte-identical hashes.
local function Bxor32(a, b)
	local res, bit = 0, 1
	for _ = 1, 32 do
		local x, y = a % 2, b % 2
		if x ~= y then
			res = res + bit
		end
		a = (a - x) / 2
		b = (b - y) / 2
		bit = bit * 2
	end
	return res
end

--// (a * b) mod 2^32 without ever exceeding 2^53, so the result matches
--// JavaScript's Math.imul(a, b) >>> 0 exactly.
local function Mul32(a, b)
	local a1, a2 = a % 65536, math.floor(a / 65536) % 65536
	local b1, b2 = b % 65536, math.floor(b / 65536) % 65536
	local lo = a1 * b1
	local mid = (a1 * b2 + a2 * b1) % 65536
	return (lo + mid * 65536) % 4294967296
end

local function Rsh32(a, n)
	return math.floor(a / (2 ^ n))
end

--// murmur3 finalizer.  Plain FNV-1a barely changes its low bits between
--// neighbouring inputs, which made every group of a key end in the same
--// character.  This scrambles the whole word before it is sliced up.
local function Avalanche(h)
	h = Bxor32(h, Rsh32(h, 16))
	h = Mul32(h, 2146121005)
	h = Bxor32(h, Rsh32(h, 15))
	h = Mul32(h, 2221713035)
	h = Bxor32(h, Rsh32(h, 16))
	return h
end

--// FNV-1a, 32-bit, then avalanched
local function Fnv1a(str)
	local h = 2166136261
	for i = 1, #str do
		h = Bxor32(h, string.byte(str, i))
		h = Mul32(h, 16777619)
	end
	return Avalanche(h)
end

local function KeyGroup(word)
	local out = {}
	for i = 0, 3 do
		local idx = math.floor(word / (2 ^ (5 * i))) % 32
		out[i + 1] = string.sub(KEY_ALPHABET, idx + 1, idx + 1)
	end
	return table.concat(out)
end

--// exact inverse of KeyGroup: 4 characters back into the 20-bit word.
--// Returns nil when the group holds a character outside the alphabet.
local function GroupValue(group)
	if type(group) ~= "string" or #group ~= 4 then
		return nil
	end
	local v = 0
	for i = 0, 3 do
		local idx = string.find(KEY_ALPHABET, string.sub(group, i + 1, i + 1), 1, true)
		if not idx then
			return nil
		end
		v = v + (idx - 1) * (2 ^ (5 * i))
	end
	return v
end

--// The one function the website mirrors in JavaScript.
local function ComputeKey(salt, day, prefix)
	salt = tostring(salt or "")
	day = tostring(day or 0)
	local g1 = KeyGroup(Fnv1a(salt .. "|" .. day .. "|1"))
	local g2 = KeyGroup(Fnv1a(salt .. "|" .. day .. "|2"))
	local g3 = KeyGroup(Fnv1a(salt .. "|" .. day .. "|3"))
	return (prefix or "KMX") .. "-" .. g1 .. "-" .. g2 .. "-" .. g3
end

--// today's day number, UTC, matching JS Math.floor(Date.now() / 86400000)
--// Kept only so old scripts calling GetKeyForDay() still resolve; the live
--// gate no longer buckets by calendar day.
local function CurrentDay()
	local t = os.time()
	if type(t) ~= "number" then
		return 0
	end
	return math.floor(t / 86400)
end

------------------------------------------------------------------
-- 24 HOUR KEYS (V9.2)
--
-- The old scheme hashed a UTC day number, so a key minted at 23:50 died
-- ten minutes later and GraceDays could stretch it to 48h.  Nobody got
-- the 24 hours they were promised.
--
-- Now the minute the key was minted is carried *inside the key itself*,
-- encrypted, so any key is valid for exactly KEY_LIFETIME seconds from
-- the moment it was generated - no matter when that was.  The gate needs
-- no server and no clock sync: it simply decodes the stamp and subtracts.
--
-- Layout, 3 groups x 20 bits = 60 bits total:
--   g1 = (stampLo 13b << 7 | macA 7b) XOR mask1
--   g2 = (stampHi 13b << 7 | macB 7b) XOR mask2
--   g3 =  macC 20b
-- The 34 MAC bits make a guessed key a 1-in-17-billion shot, and the
-- masks stop the stamp from being readable straight off the string.
------------------------------------------------------------------

local KEY_EPOCH    = 1735689600  -- 2025-01-01T00:00:00Z, start of stamp counting
local KEY_LIFETIME = 86400       -- exactly 24 hours, in seconds
local KEY_STAMP_WRAP = 67108864  -- 2^26 minutes ~= 127 years of headroom

--// wall clock -> minute stamp
local function TimeToStamp(t)
	t = tonumber(t) or 0
	return math.floor((t - KEY_EPOCH) / 60) % KEY_STAMP_WRAP
end

--// minute stamp -> wall clock (start of that minute)
local function StampToTime(stamp)
	return KEY_EPOCH + (tonumber(stamp) or 0) * 60
end

local function CurrentStamp()
	local t = os.time()
	if type(t) ~= "number" then
		return 0
	end
	return TimeToStamp(t)
end

--// per-salt masks, so two scripts with different salts never share keys
local function KeyMasks(salt)
	salt = tostring(salt or "")
	return Fnv1a(salt .. "|MASK|1") % 1048576, Fnv1a(salt .. "|MASK|2") % 1048576
end

--// Mint the key that was/is valid at `stamp`.  This is the one function
--// the website mirrors in JavaScript.
local function ComputeKeyAt(salt, stamp, prefix)
	salt   = tostring(salt or "")
	prefix = tostring(prefix or "KMX")
	stamp  = math.floor(tonumber(stamp) or 0) % KEY_STAMP_WRAP

	local lo, hi = stamp % 8192, math.floor(stamp / 8192)
	local mac = Fnv1a(salt .. "|" .. stamp .. "|MAC")
	local macA = mac % 128
	local macB = math.floor(mac / 128) % 128
	local macC = math.floor(mac / 16384) % 1048576
	local m1, m2 = KeyMasks(salt)

	return prefix .. "-" .. KeyGroup(Bxor32(lo * 128 + macA, m1))
		.. "-" .. KeyGroup(Bxor32(hi * 128 + macB, m2))
		.. "-" .. KeyGroup(macC)
end

--// Read the mint time back out of a key body (12 chars, no prefix/dashes).
--// Returns the stamp, or nil when the MAC does not check out - which is
--// what makes a hand-typed fake key impossible.
local function DecodeKeyStamp(salt, body)
	salt = tostring(salt or "")
	if type(body) ~= "string" or #body ~= 12 then
		return nil
	end
	local w1 = GroupValue(string.sub(body, 1, 4))
	local w2 = GroupValue(string.sub(body, 5, 8))
	local w3 = GroupValue(string.sub(body, 9, 12))
	if not (w1 and w2 and w3) then
		return nil
	end
	local m1, m2 = KeyMasks(salt)
	local x1, x2 = Bxor32(w1, m1), Bxor32(w2, m2)
	local lo, macA = math.floor(x1 / 128), x1 % 128
	local hi, macB = math.floor(x2 / 128), x2 % 128
	local stamp = hi * 8192 + lo

	local mac = Fnv1a(salt .. "|" .. stamp .. "|MAC")
	if mac % 128 ~= macA then
		return nil
	end
	if math.floor(mac / 128) % 128 ~= macB then
		return nil
	end
	if math.floor(mac / 16384) % 1048576 ~= w3 then
		return nil
	end
	return stamp
end

--// "5h 42m" / "58m 03s" - how the countdown is worded everywhere
local function FormatRemaining(secs)
	secs = math.max(0, math.floor(tonumber(secs) or 0))
	local h = math.floor(secs / 3600)
	local m = math.floor((secs % 3600) / 60)
	local s = secs % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	if m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

local function NormalizeKey(s)
	s = tostring(s or ""):upper()
	s = s:gsub("[^A-Z0-9]", "")
	return s
end

local function BuildKeySystem(env)
	-- Same contract as BuildMusicPlayer: everything arrives in `env`, so the
	-- gate costs CreateWindow a single local.
	local Theme     = env.Theme
	local Notify    = env.Notify
	local SaveFile  = env.SaveFile
	local OnSuccess = env.OnSuccess
	local OnCancel  = env.OnCancel
	local opts      = env.Options or {}

	local KeyHooks = {}

	local Title    = tostring(opts.Title or "Kilometres UI X")
	local Subtitle = tostring(opts.Subtitle or "key required")
	local Note     = tostring(opts.Note or "Grab a free key from the KilometresUIX site. Every key lasts exactly 24 hours from the moment it is generated, then resets itself.")
	local Link     = tostring(opts.Link or opts.GetKeyUrl or "https://kilometresuix.pages.dev")
	local Salt     = tostring(opts.Salt or "KILOMETRES-UI-X")
	local Prefix   = tostring(opts.Prefix or "KMX")

	-- V9.4: SERVER-CHECKED KEYS.
	-- Give Website (or VerifyUrl) and the script stops needing the salt at
	-- all: it posts the key to your site and trusts the yes/no it gets back.
	-- That is the only way the salt can really stay secret, because anything
	-- written in this script is readable by every player who runs it.
	local Website = opts.Website or opts.Site or opts.ServerUrl
	local VerifyUrl = opts.VerifyUrl
	if not VerifyUrl and Website then
		VerifyUrl = tostring(Website):gsub("/+$", "") .. "/api/verify"
	end
	if VerifyUrl then
		VerifyUrl = tostring(VerifyUrl)
		if not Link or Link == "https://kilometresuix.pages.dev" then
			if Website then
				Link = tostring(Website):gsub("/+$", "")
			end
		end
	end
	-- V9.2: keys live a fixed span from the moment they are minted.
	-- GraceDays is gone - it is what made "24 hours" mean anything from
	-- ten minutes to two days.  LifetimeHours is the knob now.
	local Lifetime = tonumber(opts.LifetimeSeconds)
		or ((tonumber(opts.LifetimeHours) or 24) * 3600)
	if Lifetime <= 0 then
		Lifetime = KEY_LIFETIME
	end
	local Attempts = tonumber(opts.MaxAttempts) or 0   -- 0 = unlimited
	local Remember = opts.SaveKey ~= false
	local KeyFile  = tostring(opts.KeyFile or ((SaveFile:match("^(.*)/[^/]+$") or "KilometresUIX") .. "/key.json"))

	-- extra keys the script author hard-codes (lifetime / staff keys)
	local StaticKeys = {}
	do
		local list = opts.Keys or opts.Key
		if type(list) == "string" then
			list = {list}
		end
		if type(list) == "table" then
			for _, k in ipairs(list) do
				StaticKeys[NormalizeKey(k)] = true
			end
		end
	end

	local Tries = 0
	local Verified = false
	local ExpiresAt = nil          -- unix seconds; nil = lifetime/custom key
	local ExpiryWatch = nil        -- running watchdog token
	local OnExpiredCb = opts.OnExpired
	local StartExpiryWatch         -- forward declaration, defined after Accept

	------------------------------------------------------------------
	-- VALIDATION
	------------------------------------------------------------------

	--// Returns: ok, message, expiresAt (unix seconds, nil for lifetime keys)
	local function IsValid(raw)
		local given = NormalizeKey(raw)
		if given == "" then
			return false, "Enter a key first.", nil
		end
		if StaticKeys[given] then
			return true, "Lifetime key accepted.", nil
		end
		-- a custom validator always wins, if the script supplied one
		if type(opts.Validate) == "function" then
			local ok, res = pcall(opts.Validate, raw)
			if ok and res then
				return true, "Key accepted.", nil
			end
		end

		-- V9.4: if the script points at a website, that website is the
		-- authority.  We never compute anything locally, so no salt is
		-- needed here and none can be stolen out of this file.
		if VerifyUrl then
			local ok, res = pcall(function()
				local sep = string.find(VerifyUrl, "?", 1, true) and "&" or "?"
				local url = VerifyUrl .. sep .. "key=" .. UrlEncode(given)
				return game:HttpGet(url, true)
			end)
			if not ok or type(res) ~= "string" or res == "" then
				return false, "Cannot reach the key server - check your internet.", nil
			end

			-- tiny hand-rolled reader: the reply is a flat, known object
			local valid = string.match(res, '"valid"%s*:%s*(%a+)')
			if valid ~= "true" then
				local reason = string.match(res, '"reason"%s*:%s*"([^"]*)"') or "invalid"
				if reason == "expired" then
					return false, "This key has expired - grab a fresh one.", nil
				elseif reason == "empty" then
					return false, "Enter a key first.", nil
				end
				return false, "That key is not valid.", nil
			end

			local exp = tonumber(string.match(res, '"expires"%s*:%s*(%d+)'))
			return true, "Key accepted.", exp
		end

		-- strip the prefix, then read the mint time back out of the key
		local body = given
		local pfx = NormalizeKey(Prefix)
		if pfx ~= "" and string.sub(body, 1, #pfx) == pfx then
			body = string.sub(body, #pfx + 1)
		end

		local stamp = DecodeKeyStamp(Salt, body)
		if not stamp then
			return false, "That key is not valid.", nil
		end

		local issued  = StampToTime(stamp)
		local expires = issued + Lifetime
		local now     = os.time()

		if now >= expires then
			return false, "This key has expired - grab a fresh one.", expires
		end
		-- a key stamped in the future means a wrong device clock
		if issued - now > 3600 then
			return false, "Your device clock looks wrong - fix it and retry.", expires
		end

		local left = expires - now
		if left <= 3600 then
			return true, "Key accepted - only " .. FormatRemaining(left) .. " left.", expires
		end
		return true, "Key accepted - " .. FormatRemaining(left) .. " remaining.", expires
	end

	local function RememberKey(raw, expiresAt)
		if not Remember then
			return
		end
		local now = os.time()
		local json = SafeJSONEncode({
			Key       = tostring(raw),
			Salt      = Salt,
			IssuedAt  = now,
			ExpiresAt = expiresAt or (now + Lifetime),   -- nil = lifetime key
			Lifetime  = Lifetime,
			Day       = CurrentDay(),                    -- legacy readers
		})
		if json then
			TryWriteFile(KeyFile, json)
		end
	end

	local function ForgetKey()
		if TryWriteFile then
			TryWriteFile(KeyFile, "")
		end
	end

	--// Reads the saved key back, but *only* if it is still inside its 24
	--// hours.  A stale file is deleted on the spot, which is the auto-reset:
	--// the gate simply reappears on the next launch.
	local function LoadRememberedKey()
		if not Remember then
			return nil
		end
		local raw = TryReadFile(KeyFile)
		local data = raw and SafeJSONDecode(raw)
		if type(data) ~= "table" or type(data.Key) ~= "string" or data.Key == "" then
			return nil
		end
		-- a key saved under a different salt is not ours
		if type(data.Salt) == "string" and data.Salt ~= Salt then
			ForgetKey()
			return nil
		end
		local exp = tonumber(data.ExpiresAt)
		if exp and os.time() >= exp then
			ForgetKey()
			return nil, exp
		end
		return data.Key, exp
	end

	------------------------------------------------------------------
	-- GATE UI
	------------------------------------------------------------------

	local KScreen = New("ScreenGui", {
		Name = "KilometresKey",
		Parent = SafeParent(),
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
