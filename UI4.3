	--// Executes Luau produced by Gemini, with readable reporting
	local function RunGeneratedCode(code)
		if not LoadString then
			Notify("Executor", "loadstring is not available here.", 2.4, "Warning")
			return false
		end
		local clean = tostring(code or "")
		local fn, compileErr = LoadString(clean)
		if not fn then
			Notify("Compile Error", Truncate(tostring(compileErr), 90), 3.5, "Error")
			return false
		end
		local ok, runtimeErr = pcall(fn)
		if ok then
			Notify("Executed", "Script ran successfully.", 2, "Success")
			return true
		end
		Notify("Runtime Error", Truncate(tostring(runtimeErr), 90), 3.5, "Error")
		return false
	end

