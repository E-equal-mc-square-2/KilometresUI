		Parent = Field,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = "",
		PlaceholderText = Prefix .. "-XXXX-XXXX-XXXX",
		PlaceholderColor3 = Theme().TextDim,
		TextColor3 = Theme().Text,
		TextSize = 14,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		ZIndex = 7,
	})

	local Status = New("TextLabel", {
		Parent = Card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 24, 0, 214),
		Size = UDim2.new(1, -48, 0, 16),
		Text = "",
		TextColor3 = Theme().TextDim,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
	})

	local function KeyButton(x, width, label, primary)
		local btn = New("TextButton", {
			Parent = Card,
			Position = UDim2.new(0, x, 0, 240),
			Size = UDim2.fromOffset(width, 36),
			BackgroundColor3 = primary and Theme().Accent or Theme().Surface2,
			BackgroundTransparency = primary and 0 or math.max(0.08, Theme().Surface2Transparency),
			BorderSizePixel = 0,
			Text = label,
			TextColor3 = primary and Color3.new(1, 1, 1) or Theme().Text,
			TextSize = 13,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			ZIndex = 6,
		})
		Corner(btn, 10)
		Stroke(btn, Theme().Stroke, 1)
		local sc = New("UIScale", {Parent = btn, Scale = 1})
		btn.MouseEnter:Connect(function()
			Tween(sc, {Scale = 1.03}, 0.12)
		end)
		btn.MouseLeave:Connect(function()
			Tween(sc, {Scale = 1}, 0.14)
		end)
		btn.MouseButton1Down:Connect(function()
			Tween(sc, {Scale = 0.95}, 0.08)
		end)
		btn.MouseButton1Up:Connect(function()
			Tween(sc, {Scale = 1.02}, 0.1)
		end)
		return btn
	end

	local CheckBtn = KeyButton(24, 168, "Unlock", true)
	local LinkBtn  = KeyButton(200, 108, "Get Key", false)
	local QuitBtn  = KeyButton(316, 60, "Exit", false)

	local Footer = New("TextLabel", {
		Parent = Card,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 24, 0, 286),
		Size = UDim2.new(1, -48, 0, 16),
		Text = Link,
		TextColor3 = Theme().TextDim,
		TextSize = 10,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
	})

	------------------------------------------------------------------
	-- BEHAVIOUR
	------------------------------------------------------------------

	local function SetStatus(text, kind)
		Status.Text = tostring(text or "")
		if kind == "ok" then
			Status.TextColor3 = Theme().Success
		elseif kind == "bad" then
			Status.TextColor3 = Theme().Error
		else
			Status.TextColor3 = Theme().TextDim
		end
	end

	local function Shake()
		local base = Card.Position
		local seq = {12, -10, 7, -4, 0}
		task.spawn(function()
			for _, dx in ipairs(seq) do
				if not Card.Parent then
					return
				end
				Tween(Card, {Position = base + UDim2.fromOffset(dx, 0)}, 0.045)
				task.wait(0.045)
			end
			if Card.Parent then
				Card.Position = base
			end
		end)
	end

	local Closing = false

	local function CloseGate(success)
		if Closing then
			return
		end
		Closing = true
		Tween(CardScale, {Scale = success and 1.06 or 0.9}, 0.16)
		Tween(Card, {BackgroundTransparency = 1}, 0.2)
		Tween(Scrim, {BackgroundTransparency = 1}, 0.2)
		task.delay(0.24, function()
			if KScreen and KScreen.Parent then
				KScreen:Destroy()
			end
		end)
	end

	------------------------------------------------------------------
	-- AUTO RESET
	--
	-- The moment the 24 hours run out we throw the saved key away and
	-- tell the host script, so the session locks itself instead of
	-- staying open until the next launch.
	------------------------------------------------------------------

	function StartExpiryWatch()
		if not ExpiresAt then
			return   -- lifetime key or custom validator: nothing to count down
		end
		local token = {}
		ExpiryWatch = token
		task.spawn(function()
			while ExpiryWatch == token do
				local left = ExpiresAt - os.time()
				if left <= 0 then
					break
				end
				-- tick often near the end, lazily when there are hours to go
				task.wait(left > 120 and 30 or 1)
			end
			if ExpiryWatch ~= token then
				return   -- superseded by a newer key
			end
			ExpiryWatch = nil
			Verified = false
			ForgetKey()
			if Notify then
				pcall(Notify, "Key Expired", "Your 24 hours are up - enter a new key.", 6, "Warning")
			end
			if type(OnExpiredCb) == "function" then
				pcall(OnExpiredCb)
			end
		end)
	end

	local function Accept(raw, silent, expiresAt)
		if Verified then
			return
		end
		Verified = true
		ExpiresAt = expiresAt
		RememberKey(raw, expiresAt)
		StartExpiryWatch()
		if not silent then
			SetStatus("Unlocked.", "ok")
		end
		CloseGate(true)
		if OnSuccess then
			task.defer(OnSuccess)
		end
		if type(opts.OnSuccess) == "function" then
			task.defer(function()
				pcall(opts.OnSuccess)
			end)
		end
	end

	local function Reject(reason)
		Tries = Tries + 1
		SetStatus(reason, "bad")
		Stroke(Field, Theme().Error, 1.4)
		Shake()
		task.delay(1.1, function()
			if Field.Parent and not Verified then
				Stroke(Field, Theme().Stroke, 1)
			end
		end)
		if Attempts > 0 and Tries >= Attempts then
			SetStatus("Too many attempts.", "bad")
			task.delay(0.9, function()
				CloseGate(false)
				if OnCancel then
					task.defer(OnCancel)
				end
			end)
		end
	end

	local function Submit()
		if Verified or Closing then
			return
		end
		local ok, msg, expires = IsValid(Box.Text)
		if ok then
			SetStatus(msg, "ok")
			Accept(Box.Text, false, expires)
		else
			Reject(msg)
		end
	end

	CheckBtn.MouseButton1Click:Connect(Submit)

	Box.FocusLost:Connect(function(enter)
		if enter then
			Submit()
		end
	end)

	-- live formatting: type raw characters, get KMX-XXXX-XXXX-XXXX back
	local Formatting = false
	Box:GetPropertyChangedSignal("Text"):Connect(function()
		if Formatting then
			return
		end
		local raw = NormalizeKey(Box.Text)
		if raw == "" then
			return
		end
		local body = raw
		local pre = NormalizeKey(Prefix)
		if body:sub(1, #pre) == pre then
			body = body:sub(#pre + 1)
		end
		body = body:sub(1, 12)
		local groups = {}
		for i = 1, #body, 4 do
			groups[#groups + 1] = body:sub(i, i + 3)
		end
		local formatted = Prefix
		if #groups > 0 then
			formatted = formatted .. "-" .. table.concat(groups, "-")
		end
		if formatted ~= Box.Text then
			Formatting = true
			Box.Text = formatted
			Formatting = false
		end
	end)

	LinkBtn.MouseButton1Click:Connect(function()
		local copied = SetClipboardText(Link)
		if copied then
			SetStatus("Link copied - open it in your browser.", "ok")
		else
			SetStatus(Link, nil)
		end
		if Notify then
			Notify("Key System", copied and ("Copied " .. Link) or Link, 4, "Info")
		end
	end)

	QuitBtn.MouseButton1Click:Connect(function()
		CloseGate(false)
		if OnCancel then
			task.defer(OnCancel)
		end
	end)

	------------------------------------------------------------------
	-- OPEN
	------------------------------------------------------------------

	Tween(Scrim, {BackgroundTransparency = 0.35}, 0.25)
	Tween(CardScale, {Scale = 1}, 0.3, Enum.EasingStyle.Back)
	SetStatus("Paste your key and hit Unlock.", nil)
	task.defer(function()
		pcall(function()
			Box:CaptureFocus()
		end)
	end)

	-- a saved key that is still inside its 24 hours skips the gate entirely;
	-- an expired one is wiped and the user simply sees the gate (auto-reset)
	do
		local saved = LoadRememberedKey()
		if saved then
			local ok, _, expires = IsValid(saved)
			if ok then
				Box.Text = saved
				local left = expires and (expires - os.time())
				SetStatus(left and ("Saved key valid - " .. FormatRemaining(left) .. " left.")
					or "Saved key still valid - unlocking.", "ok")
				task.delay(0.25, function()
					Accept(saved, true, expires)
				end)
			else
				ForgetKey()
				SetStatus("Your last key expired - enter a new one.", nil)
			end
		end
	end

	function KeyHooks.IsVerified()
		return Verified
	end

	function KeyHooks.Forget()
		ExpiryWatch = nil
		ExpiresAt = nil
		ForgetKey()
	end

	--// a key minted right now, valid for the next 24 hours
	function KeyHooks.Today()
		return ComputeKeyAt(Salt, CurrentStamp(), Prefix)
	end

	--// unix seconds when the active key dies (nil = none / lifetime key)
	function KeyHooks.ExpiresAt()
		return ExpiresAt
	end

	--// seconds left on the active key, 0 when expired, nil when unlimited
	function KeyHooks.TimeLeft()
		if not ExpiresAt then
			return nil
		end
		return math.max(0, ExpiresAt - os.time())
	end

	--// "5h 42m" for UI use
	function KeyHooks.TimeLeftText()
		if not ExpiresAt then
			return "unlimited"
		end
		return FormatRemaining(math.max(0, ExpiresAt - os.time()))
	end

	function KeyHooks.Destroy()
		Closing = true
		ExpiryWatch = nil
		if KScreen and KScreen.Parent then
			KScreen:Destroy()
		end
	end

	return KeyHooks
end

