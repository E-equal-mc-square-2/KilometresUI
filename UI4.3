	local function MiniSlider(yOffset, title, initialPct, onChange)
		local host = New("Frame", {
			Parent = DiscHost,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 0, 0, yOffset),
			Size = UDim2.new(1, 0, 0, 26),
			ZIndex = 37,
		})
		local lbl = New("TextLabel", {
			Parent = host,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 11),
			Text = title,
			TextColor3 = Theme().TextDim,
			TextSize = 10,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 38,
		})
		local track = New("TextButton", {
			Parent = host,
			Position = UDim2.new(0, 0, 0, 14),
			Size = UDim2.new(1, 0, 0, 5),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 38,
		})
		Corner(track, 999)
		local fill = New("Frame", {
			Parent = track,
			Size = UDim2.fromScale(initialPct, 1),
			BackgroundColor3 = Theme().Accent,
			BorderSizePixel = 0,
			ZIndex = 39,
		})
		Corner(fill, 999)

		local dragging = false
		local function apply(x)
			local abs = track.AbsolutePosition.X
			local w = track.AbsoluteSize.X
			if w <= 0 then return end
			local pct = Clamp((x - abs) / w, 0, 1)
			fill.Size = UDim2.fromScale(pct, 1)
			onChange(pct, lbl)
		end
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				apply(input.Position.X)
			end
		end)
		track.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				apply(input.Position.X)
			end
		end))
		AddConn(UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
		return {Label = lbl, Track = track, Fill = fill}
	end

