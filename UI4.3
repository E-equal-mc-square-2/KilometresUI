local ICON_FOLDER = IMG_FOLDER .. "/icons"

local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, #B64_CHARS do
	B64_LOOKUP[string.byte(B64_CHARS, i)] = i - 1
end

local function Base64Decode(data)
	local out = {}
	local bits, nbits = 0, 0
	for i = 1, #data do
		local v = B64_LOOKUP[string.byte(data, i)]
		if v then
			bits = bits * 64 + v
			nbits = nbits + 6
			if nbits >= 8 then
				nbits = nbits - 8
				local shift = 2 ^ nbits
				local byte = math.floor(bits / shift)
				bits = bits - byte * shift
				out[#out + 1] = string.char(byte)
			end
		end
	end
	return table.concat(out)
end

------------------------------------------------------------------
-- V9: BASE64 ENCODER (used by the V9.1 key system)
------------------------------------------------------------------

local function Base64Encode(data)
	if type(data) ~= "string" or data == "" then
		return ""
	end
	local out = {}
	local n = #data
	local i = 1
	while i + 2 <= n do
		local a, b, c = string.byte(data, i, i + 2)
		local num = a * 65536 + b * 256 + c
		local c1 = math.floor(num / 262144) % 64
		local c2 = math.floor(num / 4096) % 64
		local c3 = math.floor(num / 64) % 64
		local c4 = num % 64
		out[#out + 1] = string.sub(B64_CHARS, c1 + 1, c1 + 1)
			.. string.sub(B64_CHARS, c2 + 1, c2 + 1)
			.. string.sub(B64_CHARS, c3 + 1, c3 + 1)
			.. string.sub(B64_CHARS, c4 + 1, c4 + 1)
		i = i + 3
		-- keep long encodes from freezing the client
		if (#out % 4096) == 0 then
			task.wait()
		end
	end
	local rest = n - i + 1
	if rest == 1 then
		local a = string.byte(data, i)
		local num = a * 16
		local c1 = math.floor(num / 64) % 64
		local c2 = num % 64
		out[#out + 1] = string.sub(B64_CHARS, c1 + 1, c1 + 1)
			.. string.sub(B64_CHARS, c2 + 1, c2 + 1) .. "=="
	elseif rest == 2 then
		local a, b = string.byte(data, i, i + 1)
		local num = (a * 256 + b) * 4
		local c1 = math.floor(num / 4096) % 64
		local c2 = math.floor(num / 64) % 64
		local c3 = num % 64
		out[#out + 1] = string.sub(B64_CHARS, c1 + 1, c1 + 1)
			.. string.sub(B64_CHARS, c2 + 1, c2 + 1)
			.. string.sub(B64_CHARS, c3 + 1, c3 + 1) .. "="
	end
	return table.concat(out)
end

------------------------------------------------------------------
-- V9.1: CHARLOTTE VISION REMOVED
--   Roblox / the Gemini endpoint rejected the inlineData image
--   requests coming from an executor HTTP bridge, so the whole vision
--   pipeline (file / url / assetid / screenshot resolvers, the /img,
--   /shot and /detach commands, the Vision toolbar button and the
--   AttachImage + CaptureScreen API) was stripped in V9.1.
--   Base64Encode above is kept - the key system uses it.
------------------------------------------------------------------

local IconCache = {}

local function EnsureIconFolder()
	if type(isfolder) == "function" and type(makefolder) == "function" then
		local ok, exists = pcall(isfolder, IMG_FOLDER)
		if ok and not exists then
			pcall(makefolder, IMG_FOLDER)
		end
		local ok2, exists2 = pcall(isfolder, ICON_FOLDER)
		if ok2 and not exists2 then
			pcall(makefolder, ICON_FOLDER)
		end
	end
end

--// writes img/icons/<name>.png once, then returns the getcustomasset string
local function IconAsset(name)
	if IconCache[name] ~= nil then
		return IconCache[name] or nil
	end
	if not FileSystemOK or not ICON_DATA[name] then
		return nil
	end
	local path = ICON_FOLDER .. "/" .. name .. ".png"
	if not FileExists(path) then
		EnsureIconFolder()
		local okDecode, bytes = pcall(Base64Decode, ICON_DATA[name])
		if not okDecode or type(bytes) ~= "string" or #bytes < 32 then
			IconCache[name] = false
			return nil
		end
		local okWrite = pcall(writefile, path, bytes)
		if not okWrite or not FileExists(path) then
			IconCache[name] = false
			return nil
		end
	end
	local ok, asset = pcall(GetCustomAsset, path)
	if ok and type(asset) == "string" and asset ~= "" then
		IconCache[name] = asset
		return asset
	end
	IconCache[name] = false
	return nil
end

local function RebuildIconCache()
	IconCache = {}
	local written = 0
	for name in pairs(ICON_DATA) do
		if type(delfile) == "function" then
			pcall(delfile, ICON_FOLDER .. "/" .. name .. ".png")
		end
		if IconAsset(name) then
			written = written + 1
		end
	end
	return written
end

--// accepts: built-in icon name | rbxassetid://123 | 123 | "img/x.png" | "any text"
--// returns: value, isImage
local function ResolveIcon(spec)
	if type(spec) == "number" then
		return "rbxassetid://" .. tostring(spec), true
	end
	if type(spec) ~= "string" or spec == "" then
		return nil, false
	end
	local s = spec:gsub("^%s+", ""):gsub("%s+$", "")
	local key = s:lower()

	if ICON_DATA[key] then
		local asset = IconAsset(key)
		if asset then
			return asset, true
		end
		return ICON_GLYPHS[key] or "\u{25CF}", false
	end
	if s:match("^rbxassetid://%d+$") or s:match("^rbxasset://") or s:match("^rbxthumb://") then
		return s, true
	end
	if s:match("^%d+$") then
		return "rbxassetid://" .. s, true
	end
	if s:match("%.png$") or s:match("%.jpg$") or s:match("%.jpeg$") then
		if FileSystemOK and FileExists(s) then
			local ok, asset = pcall(GetCustomAsset, s)
			if ok and type(asset) == "string" then
				return asset, true
			end
		end
		return nil, false
	end

	-- V9.5 FIX: an unknown one-word name like "user" or "gear" used to fall
	-- through and get painted literally, so tabs showed the word instead of a
	-- picture.  A bare identifier is a *missing icon*, not a caption: fall back
	-- to its glyph, then to a neutral dot.  Real captions (with spaces or
	-- punctuation, e.g. "v2" or "1/3") are still drawn as text on purpose.
	if s:match("^%a+$") and #s <= 18 then
		return ICON_GLYPHS[key] or "\u{25CF}", false
	end

	return s, false
end

--// builds either an ImageLabel or a TextLabel, whichever the spec resolves to
local function MakeIconNode(parent, spec, px, color, zIndex, layoutOrder)
	local value, isImage = ResolveIcon(spec)
	if value == nil then
		return nil, false
	end
	if isImage then
		local img = New("ImageLabel", {
			Parent = parent,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(px, px),
			Image = value,
			ImageColor3 = color or Color3.new(1, 1, 1),
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = zIndex or 2,
		})
		if layoutOrder then
			img.LayoutOrder = layoutOrder
		end
		return img, true
	end
	local lbl = New("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(px, px),
		Text = value,
		TextColor3 = color or Color3.new(1, 1, 1),
		TextSize = math.max(11, px - 4),
		Font = Enum.Font.GothamBold,
		ZIndex = zIndex or 2,
	})
	if layoutOrder then
		lbl.LayoutOrder = layoutOrder
	end
	return lbl, false
end

local function SetIconColor(node, color)
	if not node then
		return
	end
	if node:IsA("ImageLabel") then
		node.ImageColor3 = color
	else
		node.TextColor3 = color
	end
end

