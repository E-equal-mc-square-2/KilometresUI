	-- CreateWindow's Notify is (title, text, duration, ntype); normalise so
	-- this file reads the same as the rest of the library.
	local rawNotify = env.Notify
	local function Notify(title, text, ntype, dur)
		if type(rawNotify) == "function" then
			pcall(rawNotify, title, text, dur or 3, ntype or "Info")
		end
	end
	local Version = env.Version or "V9"
	local VersionName = env.VersionName or "Charlotte"

	local ok, err = pcall(function()
		local Tab = Window:CreateTab("About", {Icon = "heart", Order = 9500})

		----------------------------------------------------------------
		local Hero = Tab:CreateSection("KILOMETRES UI X")
