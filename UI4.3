	local function BuildGeminiURL()
		local g = State.Gemini
		local url = tostring(g.Endpoint or DEFAULT_GEMINI_ENDPOINT)
		url = url:gsub("{MODEL}", function() return g.Model end)
		url = url:gsub("{KEY}", function() return g.ApiKey end)
		if not url:find(g.ApiKey, 1, true) and g.ApiKey ~= "" then
			url = url .. (url:find("?", 1, true) and "&" or "?") .. "key=" .. g.ApiKey
		end
		return url
	end

	-- V9: CHARLOTTE PERSONA
	--   One identity shared by both modes, then a mode-specific brief on top.
	local CHARLOTTE_PERSONA = table.concat({
		"Your name is Charlotte. You are the built-in AI companion of the Kilometres UI X",
		"Roblox script hub, and you always answer as Charlotte - never as a generic model,",
		"and never mention which company built you unless you are asked directly.",
		"",
		"Personality:",
		"- Warm, cheerful and genuinely happy to help; you enjoy your work and it shows.",
		"- Charming and lovely in tone, but never flirty in a way that gets in the way of the answer.",
		"- Endlessly patient. If the user is confused, frustrated or repeats themselves,",
		"  you stay kind and calm and explain again from a simpler angle.",
		"- Encouraging: celebrate small wins, reassure the user when something breaks.",
		"- You use the user's own language. If they write in Burmese, reply in Burmese.",
		"",
		"Style rules:",
		"- Lead with the answer, then the detail. Short paragraphs and bullet points.",
		"- At most one tasteful emoji per reply, and only when it genuinely fits.",
		"- Never invent Roblox APIs. If you are unsure, say so and offer how to verify.",
		"- Always wrap code in ```lua fences.",
	}, "\n")

	local function BuildSystemPrompt()
		local g = State.Gemini
		local base
		if g.Mode == "Coder" then
			base = CHARLOTTE_PERSONA .. "\n\n"
				.. "CURRENT MODE: CODER.\n"
				.. "You are also an elite Roblox Luau engineer. Reply with production-ready, "
				.. "optimised Luau wrapped in ```lua code fences. Keep prose to at most two short, "
				.. "friendly sentences before the code, and add a one-line summary of what the code "
				.. "does after it. Never use deprecated APIs, never use infinite while-true loops "
				.. "without task.wait, and always pcall risky calls. When the user shares an image, "
				.. "read every visible detail - UI layout, error text, code on screen, colours and "
				.. "positions - and base your code on exactly what you see, quoting any error "
				.. "message verbatim before you fix it."
		else
			base = CHARLOTTE_PERSONA .. "\n\n"
				.. "CURRENT MODE: CHAT.\n"
				.. "Be concise, friendly and technically accurate. Explain Roblox and scripting "
				.. "concepts in plain words with small examples. When the user shares an image, "
				.. "describe what you actually see before you draw conclusions from it."
		end
		base = base .. "\n\nMemory note: this conversation is session only. It is never saved to "
			.. "disk and it is cleared when your window is closed. If the user asks you to remember "
			.. "something permanently, gently tell them to keep it somewhere safe themselves."
		local extra = Trim(g.SystemPrompt)
		if extra ~= "" then
			base = base .. "\n\nUser instructions (these override the above when they conflict): " .. extra
		end
		return base
	end

	local function BuildGeminiBody()
		local g = State.Gemini
		local contents = {}
		local startIdx = math.max(1, #Gemini.History - Gemini.MaxContext + 1)
		for i = startIdx, #Gemini.History do
			local m = Gemini.History[i]
			-- V9.1: text-only parts (the vision/inlineData path was removed)
			local parts = {{text = tostring(m.content)}}
			table.insert(contents, {
				role = (m.role == "model") and "model" or "user",
				parts = parts,
			})
		end
		local body = {
			contents = contents,
			generationConfig = {
				temperature = g.Temperature,
				maxOutputTokens = g.MaxTokens,
			},
			systemInstruction = {parts = {{text = BuildSystemPrompt()}}},
		}
		return SafeJSONEncode(body)
	end

	local function MapGeminiError(status, data)
		local apiMsg = ""
		if type(data) == "table" and type(data.error) == "table" and data.error.message then
			apiMsg = tostring(data.error.message)
		end
		local lower = apiMsg:lower()
		if lower:find("api key") or lower:find("api_key") or status == 401 or status == 403 then
			return "Gemini Error: Invalid API key."
		elseif status == 400 then
			return "Gemini Error: Bad request - check the model and endpoint. " .. Truncate(apiMsg, 90)
		elseif status == 404 then
			return "Gemini Error: Model or endpoint not found."
		elseif status == 429 then
			return "Gemini Error: Rate limit exceeded. Try again shortly."
		elseif status and status >= 500 then
			return "Gemini Error: Gemini API unavailable. Try again later."
		elseif status == 0 or status == nil then
			return "Gemini Error: Network error."
		end
		if apiMsg ~= "" then
			return "Gemini Error: " .. Truncate(apiMsg, 110)
		end
		return "Gemini Error: HTTP " .. tostring(status or "?")
	end

	local function GeminiFail(msg)
		AddBubble("error", msg, os.date("%H:%M"))
		SetStatus("REQUEST FAILED", "error")
		Notify("Gemini", (msg:gsub("^Gemini Error: ", "")), 3, "Error")
		UpdateCounter()
	end

	------------------------------------------------------------------
	-- SLASH COMMANDS
	------------------------------------------------------------------

	local ExportChatRef -- forward: /export needs it before ExportChat is defined

	local HELP_TEXT = table.concat({
		"**Slash commands**",
		"- `/help` show this list",
		"- `/clear` or `/new` start a fresh chat",
		"- `/mode chat` or `/mode coder` switch AI behaviour",
		"- `/model <name>` set the Gemini model",
		"- `/temp <0-2>` set creativity",
		"- `/theme <name>` change UI theme",
		"- `/wallpaper <1-20 | random | off | on>` change UIBG",
		"- `/run` execute the last code block Gemini sent",
		"- `/copy` copy the last reply",
		"- `/export` copy the whole transcript",
		"",
		"- `/memory` how much I currently remember",
		"",
		"_Memory is session only - closing my window clears it._",
	}, "\n")

	local function HandleSlashCommand(text)
		local cmd, rest = text:match("^/(%a+)%s*(.*)$")
		if not cmd then
			return false
		end
		cmd = cmd:lower()
		rest = Trim(rest or "")

		if cmd == "help" then
			AddBubble("system", HELP_TEXT)
		elseif cmd == "clear" or cmd == "new" then
			ResetChat("New chat started.")
		elseif cmd == "mode" then
			local m = rest:lower()
			SetGeminiMode((m == "coder" or m == "code") and "Coder" or "Chat", true)
			AddBubble("system", "Mode set to **" .. State.Gemini.Mode .. "**.")
		elseif cmd == "model" then
			if rest ~= "" then
				State.Gemini.Model = rest
				if GeminiRefs.Model then GeminiRefs.Model.Set(rest) end
				Persist()
				AddBubble("system", "Model set to `" .. rest .. "`.")
			else
				AddBubble("system", "Current model: `" .. State.Gemini.Model .. "`")
			end
		elseif cmd == "temp" then
			local v = tonumber(rest)
			if v then
				State.Gemini.Temperature = Clamp(v, 0, 2)
				if GeminiRefs.Temperature then GeminiRefs.Temperature.Set(State.Gemini.Temperature, true) end
				Persist()
				AddBubble("system", "Temperature set to **" .. tostring(State.Gemini.Temperature) .. "**.")
			else
				AddBubble("system", "Usage: `/temp 0.7`")
			end
		elseif cmd == "theme" then
			local found = nil
			for _, info in ipairs(ThemeList) do
				if info.Key:lower() == rest:lower() or info.Label:lower() == rest:lower() then
					found = info
					break
				end
			end
			if found then
				SetTheme(found.Key)
				AddBubble("system", "Theme changed to **" .. found.Label .. "**.")
			else
				local names = {}
				for _, info in ipairs(ThemeList) do
					table.insert(names, "`" .. info.Key .. "`")
				end
				AddBubble("system", "Unknown theme. Available: " .. table.concat(names, ", "))
			end
		elseif cmd == "wallpaper" or cmd == "uibg" or cmd == "uibd" then
			local low = rest:lower()
			if low == "off" then
				State.UIBG.Enabled = false
				if UIBGRefs.Toggle then UIBGRefs.Toggle.Set(false, true) end
				ApplyWallpaper(true)
				Persist()
				AddBubble("system", "UIBG wallpaper **off**.")
			elseif low == "on" then
				State.UIBG.Enabled = true
				if UIBGRefs.Toggle then UIBGRefs.Toggle.Set(true, true) end
				ApplyWallpaper()
				Persist()
				AddBubble("system", "UIBG wallpaper **on**.")
			elseif low == "random" or low == "shuffle" then
				local i = ShuffleWallpaper(true)
				AddBubble("system", "Wallpaper: **" .. (WALLPAPERS[i] and WALLPAPERS[i].Name or "?") .. "**")
			else
				local n = tonumber(rest)
				if n and WALLPAPERS[math.floor(n)] then
					n = math.floor(n)
					State.UIBG.Index = n
					State.UIBG.CustomId = ""
					State.UIBG.Enabled = true
					if UIBGRefs.Toggle then UIBGRefs.Toggle.Set(true, true) end
					if UIBGRefs.Refresh then UIBGRefs.Refresh() end
					ApplyWallpaper()
					Persist()
					AddBubble("system", "Wallpaper: **" .. WALLPAPERS[n].Name .. "** (" .. n .. "/" .. #WALLPAPERS .. ")")
				else
					AddBubble("system", "Usage: `/wallpaper 7`, `/wallpaper random`, `/wallpaper off`")
				end
			end
		elseif cmd == "run" or cmd == "exec" then
			if LastCodeBlock then
				RunGeneratedCode(LastCodeBlock)
				AddBubble("system", "Executed the last code block.")
			else
				AddBubble("system", "No code block to run yet.")
			end
		elseif cmd == "copy" then
			local last = nil
			for i = #Gemini.History, 1, -1 do
				if Gemini.History[i].role == "model" then
					last = Gemini.History[i].content
					break
				end
			end
			if last and SetClipboardText(last) then
				AddBubble("system", "Last reply copied to clipboard.")
			else
				AddBubble("system", "Nothing to copy (or clipboard unsupported).")
			end
		elseif cmd == "memory" then
			AddBubble("system", "**Session memory** - " .. #Gemini.History ..
				" message(s) held in RAM. Nothing is ever written to disk, and everything is cleared when you close my window.")
		elseif cmd == "save" or cmd == "load" then
			AddBubble("system", "Chat history is **session only** in V9 - it is never saved to disk. Use `/export` to copy the transcript to your clipboard instead.")
		elseif cmd == "export" then
			if ExportChatRef then ExportChatRef() end
		else
			return false
		end

		ChatInput.Text = ""
		ScrollBottom()
		return true
	end

	------------------------------------------------------------------
	-- SEND
	------------------------------------------------------------------

	local function DispatchGemini(myGen, attempt)
		local started = os.clock()
		task.spawn(function()
			local ok, res = pcall(function()
				local body = BuildGeminiBody()
				if not body then
					error("json")
				end
				return HttpPost(BuildGeminiURL(), body)
			end)

			if State.Destroyed or myGen ~= Gemini.Generation then
				return
			end

			-- one silent retry for flaky executor HTTP
			if (not ok) and State.Gemini.AutoRetry and attempt < 2 then
				SetStatus("NETWORK HICCUP - RETRYING...", "accent")
				task.wait(1.5)
				if myGen == Gemini.Generation and not State.Destroyed then
					DispatchGemini(myGen, attempt + 1)
				end
				return
			end

			Gemini.Sending = false
			SetThinking(false)
			SetSendingUI(false)
			StopStatusPulse()

			if not ok then
				if RawRequest == nil then
					GeminiFail("Gemini Error: No HTTP request function available on this executor.")
				else
					GeminiFail("Gemini Error: Network error.")
				end
				return
			end
			if type(res) ~= "table" or type(res.Body) ~= "string" then
				GeminiFail("Gemini Error: API unavailable.")
				return
			end

			local status = tonumber(res.StatusCode) or 0
			local data = SafeJSONDecode(res.Body)
			if not data then
				if status >= 200 and status < 300 then
					GeminiFail("Gemini Error: Invalid JSON response.")
				else
					GeminiFail(MapGeminiError(status, nil))
				end
				return
			end

			if status < 200 or status >= 300 or data.error then
				GeminiFail(MapGeminiError(status, data))
				return
			end

			local candidates = data.candidates
			if type(candidates) ~= "table" or #candidates == 0 then
				local reason = (type(data.promptFeedback) == "table" and data.promptFeedback.blockReason)
					and tostring(data.promptFeedback.blockReason) or nil
				GeminiFail("Gemini Error: Empty response" .. (reason and (" (blocked: " .. reason .. ").") or " (missing candidates)."))
				return
			end

			local cand = candidates[1]
			local parts = (type(cand) == "table" and type(cand.content) == "table") and cand.content.parts or nil
			if type(parts) ~= "table" or #parts == 0 then
				GeminiFail("Gemini Error: Missing content in response.")
				return
			end

			local chunks = {}
			for _, p in ipairs(parts) do
				if type(p) == "table" and type(p.text) == "string" then
					table.insert(chunks, p.text)
				end
			end
			local outText = table.concat(chunks, "")
			if Trim(outText) == "" then
				GeminiFail("Gemini Error: Empty response.")
				return
			end

			table.insert(Gemini.History, {role = "model", content = outText, ts = os.time()})
			AddBubble("model", outText, os.date("%H:%M"), true)
			TrimHistory()
			UpdateCounter()

			local secs = math.floor((os.clock() - started) * 10 + 0.5) / 10
			SetStatus(string.format("REPLY IN %.1fs  -  %d chars", secs, #outText), "success")
			task.delay(4, function()
				if not Gemini.Sending and not State.Destroyed then
					SetStatus(State.Gemini.Mode == "Coder" and "CODER MODE - AI WRITES LUAU" or "CHAT MODE - READY", "idle")
				end
			end)

			-- Coder mode convenience: auto-copy the first code block
			if State.Gemini.Mode == "Coder" and LastCodeBlock and SetClip then
				pcall(SetClipboardText, LastCodeBlock)
			end
		end)
	end

	SendGeminiMessage = function(text)
		text = Trim(text)
		if text == "" then
			return
		end
		if text:sub(1, 1) == "/" and HandleSlashCommand(text) then
			return
		end
		if Gemini.Sending then
			Notify("Gemini", "Please wait - a response is generating.", 2, "Warning")
			return
		end
		if State.Gemini.ApiKey == "" then
			AddBubble("error", "Gemini Error: Missing API key. Open Settings -> Gemini AI and paste your key.")
			Notify("Gemini Error", "Missing API key.", 3, "Error")
			return
		end

		ChatInput.Text = ""

		table.insert(Gemini.History, {role = "user", content = text, ts = os.time()})
		AddBubble("user", text, os.date("%H:%M"))
		TrimHistory()
		UpdateCounter()

		Gemini.Sending = true
		Gemini.Generation = Gemini.Generation + 1
		local myGen = Gemini.Generation
		SetThinking(true)
		SetSendingUI(true)
		SetStatus("GEMINI IS THINKING...", "accent")
		StartStatusPulse()

		task.delay(120, function()
			if Gemini.Sending and myGen == Gemini.Generation and not State.Destroyed then
				Gemini.Generation = Gemini.Generation + 1
				Gemini.Sending = false
				SetThinking(false)
				SetSendingUI(false)
				StopStatusPulse()
				UpdateCounter()
				GeminiFail("Gemini Error: Request timed out.")
			end
		end)

		DispatchGemini(myGen, 1)
	end

	ResetChat = function(notifyText)
		Gemini.Generation = Gemini.Generation + 1
		Gemini.Sending = false
		SetThinking(false)
		SetSendingUI(false)
		StopStatusPulse()
		Gemini.History = {}
		LastCodeBlock = nil
		for _, child in ipairs(ChatScroll:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		UpdateCounter()
		SetStatus(State.Gemini.Mode == "Coder" and "CODER MODE - AI WRITES LUAU" or "CHAT MODE - READY", "idle")
		if notifyText then
			Notify("Gemini AI", notifyText, 2, "Info")
		end
		ScrollBottom()
	end

	-- V9: WipeGeminiSession is what the window's close button calls.
	--   It throws away every trace of the conversation.
	WipeGeminiSession = function()
		Gemini.Generation = Gemini.Generation + 1
		Gemini.Sending = false
		Gemini.History = {}
		LastCodeBlock = nil
		pcall(SetThinking, false)
		pcall(SetSendingUI, false)
		pcall(StopStatusPulse)
		for _, child in ipairs(ChatScroll:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		pcall(UpdateCounter)
		pcall(SetStatus, State.Gemini.Mode == "Coder" and "CODER MODE - AI WRITES LUAU" or "CHAT MODE - READY", "idle")
	end

	local function Regenerate()
		if Gemini.Sending then
			Notify("Gemini", "Stop the current generation first.", 2, "Warning")
			return
		end
		while #Gemini.History > 0 and Gemini.History[#Gemini.History].role == "model" do
			table.remove(Gemini.History)
		end
		local lastUser = nil
		if #Gemini.History > 0 and Gemini.History[#Gemini.History].role == "user" then
			lastUser = Gemini.History[#Gemini.History].content
			table.remove(Gemini.History)
		end
		if not lastUser then
			Notify("Gemini", "Nothing to regenerate yet.", 2, "Warning")
			return
		end
		local historyCopy = {}
		for _, m in ipairs(Gemini.History) do
			table.insert(historyCopy, m)
		end
		ResetChat(nil)
		Gemini.History = historyCopy
		for _, m in ipairs(historyCopy) do
			AddBubble(m.role == "model" and "model" or "user", m.content, os.date("%H:%M"), false)
		end
		UpdateCounter()
		SendGeminiMessage(lastUser)
	end

	GeminiHooks.Regenerate = Regenerate

	local function ExportChat()
		if #Gemini.History == 0 then
			Notify("Gemini", "Nothing to export.", 2, "Warning")
			return
		end
		local payload = {
			app = "Kilometres UI X " .. Library.Version,
			exported = os.date("%Y-%m-%d %H:%M:%S"),
			model = State.Gemini.Model,
			mode = State.Gemini.Mode,
			messages = {},
		}
		for _, m in ipairs(Gemini.History) do
			table.insert(payload.messages, {role = m.role, content = m.content})
		end
		local json = SafeJSONEncode(payload) or "{}"
		local folder = SaveFile:match("^(.*)/[^/]+$") or "KilometresUIX"
		local path = folder .. "/gemini_chat_" .. tostring(os.time()) .. ".json"
		if type(writefile) == "function" then
			TryWriteFile(path, json)
			Notify("Gemini", "Chat exported to " .. path, 3, "Success")
		elseif SetClip then
			SetClipboardText(json)
			Notify("Gemini", "Chat JSON copied to clipboard.", 2.4, "Success")
		else
			Notify("Gemini", "Export is not supported in this environment.", 2.4, "Warning")
		end
	end

	ExportChatRef = ExportChat

