		AIBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				sx, sy = AIState.OffsetX, AIState.OffsetY
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		AIBar.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and input == dragInput and dragStart then
				local delta = input.Position - dragStart
				AIState.OffsetX = sx + delta.X
				AIState.OffsetY = sy + delta.Y
				AIClampOffsets()
			end
		end))
	end

	-- resizing
	do
		local resizing, resizeInput, resizeStart, sw, sh = false, nil, nil, 0, 0
		AIGrip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				sw, sh = AIState.Width, AIState.Height
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
					end
				end)
			end
		end)
		AIGrip.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				resizeInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if resizing and input == resizeInput and resizeStart then
				local delta = input.Position - resizeStart
				AIState.Width = Clamp(math.floor(sw + delta.X), 320, 1200)
				AIState.Height = Clamp(math.floor(sh + delta.Y), 260, 860)
				AIApplySize()
			end
		end))
	end

	-- Charlotte's memory is SESSION ONLY: closing the window wipes it.
	-- (WipeGeminiSession is declared above and filled in by the chat block.)

	local function SetGeminiWindowOpen(open, silent)
		AIState.Open = open and true or false
		if AIState.Open then
			AIState.Minimized = false
			AIApplySize()
			AIWindow.Visible = true
			AIScale.Scale = State.UIScale * 0.94
			Tween(AIScale, {Scale = State.UIScale}, 0.2, Enum.EasingStyle.Back)
			if not silent then
				Notify("Charlotte", "Hi! I am right here whenever you need me.", 2, "Success")
			end
		else
			Tween(AIScale, {Scale = State.UIScale * 0.94}, 0.14)
			task.delay(0.15, function()
				if not AIState.Open and AIWindow and AIWindow.Parent then
					AIWindow.Visible = false
				end
			end)
			-- session-only memory: everything is dropped the moment we close
			if WipeGeminiSession then
				pcall(WipeGeminiSession)
			end
			if not silent then
				Notify("Charlotte", "Window closed - this session's chat was cleared.", 2, "Info")
			end
		end
	end

