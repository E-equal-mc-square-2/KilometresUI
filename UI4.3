	-- click / drag the progress bar to seek
	do
		local seeking = false
		local function seek(x)
			local abs = ProgressTrack.AbsolutePosition.X
			local w = ProgressTrack.AbsoluteSize.X
			if w <= 0 or Sound.TimeLength <= 0 then return end
			local pct = Clamp((x - abs) / w, 0, 1)
			pcall(function()
				Sound.TimePosition = pct * Sound.TimeLength
			end)
			ProgressFill.Size = UDim2.fromScale(pct, 1)
		end
		ProgressTrack.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				seeking = true
				MusicState.Seeking = true
				seek(input.Position.X)
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if seeking and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				seek(input.Position.X)
			end
		end))
		AddConn(UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				seeking = false
				MusicState.Seeking = false
			end
		end))
	end

	AddBtn.MouseButton1Click:Connect(function()
		OpenModal(nil)
	end)

	------------------------------------------------------------------
	-- WEB SEARCH  ·  pulls new songs off archive.org at runtime
	------------------------------------------------------------------

	local WebBusy = false

	WebBtn.MouseButton1Click:Connect(function()
		local query = Trim(SearchBox.Text)
		if query == "" then
			Notify("Music", "Type something in the search box first.", 2.4, "Warning")
			return
		end
		if WebBusy then
			Notify("Music", "Still searching - hold on.", 2, "Warning")
			return
		end
		WebBusy = true
		WebBtn.Text = "..."
		Notify("Music", "Searching archive.org for \"" .. query .. "\"...", 2.2, "Info")

		task.spawn(function()
			local ok, results = pcall(ArchiveSearch, query, 6)
			WebBusy = false
			WebBtn.Text = "WEB"
			if not ok or type(results) ~= "table" or #results == 0 then
				Notify("Music", "Nothing playable found for that. Try the artist name too.", 3, "Warning")
				return
			end
			--// skip anything already in the playlist
			local have = {}
			for _, s in ipairs(Playlist) do
				if s.Url and s.Url ~= "" then have[s.Url] = true end
			end
			local added = 0
			for _, row in ipairs(results) do
				if not have[row.Url] then
					table.insert(Playlist, row)
					added = added + 1
				end
			end
			if added == 0 then
				Notify("Music", "Those results are already in your library.", 2.6, "Info")
				return
			end
			SavePlaylist()
			--// clear the filter so the user actually sees what arrived
			SearchQuery = ""
			SearchBox.Text = ""
			RenderLibrary()
			Notify("Music", "Added " .. added .. " track" .. (added == 1 and "" or "s")
				.. " from archive.org - scroll to the bottom.", 3.4, "Success")
		end)
	end)

	RestoreBtn.MouseButton1Click:Connect(function()
		Playlist = BuildDefaultPlaylist()
		CurrentIndex = 0
		pcall(function() Sound:Stop() end)
		MusicState.Playing = false
		TrackLabel.Text = "Nothing selected"
		ArtistLabel.Text = "-"
		OrbTrackName.Text = "Nothing playing"
		SavePlaylist()
		UpdateTransport()
		RenderLibrary()
		Notify("Music", "Library restored to the built-in " .. #MUSIC_LIBRARY .. " tracks.", 2.4, "Success")
	end)

	ModalCancel.MouseButton1Click:Connect(CloseModal)

	ModalSave.MouseButton1Click:Connect(function()
		local name = Trim(FieldName.Text)
		local artist = Trim(FieldArtist.Text)
		local url = Trim(FieldUrl.Text)
		local id = Trim(FieldId.Text):gsub("%D", "")
		if url ~= "" and not url:match("^https?://") then
			Notify("Music", "The url has to start with http:// or https://", 2.6, "Warning")
			return
		end
		if name == "" or (url == "" and id == "") then
			Notify("Music", "A name plus either a url or an audio id is required.", 2.6, "Warning")
			return
		end
		if EditingIndex and Playlist[EditingIndex] then
			Playlist[EditingIndex].Name = name
			Playlist[EditingIndex].Artist = artist
			Playlist[EditingIndex].Url = url
			Playlist[EditingIndex].Id = id
			if EditingIndex == CurrentIndex then
				TrackLabel.Text = name
				ArtistLabel.Text = (artist ~= "" and artist) or "unknown artist"
				OrbTrackName.Text = name
			end
		else
			table.insert(Playlist, {Name = name, Artist = artist, Genre = "Custom", Url = url, Id = id})
		end
		SavePlaylist()
		CloseModal()
		RenderLibrary()
		Notify("Music", EditingIndex and "Song updated." or ("Added \"" .. name .. "\"."), 2.2, "Success")
	end)

	-- audio finished: advance according to the repeat mode
	AddConn(Sound.Ended:Connect(function()
		if State.Destroyed then
			return
		end
		if RepeatMode == "one" then
			PlayIndex(CurrentIndex, true)
		elseif RepeatMode == "off" then
			MusicState.Playing = false
			UpdateTransport()
		else
			StepTrack(1)
		end
	end))

	------------------------------------------------------------------
	-- LAYOUT / DRAG / RESIZE
	------------------------------------------------------------------

	local function MClampOffsets()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local maxX = math.max(0, math.floor((vp.X - MState.Width) / 2 - 8))
		local maxY = math.max(0, math.floor((vp.Y - MState.Height) / 2 - 8))
		MState.OffsetX = Clamp(MState.OffsetX, -maxX, maxX)
		MState.OffsetY = Clamp(MState.OffsetY, -maxY, maxY)
		MWindow.Position = UDim2.new(0.5, MState.OffsetX, 0.5, MState.OffsetY)
	end

	local function MApplySize()
		MWindow.Size = UDim2.fromOffset(MState.Width, MState.Height)
		MClampOffsets()
	end

	local function DragHandle(handle, getOffsets, setOffsets, onDone)
		local dragging, dragInput, dragStart, sx, sy = false, nil, nil, 0, 0
		local moved = 0
		handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				moved = 0
				dragStart = input.Position
				sx, sy = getOffsets()
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						if onDone then onDone(moved) end
					end
				end)
			end
		end)
		handle.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if dragging and input == dragInput and dragStart then
				local delta = input.Position - dragStart
				moved = math.max(moved, math.abs(delta.X) + math.abs(delta.Y))
				setOffsets(sx + delta.X, sy + delta.Y)
			end
		end))
	end

	DragHandle(MBar,
		function() return MState.OffsetX, MState.OffsetY end,
		function(x, y)
			MState.OffsetX, MState.OffsetY = x, y
			MClampOffsets()
		end)

	do
		local resizing, resizeInput, resizeStart, sw, sh = false, nil, nil, 0, 0
		MGrip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				sw, sh = MState.Width, MState.Height
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
					end
				end)
			end
		end)
		MGrip.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				resizeInput = input
			end
		end)
		AddConn(UIS.InputChanged:Connect(function(input)
			if resizing and input == resizeInput and resizeStart then
				local delta = input.Position - resizeStart
				MState.Width = Clamp(math.floor(sw + delta.X), 520, 1100)
				MState.Height = Clamp(math.floor(sh + delta.Y), 380, 800)
				MApplySize()
			end
		end))
	end

	------------------------------------------------------------------
	-- OPEN / CLOSE / MINIMISE
	------------------------------------------------------------------

	local function ShowOrb(show)
		OrbHost.Visible = show and true or false
		if show then
			OrbScale.Scale = State.UIScale * 0.8
			Tween(OrbScale, {Scale = State.UIScale}, 0.22, Enum.EasingStyle.Back)
		end
	end

	local function SetMinimized(min)
		MState.Minimized = min and true or false
		if MState.Minimized then
			Tween(MScale, {Scale = State.UIScale * 0.9}, 0.14)
			task.delay(0.15, function()
				if MState.Minimized and MWindow and MWindow.Parent then
					MWindow.Visible = false
				end
			end)
			ShowOrb(true)
		else
			ShowOrb(false)
			MWindow.Visible = true
			MScale.Scale = State.UIScale * 0.92
			Tween(MScale, {Scale = State.UIScale}, 0.2, Enum.EasingStyle.Back)
		end
	end

	local function SetMusicOpen(open, silent)
		MState.Open = open and true or false
		if MState.Open then
			MState.Minimized = false
			ShowOrb(false)
			MApplySize()
			MWindow.Visible = true
			MScale.Scale = State.UIScale * 0.94
			Tween(MScale, {Scale = State.UIScale}, 0.2, Enum.EasingStyle.Back)
			RenderLibrary()
			UpdateTransport()
			if not silent then
				Notify("Music", (#Playlist .. " tracks loaded. Minimise me for the vinyl orb."), 2.4, "Success")
			end
		else
			ShowOrb(false)
			Tween(MScale, {Scale = State.UIScale * 0.94}, 0.14)
			task.delay(0.15, function()
				if not MState.Open and MWindow and MWindow.Parent then
					MWindow.Visible = false
				end
			end)
			-- closing stops the music; minimise if you want it to keep going
			pcall(function() Sound:Stop() end)
			MusicState.Playing = false
			UpdateTransport()
		end
	end

	MusicHooks.Open = function()
		SetMusicOpen(true, false)
	end
	MusicHooks.Toggle = function()
		SetMusicOpen(not MState.Open, false)
	end
	MusicHooks.IsOpen = function()
		return MState.Open
	end
	MusicHooks.Close = function()
		SetMusicOpen(false, true)
	end
	-- V9.1: the key gate hides every surface the library owns, including the
	-- music player's own ScreenGui and its minimised orb
	MusicHooks.SetEnabled = function(on)
