	------------------------------------------------------------------
	-- KEY SYSTEM (V9.1)  ·  cfg.KeySystem = true | {…}
	------------------------------------------------------------------
	-- The whole window is already built at this point.  Rather than delay
	-- construction (which would break scripts that add tabs immediately),
	-- the gate hides the UI and only lets it back on a correct key.

	do
		local ks = cfg.KeySystem
		if ks == true then
			ks = {}
		end
		if type(ks) == "table" then
			local wasHidden = State.Hidden
			-- park everything out of sight while the gate is up
			Screen.Enabled = false
			if Music then
				if Music.Close then
					pcall(Music.Close)
				end
				if Music.SetEnabled then
					pcall(Music.SetEnabled, false)
				end
			end
			if GeminiHooks.SetEnabled then
				pcall(GeminiHooks.SetEnabled, false)
			end

			ks.Title = ks.Title or cfg.Title or "Kilometres UI X"
			ks.SaveKey = ks.SaveKey

			KeyGate = BuildKeySystem({
				Theme = Theme,
				Notify = Notify,
				SaveFile = SaveFile,
				Options = ks,
				OnSuccess = function()
					if State.Destroyed then
						return
					end
					Screen.Enabled = true
					if Music and Music.SetEnabled then
						pcall(Music.SetEnabled, true)
					end
					if GeminiHooks.SetEnabled then
						pcall(GeminiHooks.SetEnabled, true)
					end
					if not wasHidden then
						SetHidden(false)
					end
					Notify("Welcome", "Key accepted - enjoy.", 3, "Success")
				end,
				OnCancel = function()
					if not State.Destroyed then
						Destroy()
					end
				end,
			})
		end
	end

	------------------------------------------------------------------
	-- CLEANUP
	------------------------------------------------------------------

	Destroy = function()
		if State.Destroyed then
			return
		end
		State.Destroyed = true
		Gemini.Generation = Gemini.Generation + 1
		Gemini.Sending = false
		if ThinkingRef then
			ThinkingRef.Active = false
		end
		for _, conn in ipairs(State.Connections) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		State.Connections = {}
		if WorldBlur and WorldBlur.Parent then
			pcall(function()
				WorldBlur:Destroy()
			end)
		end
		-- V9: wipe the session and remove Charlotte's own ScreenGui
		if WipeGeminiSession then
			pcall(WipeGeminiSession)
		end
		if GeminiHooks.DestroyWindow then
			pcall(GeminiHooks.DestroyWindow)
		end
		-- V9.1: stop the music and drop its ScreenGui + Sound instance
		if Music and Music.Destroy then
			pcall(Music.Destroy)
		end
		-- V9.1: and take the key gate down if it is still on screen
		if KeyGate and KeyGate.Destroy then
			pcall(KeyGate.Destroy)
		end
		Persist()
		if Screen and Screen.Parent then
			Screen:Destroy()
		end
	end

