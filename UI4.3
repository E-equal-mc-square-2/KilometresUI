	local function AIClampOffsets()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local shownH = AIState.Minimized and 40 or AIState.Height
		local maxX = math.max(0, math.floor((vp.X - AIState.Width) / 2 - 8))
		local maxY = math.max(0, math.floor((vp.Y - shownH) / 2 - 8))
		AIState.OffsetX = Clamp(AIState.OffsetX, -maxX, maxX)
		AIState.OffsetY = Clamp(AIState.OffsetY, -maxY, maxY)
		AIWindow.Position = UDim2.new(0.5, AIState.OffsetX, 0.5, AIState.OffsetY)
	end

	local function AIApplySize()
		AIWindow.Size = UDim2.fromOffset(AIState.Width, AIState.Minimized and 40 or AIState.Height)
