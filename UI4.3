--// ======================================================================
--// IMG FOLDER ENGINE
--//   Wallpapers are downloaded once from their source URL and cached in
--//   the executor's  img/  folder, then loaded with getcustomasset so the
--//   picture comes off the phone instead of a Roblox asset id.
--// ======================================================================

local WINDOW_RADIUS = 22
local PANEL_RADIUS  = 16
local IMG_FOLDER = "img"

--// V9.5: free emote pack, auto-run once when a window is created.
--// Set CreateWindow({ FreeEmotes = false }) to skip it.
local EMOTE_SCRIPT_URL =
	"https://rawscripts.net/raw/Universal-Script-7yd7-I-Emote-Script-48024"

local GetCustomAsset =
	(type(getcustomasset) == "function" and getcustomasset)
	or (type(getsynasset) == "function" and getsynasset)
	or (type(syn) == "table" and type(syn.getcustomasset) == "function" and syn.getcustomasset)
	or nil

local FileSystemOK =
	type(writefile) == "function"
	and type(isfile) == "function"
	and GetCustomAsset ~= nil

local function EnsureImgFolder()
	if type(isfolder) == "function" and type(makefolder) == "function" then
		local ok, exists = pcall(isfolder, IMG_FOLDER)
		if ok and not exists then
			pcall(makefolder, IMG_FOLDER)
		end
	end
end

local function ImgPath(wp)
	return IMG_FOLDER .. "/" .. tostring(wp.File or "UIBG.png")
end

local function FileExists(path)
	if type(isfile) ~= "function" then
		return false
	end
	local ok, exists = pcall(isfile, path)
	return ok and exists and true or false
end

--// GET that returns raw bytes (executor request first, HttpGet fallback)
local function HttpGetBinary(url)
	if RawRequest then
		local ok, res = pcall(RawRequest, {Url = url, Method = "GET"})
		if ok and type(res) == "table" and type(res.Body) == "string" and #res.Body > 2048 then
			local status = tonumber(res.StatusCode) or 200
			if status >= 200 and status < 300 then
				return res.Body
			end
		end
	end
	local ok, body = pcall(function()
		return game:HttpGet(url, true)
	end)
	if ok and type(body) == "string" and #body > 2048 then
		return body
	end
	return nil
end

--// returns: assetString, isLocalFile
local function WallpaperAsset(wp)
	if not wp then
		return nil, false
	end
	if FileSystemOK then
		local path = ImgPath(wp)
		if FileExists(path) then
			local ok, asset = pcall(GetCustomAsset, path)
			if ok and type(asset) == "string" and asset ~= "" then
				return asset, true
			end
		end
	end
	if wp.Id then
		return "rbxassetid://" .. tostring(wp.Id), false
	end
	return nil, false
end

--// downloads one wallpaper into img/ (returns true when the file is ready)
local function CacheWallpaper(wp)
	if not FileSystemOK or not wp or not wp.Url then
		return false
	end
	local path = ImgPath(wp)
	if FileExists(path) then
		return true
	end
	EnsureImgFolder()
	local data = HttpGetBinary(wp.Url)
	if not data then
		return false
	end
	local ok = pcall(writefile, path, data)
	return ok and FileExists(path)
end

local function CachedCount()
	if not FileSystemOK then
		return 0
	end
	local n = 0
	for _, wp in ipairs(WALLPAPERS) do
		if FileExists(ImgPath(wp)) then
			n = n + 1
		end
	end
	return n
end

--// ======================================================================
--// SND FOLDER ENGINE   (V9.3)
--//   Exactly the same idea as the img/ engine above, but for music.
--//   A track is downloaded once from its archive.org url into  snd/
--//   and afterwards played straight off the device with
--//   getcustomasset, so it never depends on a Roblox audio id.
--//   Roblox accepts .mp3 / .ogg / .wav / .flac, and archive.org
--//   serves plain mp3 with no key, no expiry and no ip lock.
--// ======================================================================

local SND_FOLDER = "snd"

local function EnsureSndFolder()
	if type(isfolder) == "function" and type(makefolder) == "function" then
		local ok, exists = pcall(isfolder, SND_FOLDER)
		if ok and not exists then
			pcall(makefolder, SND_FOLDER)
		end
	end
end

--// stable, filesystem-safe name derived from the track itself
local function SndFileName(song)
	local base = tostring(song.Name or "track") .. "_" .. tostring(song.Artist or "")
	base = base:gsub("[^%w%-]+", "_"):gsub("^_+", ""):gsub("_+$", "")
	if base == "" then base = "track" end
	if #base > 48 then base = base:sub(1, 48) end
	--// tiny hash of the url so two different sources never collide.
	--// self-contained on purpose: Bxor32/Mul32 live further down the
	--// file, so this engine cannot call them.
	local url = tostring(song.Url or song.Id or base)
	local h = 5381
	for i = 1, #url do
		h = (h * 33 + url:byte(i)) % 4294967296
	end
	local ext = "mp3"
	local tail = url:match("%.(%a%a%a%a?)$")
	if tail then
		tail = tail:lower()
		if tail == "ogg" or tail == "wav" or tail == "flac" or tail == "mp3" then
			ext = tail
		end
	end
	return string.format("%s_%08x.%s", base, h % 4294967296, ext)
end

local function SndPath(song)
	return SND_FOLDER .. "/" .. SndFileName(song)
end

--// is this track already sitting on the device?
local function SongCached(song)
	if not FileSystemOK or not song or not song.Url then
		return false
	end
	return FileExists(SndPath(song))
end

--// returns: assetString, isLocalFile
--//   local snd/ file first, rbxassetid:// fallback for executors with
--//   no filesystem (or when the download has not happened yet).
local function SongAsset(song)
	if not song then
		return nil, false
	end
	if FileSystemOK and song.Url then
		local path = SndPath(song)
		if FileExists(path) then
			local ok, asset = pcall(GetCustomAsset, path)
			if ok and type(asset) == "string" and asset ~= "" then
				return asset, true
			end
		end
	end
	local id = tostring(song.Id or ""):gsub("%D", "")
	if id ~= "" then
		return "rbxassetid://" .. id, false
	end
	return nil, false
end

--// downloads one track into snd/ (returns true when the file is ready)
--//   audio is a lot bigger than a wallpaper, so the size floor is
--//   higher: anything under 64 KB is an error page, not a song.
local function CacheSong(song)
	if not FileSystemOK or not song or not song.Url then
		return false
	end
	local path = SndPath(song)
	if FileExists(path) then
		return true
	end
	EnsureSndFolder()
	local data = HttpGetBinary(song.Url)
	if not data or #data < 65536 then
		return false
	end
	local ok = pcall(writefile, path, data)
	return ok and FileExists(path)
end

--// ======================================================================
--// ARCHIVE.ORG LIVE SEARCH   (V9.3)
--//   Lets the player look up any song on archive.org at runtime and
--//   drop it straight into the playlist.  Public json api, no key.
--//     search    advancedsearch.php?q=...&output=json
--//     metadata  /metadata/<identifier>  -> files[] + server + dir
--//   Every function here is blocking, so callers run them in a
--//   task.spawn worker exactly like CacheSong.
--// ======================================================================

local ARCHIVE_SEARCH = "https://archive.org/advancedsearch.php"
local ARCHIVE_META   = "https://archive.org/metadata/"

--// percent-encode for a query string
local function UrlEncode(s)
	s = tostring(s or "")
	s = s:gsub("[^%w%-%._~]", function(c)
		return string.format("%%%02X", string.byte(c))
	end)
	return s
end

--// plain GET returning a decoded json table (nil on any failure)
local function HttpGetJson(url)
	local body
	if RawRequest then
		local ok, res = pcall(RawRequest, {Url = url, Method = "GET"})
		if ok and type(res) == "table" and type(res.Body) == "string" then
			body = res.Body
		end
	end
	if not body then
		local ok, res = pcall(function() return game:HttpGet(url) end)
		if ok and type(res) == "string" then
			body = res
		end
	end
	if not body or body == "" then
		return nil
	end
	return SafeJSONDecode(body)
end

--// names we never want to hear: karaoke, 8-bit covers, meme edits...
local ARCHIVE_REJECT = {
	"karaoke", "instrumental", "acapella", "a cappella", "8 bit", "8bit",
	"midi", "tutorial", "nightcore", "sped up", "slowed", "earrape",
	"ringtone", "preview", "sample pack", "interview", "podcast",
}

local function ArchiveNameOK(name)
	local low = tostring(name or ""):lower()
	if not low:match("%.mp3$") and not low:match("%.ogg$")
		and not low:match("%.wav$") and not low:match("%.flac$") then
		return false
	end
	for _, bad in ipairs(ARCHIVE_REJECT) do
		if low:find(bad, 1, true) then
			return false
		end
	end
	return true
end

--// splits a query into scoreable words
local function ArchiveWords(q)
	local out = {}
	for w in tostring(q or ""):lower():gmatch("[%a%d]+") do
		if #w > 2 then
			table.insert(out, w)
		end
	end
	return out
end

--// picks the best playable audio file inside one archive.org item.
--// returns url, sizeBytes, score  (or nil when nothing is usable)
local function ArchivePickFile(identifier, ws)
	local meta = HttpGetJson(ARCHIVE_META .. UrlEncode(identifier))
	if type(meta) ~= "table" or type(meta.files) ~= "table" then
		return nil
	end
	local host = meta.server and ("https://" .. tostring(meta.server) .. tostring(meta.dir or ""))
		or ("https://archive.org/download/" .. identifier)
	local best, bestScore, bestSize
	for _, f in ipairs(meta.files) do
		local nm = f and f.name
		if nm and ArchiveNameOK(nm) then
			local size = tonumber(f.size) or 0
			--// 400 KB .. 23 MB keeps out id3 stubs and hour-long dj sets
			if size > 400000 and size < 23000000 then
				local low = nm:lower()
				local score = 0
				for _, w in ipairs(ws) do
					if low:find(w, 1, true) then score = score + 6 end
				end
				--// a normal single is roughly 3-14 MB
				if size > 2500000 and size < 14000000 then score = score + 3 end
				if (not bestScore) or score > bestScore
					or (score == bestScore and size > bestSize) then
					best, bestScore, bestSize = nm, score, size
				end
			end
		end
	end
	if not best then
		return nil
	end
	local encoded = best:gsub("[^%w%-%._~/]", function(c)
		return string.format("%%%02X", string.byte(c))
	end)
	return host .. "/" .. encoded, bestSize, bestScore
end

--// full search: query text -> up to `limit` {Name, Artist, Url} rows.
--// tries a title-scoped query first, then a loose one.
local function ArchiveSearch(query, limit)
	limit = limit or 6
	local ws = ArchiveWords(query)
	local out, seen = {}, {}
	local queries = {
		'mediatype:audio AND title:(' .. tostring(query) .. ')',
		'mediatype:audio AND (' .. tostring(query) .. ')',
	}
	for _, q in ipairs(queries) do
		if #out >= limit then break end
		local url = ARCHIVE_SEARCH
			.. "?q=" .. UrlEncode(q)
			.. "&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=creator"
			.. "&sort%5B%5D=downloads+desc"
			.. "&rows=" .. tostring(limit * 3) .. "&page=1&output=json"
		local data = HttpGetJson(url)
		local docs = data and data.response and data.response.docs
		if type(docs) == "table" then
			--// rank the items by how well the title matches before we
			--// spend a metadata request on each one
			local ranked = {}
			for _, doc in ipairs(docs) do
				if doc and doc.identifier then
					local t = tostring(doc.title or ""):lower()
					local sc = 0
					for _, w in ipairs(ws) do
						if t:find(w, 1, true) then sc = sc + 4 end
					end
					table.insert(ranked, {doc = doc, score = sc})
				end
			end
			table.sort(ranked, function(a, b) return a.score > b.score end)

			for _, item in ipairs(ranked) do
				if #out >= limit then break end
				local ident = item.doc.identifier
				if not seen[ident] then
					seen[ident] = true
					local fileUrl, _, fileScore = ArchivePickFile(ident, ws)
					--// combined relevance floor: kills the random dj mixes
					if fileUrl and (item.score + fileScore) >= 8 then
						local nm = item.doc.title or ident
						if type(nm) == "table" then nm = nm[1] end
						local ar = item.doc.creator
						if type(ar) == "table" then ar = ar[1] end
						table.insert(out, {
							Name   = tostring(nm):sub(1, 56),
							Artist = tostring(ar or "archive.org"):sub(1, 34),
							Genre  = "Found",
							Url    = fileUrl,
							Id     = "",
						})
					end
				end
			end
		end
	end
	return out
end

