	UpdateTransport = function()
		local kind = MusicState.Playing and "pause" or "play"
		PlayGlyph:SetKind(kind)
		OrbPlayGlyph:SetKind(kind)
		ShuffleBtn.BackgroundColor3 = Shuffle and Theme().Accent or Theme().Surface2
		ShuffleBtn.BackgroundTransparency = Shuffle and 0 or math.max(0.08, Theme().Surface2Transparency)
		ShuffleBtn.TextColor3 = Shuffle and Color3.new(1, 1, 1) or Theme().Text
		RepeatBtn.Text = (RepeatMode == "one" and "R1") or (RepeatMode == "off" and "R-") or "R"
		RepeatBtn.BackgroundColor3 = (RepeatMode ~= "off") and Theme().Accent or Theme().Surface2
		RepeatBtn.BackgroundTransparency = (RepeatMode ~= "off") and 0 or math.max(0.08, Theme().Surface2Transparency)
		RepeatBtn.TextColor3 = (RepeatMode ~= "off") and Color3.new(1, 1, 1) or Theme().Text
	end

	------------------------------------------------------------------
	-- LIBRARY ROWS + SEARCH
	------------------------------------------------------------------

	local RowPool = {}

	local function MatchesQuery(song, q)
		if q == "" then
			return true
		end
		local hay = (song.Name .. " " .. (song.Artist or "") .. " " .. (song.Genre or "")):lower()
		return hay:find(q, 1, true) ~= nil
	end

	RenderLibrary = function()
		for _, row in ipairs(RowPool) do
			row:Destroy()
		end
		RowPool = {}
		Filtered = {}

		local q = SearchQuery:lower()
		for i, song in ipairs(Playlist) do
			if MatchesQuery(song, q) then
				table.insert(Filtered, i)
			end
		end

		CountLabel.Text = (#Filtered == #Playlist)
			and (#Playlist .. " songs")
			or (#Filtered .. " of " .. #Playlist .. " songs")

		if #Filtered == 0 then
			local empty = New("TextLabel", {
				Parent = LibScroll,
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundTransparency = 1,
				Text = "No song matches \"" .. SearchQuery .. "\"",
				TextColor3 = Theme().TextDim,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				ZIndex = 38,
			})
			table.insert(RowPool, empty)
			return
		end

		for order, idx in ipairs(Filtered) do
			local song = Playlist[idx]
			local isCurrent = (idx == CurrentIndex)

			local row = New("Frame", {
				Parent = LibScroll,
				LayoutOrder = order,
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = isCurrent and Theme().Accent or Theme().Surface2,
				BackgroundTransparency = isCurrent and 0.72 or math.max(0.1, Theme().Surface2Transparency),
				BorderSizePixel = 0,
				ZIndex = 38,
			})
			Corner(row, 8)
			if isCurrent then
				local st = Stroke(row, Theme().Accent, 1.2)
				st.Transparency = 0.2
			end

			New("TextLabel", {
				Parent = row,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 4),
				Size = UDim2.new(1, -74, 0, 15),
				Text = song.Name,
				TextColor3 = isCurrent and Theme().Accent or Theme().Text,
				TextSize = 12,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 39,
			})

			New("TextLabel", {
				Parent = row,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 19),
				Size = UDim2.new(1, -74, 0, 13),
				Text = ((song.Artist ~= "" and song.Artist) or "unknown")
					.. ((song.Genre and song.Genre ~= "") and ("  ·  " .. song.Genre) or "")
					.. ((song.Url and song.Url ~= "")
						and (SongCached(song) and "  ·  saved" or "  ·  cloud")
						or ("  ·  " .. tostring(song.Id))),
				TextColor3 = Theme().TextDim,
				TextSize = 10,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 39,
			})

			-- clicking anywhere on the row plays it
			local hit = New("TextButton", {
				Parent = row,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -60, 1, 0),
				Text = "",
				ZIndex = 40,
			})
			hit.MouseButton1Click:Connect(function()
				PlayIndex(idx, true)
			end)

			local function RowTool(xOffset, glyph, danger)
				local b = New("TextButton", {
					Parent = row,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, xOffset, 0.5, 0),
					Size = UDim2.fromOffset(22, 22),
					BackgroundColor3 = Theme().Surface,
					BackgroundTransparency = 0.25,
					BorderSizePixel = 0,
					Text = glyph,
					TextColor3 = danger and Theme().Error or Theme().TextDim,
					TextSize = 11,
					Font = Enum.Font.GothamBold,
					AutoButtonColor = false,
					ZIndex = 41,
				})
				Corner(b, 999)
				return b
			end

			local editBtn = RowTool(-32, "E", false)
			local delBtn  = RowTool(-8, "X", true)

			editBtn.MouseButton1Click:Connect(function()
				OpenModal(idx)
			end)
			delBtn.MouseButton1Click:Connect(function()
				table.remove(Playlist, idx)
				if CurrentIndex == idx then
					pcall(function() Sound:Stop() end)
					MusicState.Playing = false
					CurrentIndex = 0
					TrackLabel.Text = "Nothing selected"
					ArtistLabel.Text = "-"
					OrbTrackName.Text = "Nothing playing"
					UpdateTransport()
				elseif CurrentIndex > idx then
					CurrentIndex = CurrentIndex - 1
				end
				SavePlaylist()
				RenderLibrary()
			end)

			table.insert(RowPool, row)
		end
	end

