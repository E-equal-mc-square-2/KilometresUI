	local Tabs = {}

	--// slides the accent underline under the active tab and keeps that tab
	--// inside the visible part of the (scrollable) top bar
	SyncTabIndicator = function(animated)
		local active = nil
		for _, t in ipairs(Tabs) do
			if t.Active then
				active = t
				break
			end
		end
		if not active or not active.Button or not active.Button.Parent or not TabBar.Visible then
			TabIndicator.Visible = false
			return
		end

		-- V9.1 FIX: AbsolutePosition/AbsoluteSize are reported in *screen*
		-- pixels, which already include the window's UIScale.  The indicator
		-- is positioned in the TabBar's own (unscaled) offset space, so the
		-- two only agreed while UIScale was exactly 1.  At 80% every tab was
		-- drawn ~20% too far left, so the bar sat under the previous tab.
		-- Divide the measured pixels back out by the live scale factor.
		local uiScale = 1
		if MainScaleRef and MainScaleRef.Scale and MainScaleRef.Scale > 0 then
			uiScale = MainScaleRef.Scale
		end

		local barAbs = TabBar.AbsolutePosition.X
		local btnAbs = active.Button.AbsolutePosition.X
		local width = active.Button.AbsoluteSize.X / uiScale
		if width <= 0 or TabBar.AbsoluteSize.X <= 0 then
			-- AutomaticSize has not resolved yet: try again next frame
			task.delay(0.08, function()
				if not State.Destroyed then
					pcall(SyncTabIndicator, false)
				end
			end)
			return
		end
		local x = ((btnAbs - barAbs) / uiScale) + TabBar.CanvasPosition.X

		TabIndicator.Visible = true
		if animated == false then
			TabIndicator.Position = UDim2.new(0, x, 1, -4)
			TabIndicator.Size = UDim2.fromOffset(width, 3)
		else
			Tween(TabIndicator, {
				Position = UDim2.new(0, x, 1, -4),
				Size = UDim2.fromOffset(width, 3),
			}, 0.22, Enum.EasingStyle.Quint)
		end

		-- auto scroll the active tab into view
		local viewW = TabBar.AbsoluteSize.X / uiScale
		local canvasX = TabBar.CanvasPosition.X
		if x < canvasX then
			Tween(TabBar, {CanvasPosition = Vector2.new(math.max(0, x - 12), 0)}, 0.22)
		elseif (x + width) > (canvasX + viewW) then
			Tween(TabBar, {CanvasPosition = Vector2.new(math.max(0, x + width - viewW + 12), 0)}, 0.22)
		end
	end

	function Library:CreateTab(name, opts)
		opts = opts or {}
		local Tab = {}
		State.TabCounter = State.TabCounter + 1
		local order = tonumber(opts.Order) or (opts.Internal and 99999 or State.TabCounter)

		local Data = {
			Active = false,
			Internal = opts.Internal and true or false,
			Page = nil,
			LandButton = nil,
			PortButton = nil,
		}

		local icon = opts.Icon and tostring(opts.Icon) or nil

		local TabButton = New("TextButton", {
			Parent = TabStrip,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Theme().Surface2,
			BackgroundTransparency = Theme().Surface2Transparency,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 25,
		})
		Corner(TabButton, 12)
		do
			local s = Stroke(TabButton, Theme().Stroke, 1)
			s.Transparency = 0.4
		end
		Gradient(TabButton, Theme().Surface2, ColorLerp(Theme().Surface2, Color3.new(0, 0, 0), 0.18), 90)
		New("UIPadding", {Parent = TabButton, PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14)})
		New("UIListLayout", {
			Parent = TabButton,
			Padding = UDim.new(0, 6),
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		})

		local TabIcon
		if icon then
			TabIcon = MakeIconNode(TabButton, icon, 16, Theme().TextDim, 26, 1)
			if TabIcon and TabIcon:IsA("TextLabel") then
				TabIcon.AutomaticSize = Enum.AutomaticSize.X
				TabIcon.Size = UDim2.new(0, 0, 1, 0)
				TabIcon.TextSize = 14
			end
		end

		local TabLabel = New("TextLabel", {
			Parent = TabButton,
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			Text = name,
			TextColor3 = Theme().TextDim,
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			LayoutOrder = 2,
			ZIndex = 26,
		})

		local TabScale = New("UIScale", {Parent = TabButton, Scale = 1})

		TabButton.MouseEnter:Connect(function()
			if not Data.Active then
				Tween(TabButton, {BackgroundColor3 = ColorLerp(Theme().Surface2, Theme().Accent, 0.22)}, 0.12)
			end
		end)
		TabButton.MouseLeave:Connect(function()
			if not Data.Active then
				Tween(TabButton, {BackgroundColor3 = Theme().Surface2}, 0.15)
			end
		end)

		local Page
		if opts.Raw then
			Page = New("Frame", {
				Parent = PageHolder,
				Visible = false,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 35,
			})
		else
			Page = New("ScrollingFrame", {
				Parent = PageHolder,
				Visible = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				CanvasSize = UDim2.fromOffset(0, 0),
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ScrollBarThickness = 4,
				ZIndex = 35,
			})
			New("UIPadding", {Parent = Page, PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)})
			New("UIListLayout", {Parent = Page, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder})
		end

		Data.Button = TabButton
		Data.Label = TabLabel
		Data.Icon = TabIcon
		-- V5/V7 compatibility aliases (old scripts poked these directly)
		Data.LandButton = TabButton
		Data.LandLabel = TabLabel
		Data.PortButton = TabButton
		Data.PortLabel = TabLabel
		Data.Page = Page
		Data.Order = order
		table.insert(Tabs, Data)

		function Data.Activate()
			if State.Hidden or State.Minimized then
				SetMinimized(false)
			end
			for _, t in ipairs(Tabs) do
				t.Active = false
				t.Page.Visible = false
				Gradient(t.Button, Theme().Surface2, ColorLerp(Theme().Surface2, Color3.new(0, 0, 0), 0.18), 90)
				Tween(t.Button, {BackgroundColor3 = Theme().Surface2, BackgroundTransparency = Theme().Surface2Transparency}, 0.15)
				Tween(t.Label, {TextColor3 = Theme().TextDim}, 0.15)
				if t.Icon then
					SetIconColor(t.Icon, Theme().TextDim)
				end
			end
			Data.Active = true
			Page.Visible = true
			Gradient(TabButton, Theme().Accent, ColorLerp(Theme().Accent, Color3.new(1, 1, 1), 0.32), 90)
			Tween(TabButton, {BackgroundColor3 = Theme().Accent, BackgroundTransparency = 0.05}, 0.15)
			Tween(TabLabel, {TextColor3 = Color3.new(1, 1, 1)}, 0.15)
			if TabIcon then
				SetIconColor(TabIcon, Color3.new(1, 1, 1))
			end
			TabScale.Scale = 0.94
			Tween(TabScale, {Scale = 1}, 0.18, Enum.EasingStyle.Back)

			-- page slide-in
			local pageScale = Page:FindFirstChildOfClass("UIScale") or New("UIScale", {Parent = Page, Scale = 1})
			pageScale.Scale = 0.985
			Tween(pageScale, {Scale = 1}, 0.18)

			State.ActiveTab = Data
			SettingsOverlay.Visible = false
			PageHolder.Visible = true
			UpdateLayout()
			task.defer(function()
				pcall(SyncTabIndicator, true)
			end)
		end

		TabButton.MouseButton1Click:Connect(Data.Activate)

		AddRefresher(function()
			TabButton.BackgroundColor3 = Data.Active and Theme().Accent or Theme().Surface2
			TabButton.BackgroundTransparency = Data.Active and 0.05 or Theme().Surface2Transparency
			if Data.Active then
				Gradient(TabButton, Theme().Accent, ColorLerp(Theme().Accent, Color3.new(1, 1, 1), 0.32), 90)
			else
				Gradient(TabButton, Theme().Surface2, ColorLerp(Theme().Surface2, Color3.new(0, 0, 0), 0.18), 90)
			end
			TabLabel.TextColor3 = Data.Active and Color3.new(1, 1, 1) or Theme().TextDim
			if TabIcon then
				SetIconColor(TabIcon, Data.Active and Color3.new(1, 1, 1) or Theme().TextDim)
			end
			Stroke(TabButton, Theme().Stroke, 1)
		end)

		-- V9: sections can now be built into ANY page (the tab's own page,
		-- or one of its sub-tab pages), so the builder takes a target.
		local function MakeSection(TargetPage, title)
			local Section = {Collapsed = false}

			local Holder = New("Frame", {
				Parent = TargetPage,
				BackgroundColor3 = Theme().Surface,
				BackgroundTransparency = Theme().SurfaceTransparency,
				BorderSizePixel = 0,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, -2, 0, 0),
				ZIndex = 40,
			})
			Corner(Holder, PANEL_RADIUS)
			do
				local s = Stroke(Holder, Theme().Stroke, 1)
				s.Transparency = 0.35
			end
			New("UIGradient", {
				Parent = Holder,
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.04),
					NumberSequenceKeypoint.new(1, 0.18),
				}),
			})

			New("UIPadding", {Parent = Holder, PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)})
			New("UIListLayout", {Parent = Holder, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})

			local HeaderRow = New("Frame", {
				Parent = Holder,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 24),
				ZIndex = 41,
			})

			local HeaderTitle = New("TextLabel", {
				Parent = HeaderRow,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -28, 1, 0),
				Text = title,
				TextColor3 = Theme().Text,
				TextSize = 15,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 41,
			})

			local Arrow = New("TextButton", {
				Parent = HeaderRow,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, -2),
				Size = UDim2.fromOffset(24, 24),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 41,
			})
			-- V9.1 FIX: vector chevron (the old glyph showed as a blank box on
			-- executors whose font atlas lacks U+25BE / U+25B8).
			local ArrowIcon = Chevron(Arrow, 13, Theme().TextDim, "down", 42)
			ArrowIcon.Holder.Position = UDim2.fromScale(0.5, 0.5)

			local Content = New("Frame", {
				Parent = Holder,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				ZIndex = 41,
			})
			New("UIListLayout", {Parent = Content, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})
			New("UIPadding", {Parent = Content, PaddingTop = UDim.new(0, 2)})

			local function RenderCollapse(animated)
				Content.Visible = not Section.Collapsed
				ArrowIcon:SetDirection(Section.Collapsed and "right" or "down", animated)
			end

			Arrow.MouseButton1Click:Connect(function()
				Section.Collapsed = not Section.Collapsed
				RenderCollapse(true)
			end)

			AddRefresher(function()
				Holder.BackgroundColor3 = Theme().Surface
				Holder.BackgroundTransparency = Theme().SurfaceTransparency
				HeaderTitle.TextColor3 = Theme().Text
				ArrowIcon:SetColor(Theme().TextDim)
				Stroke(Holder, Theme().Stroke, 1)
			end)

			function Section:Button(text, callback, options)
				return CreateButton(Content, text, callback, options)
			end
			function Section:Toggle(text2, default, callback)
				return CreateToggle(Content, text2, default, callback)
			end
			function Section:Slider(text2, min2, max2, default, callback, increment)
				return CreateSlider(Content, text2, min2, max2, default, callback, increment)
			end
			function Section:Input(text2, a2, a3, a4)
				return CreateInput(Content, text2, a2, a3, a4)
			end
			function Section:Textbox(text2, placeholder, callback)
				return CreateInput(Content, text2, placeholder, callback)
			end
			function Section:Dropdown(text2, options2, default, callback)
				return CreateDropdown(Content, text2, options2, default, callback)
			end
			function Section:Keybind(text2, defaultKey, callback)
				return CreateKeybind(Content, text2, defaultKey, callback)
			end
			function Section:ColorPicker(text2, defaultColor, callback)
				return CreateColorPicker(Content, text2, defaultColor, callback)
			end
			function Section:Label(text2)
				return CreateLabel(Content, text2)
			end
			function Section:Paragraph(title2, body)
				return CreateParagraph(Content, title2, body)
			end
			function Section:Divider()
				return CreateDivider(Content)
			end
			function Section:Info(text2)
				return CreateInfo(Content, text2)
			end

			RenderCollapse()
			return Section
		end

		function Tab:CreateSection(title)
			return MakeSection(Data.ContentPage or Page, title)
		end

		------------------------------------------------------------------
		-- V9: SUB-TABS
		--   Calling Tab:CreateSubTab() the first time converts this page
		--   into a host with its own scrollable pill row on top and one
		--   scrolling page per sub-tab underneath. Everything the Universal
		--   Suite used to spread across six main tabs now lives here.
		------------------------------------------------------------------

		Data.SubTabs = {}
		local SubBar, SubStrip, SubHost

		local function EnsureSubTabHost()
			if SubBar then
				return
			end
			-- the tab's own page becomes a plain container
			Page.AutomaticCanvasSize = Enum.AutomaticSize.None
			Page.CanvasSize = UDim2.fromOffset(0, 0)
			Page.ScrollingEnabled = false
			for _, ch in ipairs(Page:GetChildren()) do
				if ch:IsA("UIListLayout") or ch:IsA("UIPadding") then
					ch:Destroy()
				end
			end

			SubBar = New("ScrollingFrame", {
				Parent = Page,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.new(1, 0, 0, 34),
				AutomaticCanvasSize = Enum.AutomaticSize.X,
				CanvasSize = UDim2.fromOffset(0, 0),
				ScrollingDirection = Enum.ScrollingDirection.X,
				ScrollBarThickness = 0,
				ZIndex = 36,
			})

			SubStrip = New("Frame", {
				Parent = SubBar,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				ZIndex = 36,
			})
			New("UIListLayout", {
				Parent = SubStrip,
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			})

			SubHost = New("Frame", {
				Parent = Page,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(0, 40),
				Size = UDim2.new(1, 0, 1, -40),
				ZIndex = 35,
			})
		end

		function Tab:CreateSubTab(name, subOpts)
			subOpts = subOpts or {}
			EnsureSubTabHost()

			local SubData = {Name = name, Active = false}
			local subIcon = subOpts.Icon and tostring(subOpts.Icon) or nil

			local Btn = New("TextButton", {
				Parent = SubStrip,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 0, 28),
