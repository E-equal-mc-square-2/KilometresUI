local function SafeParent()
	if type(gethui) == "function" then
		local ok, ui = pcall(gethui)
		if ok and ui then
			return ui
		end
	end
	if PlayerGui then
		return PlayerGui
	end
	return CoreGui
end

local function New(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			obj[k] = v
		end
	end
	if props and props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

--// live "Roundness" multiplier (Settings -> Appearance). Pill radii (>=900)
--// are left alone so circles stay circles.
local RoundnessMult = 1

--// V9: global UI scale bounds. 1.0 = 100% (native), 0.2 = 20% (tiny).
--// Everything inside the window is driven by one UIScale, so a single
--// number shrinks tabs, titles, header, buttons, elements and fonts.
local UI_SCALE_MIN = 0.2
local UI_SCALE_MAX = 1.0

--// Set by the window builder so ApplyUIScale can also scale the detached
--// Charlotte AI window (it lives outside `Main`).
local GeminiWindowScaleHook = nil

local function ScaledRadius(radius)
	if radius >= 900 then
		return radius
	end
	return math.max(0, math.floor(radius * RoundnessMult + 0.5))
end

local function Corner(obj, radius)
	radius = radius or 14
	local c = New("UICorner", {
		Parent = obj,
		CornerRadius = UDim.new(0, ScaledRadius(radius)),
	})
	-- remembered so the "Roundness" slider can rescale every corner live
	c:SetAttribute("KM_BaseRadius", radius)
	return c
end

--// V7 FIX: reuses an existing UIStroke instead of stacking a new one
--// every time a theme refresher runs (V5 leaked one UIStroke per refresh).
local function Stroke(obj, color, thickness)
	local s = obj:FindFirstChildOfClass("UIStroke")
	if not s then
		s = Instance.new("UIStroke")
		s.Thickness = thickness or 1
		s.Parent = obj
	end
	s.Color = color
	if thickness then
		s.Thickness = thickness
	end
	return s
end

--// V8.5 visual helpers: gradients, soft shadows, glows
local function Gradient(obj, c1, c2, rotation, transparency)
	local g = obj:FindFirstChildOfClass("UIGradient")
	if not g then
		g = Instance.new("UIGradient")
		g.Parent = obj
	end
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(1, c2),
	})
	g.Rotation = rotation or 0
	if transparency then
		g.Transparency = transparency
	end
	return g
end

local SHADOW_ASSET = "rbxassetid://6015045625"

--// soft drop shadow: `host` must not clip, `target` is the frame it hugs
local function Shadow(host, target, spread, transparency, color)
	local sh = Instance.new("ImageLabel")
	sh.Name = "KM_Shadow"
	sh.BackgroundTransparency = 1
	sh.Image = SHADOW_ASSET
	sh.ImageColor3 = color or Color3.new(0, 0, 0)
	sh.ImageTransparency = transparency or 0.55
	sh.ScaleType = Enum.ScaleType.Slice
	sh.SliceCenter = Rect.new(49, 49, 450, 450)
	sh.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
	sh.AnchorPoint = target.AnchorPoint
	sh.Parent = host

	spread = spread or 22
	local function sync()
		sh.Size = UDim2.new(
			target.Size.X.Scale, target.Size.X.Offset + spread * 2,
			target.Size.Y.Scale, target.Size.Y.Offset + spread * 2
		)
		sh.Position = UDim2.new(
			target.Position.X.Scale, target.Position.X.Offset,
			target.Position.Y.Scale, target.Position.Y.Offset + 4
		)
		sh.Visible = target.Visible
	end
	sync()
	target:GetPropertyChangedSignal("Size"):Connect(sync)
	target:GetPropertyChangedSignal("Position"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	return sh
end

--// shadow drawn as a child of the frame itself - use this when the frame is
--// managed by a UIListLayout (a sibling shadow would become a list item)
local function ShadowIn(target, spread, transparency)
	spread = spread or 16
	local sh = Instance.new("ImageLabel")
	sh.Name = "KM_ShadowIn"
	sh.BackgroundTransparency = 1
	sh.Image = SHADOW_ASSET
	sh.ImageColor3 = Color3.new(0, 0, 0)
	sh.ImageTransparency = transparency or 0.6
	sh.ScaleType = Enum.ScaleType.Slice
	sh.SliceCenter = Rect.new(49, 49, 450, 450)
	sh.Size = UDim2.new(1, spread * 2, 1, spread * 2)
	sh.Position = UDim2.new(0, -spread, 0, -spread + 3)
	sh.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
	sh.Parent = target
	return sh
end

--// coloured glow ring behind a frame (used for the tab indicator + orb)
local function Glow(parent, target, color, spread, transparency)
	local g = Instance.new("ImageLabel")
	g.Name = "KM_Glow"
	g.BackgroundTransparency = 1
	g.Image = SHADOW_ASSET
	g.ImageColor3 = color
	g.ImageTransparency = transparency or 0.55
	g.ScaleType = Enum.ScaleType.Slice
	g.SliceCenter = Rect.new(49, 49, 450, 450)
	g.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
	g.AnchorPoint = target.AnchorPoint
	g.Parent = parent
	spread = spread or 10
	local function sync()
		g.Size = UDim2.new(
			target.Size.X.Scale, target.Size.X.Offset + spread * 2,
			target.Size.Y.Scale, target.Size.Y.Offset + spread * 2
		)
		g.Position = UDim2.new(
			target.Position.X.Scale, target.Position.X.Offset - 0,
			target.Position.Y.Scale, target.Position.Y.Offset
		)
		g.Visible = target.Visible
	end
	sync()
	target:GetPropertyChangedSignal("Size"):Connect(sync)
	target:GetPropertyChangedSignal("Position"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	return g
end

--// ----------------------------------------------------------------
--// VECTOR CHEVRON  (V9.1)
--//   Roblox executors frequently ship without the glyphs used by the old
--//   text arrows ("\u{25BE}" / "\u{25B8}"), which rendered as an empty
--//   tofu box.  This builds the arrow out of two rotated frames instead,
--//   so it always draws and it can animate between directions.
--// ----------------------------------------------------------------
local CHEVRON_DIRS = {
	down  = {{0.273, 0.500,  45}, {0.727, 0.500, -45}},
	up    = {{0.273, 0.500, -45}, {0.727, 0.500,  45}},
	right = {{0.500, 0.273,  45}, {0.500, 0.727, -45}},
	left  = {{0.500, 0.273, -45}, {0.500, 0.727,  45}},
}

local function Chevron(parent, size, color, direction, zindex)
	size = size or 14
	zindex = zindex or ((parent and parent.ZIndex or 1) + 1)
	local holder = Instance.new("Frame")
	holder.Name = "KM_Chevron"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size, size)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.ZIndex = zindex
	holder.Parent = parent

	local thickness = math.max(1.6, size * 0.155)
	local armLen    = size * 0.62

	local arms = {}
	for i = 1, 2 do
		local a = Instance.new("Frame")
		a.Name = "Arm" .. i
		a.AnchorPoint = Vector2.new(0.5, 0.5)
		a.BorderSizePixel = 0
		a.BackgroundColor3 = color or Color3.new(1, 1, 1)
		a.Size = UDim2.fromOffset(armLen, thickness)
		a.ZIndex = zindex
		a.Parent = holder
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = a
		arms[i] = a
	end

	local api = {Holder = holder, Arms = arms}

	function api:SetDirection(dir, animated)
		local spec = CHEVRON_DIRS[tostring(dir):lower()] or CHEVRON_DIRS.down
		for i = 1, 2 do
			local px, py, rot = spec[i][1], spec[i][2], spec[i][3]
			local goalPos = UDim2.fromScale(px, py)
			if animated then
				TweenService:Create(arms[i], TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Position = goalPos, Rotation = rot,
				}):Play()
			else
				arms[i].Position = goalPos
				arms[i].Rotation = rot
			end
		end
		api.Direction = dir
	end

	function api:SetColor(c)
		arms[1].BackgroundColor3 = c
		arms[2].BackgroundColor3 = c
	end

	function api:SetTransparency(t)
		arms[1].BackgroundTransparency = t
		arms[2].BackgroundTransparency = t
	end

	api:SetDirection(direction or "down", false)
	return api
end

--// ----------------------------------------------------------------
--// VECTOR RESIZE GRIP  (V9.1)
--//   The old "\u{25E2}" glyph drew a hard square triangle that made the
--//   window's bottom-right corner look un-rounded.  Three rounded
--//   diagonal pips read as a grip and respect the corner radius.
--// ----------------------------------------------------------------
local function GripPips(parent, color, zindex)
	zindex = zindex or ((parent and parent.ZIndex or 1) + 1)
	local pips = {}
	-- (length, offsetFromCorner) for each diagonal dash, shortest outermost
	local spec = {
		{11, 3},
		{7,  7},
		{3,  11},
	}
	for i, def in ipairs(spec) do
		local len, off = def[1], def[2]
		local bar = Instance.new("Frame")
		bar.Name = "Pip" .. i
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.BorderSizePixel = 0
		bar.BackgroundColor3 = color or Color3.new(1, 1, 1)
		bar.BackgroundTransparency = 0.35
		bar.Rotation = -45
		bar.Size = UDim2.fromOffset(len, 2)
		bar.Position = UDim2.new(1, -off - len * 0.35, 1, -off - len * 0.35)
		bar.ZIndex = zindex
		bar.Parent = parent
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = bar
		pips[i] = bar
	end
	return pips
end

