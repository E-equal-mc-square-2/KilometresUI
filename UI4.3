	TPSec:Button("Teleport To Nearest Enemy", function()
		local myRoot = MyRoot()
		if not myRoot then
			return
		end
		local best, bestDist = nil, math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if ShouldTarget(plr) then
				local root = GetRoot(plr)
				if root then
					local d = (myRoot.Position - root.Position).Magnitude
					if d < bestDist then
						best, bestDist = root, d
					end
				end
			end
		end
		if best then
			myRoot.CFrame = best.CFrame * CFrame.new(0, 3, 3)
			Notify("Relocation", string.format("Teleported %d studs.", math.floor(bestDist)), "Success", 1.8)
		else
			Notify("Relocation", "No valid target found.", "Warning", 2)
		end
	end, {Icon = "target"})

	TPSec:Toggle("Click Teleport (Ctrl + Click)", false, function(v)
		S.ClickTP = v
	end)

	Bind(UIS.InputBegan, function(input, gp)
		if gp or Unloading or not S.ClickTP then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			local myRoot = MyRoot()
			if myRoot and Mouse.Hit then
				myRoot.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 4, 0))
			end
		end
	end)

	local WaypointSec = TPTab:CreateSection("Waypoints")
	local waypointName = "Spot 1"
	WaypointSec:Input("Waypoint Name", {
		Placeholder = "Name this position",
		Default = waypointName,
		Callback = function(txt)
			if txt ~= "" then
				waypointName = txt
			end
		end,
	})
	local waypointDrop
	WaypointSec:Button("Save Current Position", function()
		local myRoot = MyRoot()
		if not myRoot then
			return
		end
		Waypoints[waypointName] = myRoot.CFrame
		local names = {}
		for k in pairs(Waypoints) do
			table.insert(names, k)
		end
		Try(function()
			waypointDrop.Refresh(names, true)
		end)
		Notify("Waypoints", "Saved '" .. waypointName .. "'.", "Success", 1.8)
	end, {Icon = "save"})

	local selectedWaypoint = nil
	waypointDrop = WaypointSec:Dropdown("Saved Waypoints", {"(none yet)"}, nil, function(v)
		selectedWaypoint = v
	end)

	WaypointSec:Button("Teleport To Waypoint", function()
		local myRoot = MyRoot()
		local cf = selectedWaypoint and Waypoints[selectedWaypoint]
		if myRoot and cf then
			myRoot.CFrame = cf
		else
			Notify("Waypoints", "Save a waypoint first.", "Warning", 2)
		end
	end, {Icon = "map"})

	Bind(Players.PlayerAdded, function()
		Try(function() playerDrop.Refresh(PlayerNames(), true) end)
	end)
	Bind(Players.PlayerRemoving, function()
		task.defer(function()
			Try(function() playerDrop.Refresh(PlayerNames(), true) end)
		end)
	end)

	local ServerSec = TPTab:CreateSection("Server")
	ServerSec:Button("Rejoin Server", function()
		Notify("Server", "Rejoining this server...", "Info", 2)
		Try(function()
			TeleportSvc:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
		end)
	end, {Icon = "refresh"})
	ServerSec:Button("Copy Job ID", function()
		if SetClip then
			SetClip(tostring(game.JobId))
			Notify("Server", "Job ID copied.", "Success", 1.6)
		else
			Notify("Server", "Clipboard unsupported here.", "Warning", 2)
		end
	end, {Icon = "copy"})

	-- V9 FIX: the old "Server Hop" just called TeleportSvc:Teleport(PlaceId),
	-- which very often drops you straight back into the SAME server. We now
	-- query the public server list and pick a different, non-full instance.
	local HoppingServers = false
	ServerSec:Button("Server Hop (random)", function()
		if HoppingServers then
			Notify("Server", "Already searching for a server...", "Warning", 2)
			return
		end
		HoppingServers = true
		Notify("Server", "Looking for another server...", "Info", 2)

		task.spawn(function()
			local candidates, cursor, pages = {}, "", 0

			while pages < 3 do
				pages = pages + 1
				local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
					.. "/servers/Public?sortOrder=Desc&limit=100"
				if cursor ~= "" then
					url = url .. "&cursor=" .. cursor
				end

				local raw = nil
				Try(function() raw = HttpGetBinary(url) end)
				local data = raw and SafeJSONDecode(raw)
				if not data or type(data.data) ~= "table" then
					break
				end

				for _, srv in ipairs(data.data) do
					if type(srv) == "table" and srv.id and srv.id ~= game.JobId
						and type(srv.playing) == "number" and type(srv.maxPlayers) == "number"
						and srv.playing < srv.maxPlayers then
						table.insert(candidates, srv.id)
					end
				end

				if #candidates >= 12 or type(data.nextPageCursor) ~= "string" then
					break
				end
				cursor = data.nextPageCursor
				task.wait(0.2)
			end

			HoppingServers = false

			if #candidates > 0 then
				local pick = candidates[math.random(1, #candidates)]
				Notify("Server", "Hopping to a new server...", "Success", 2)
				Try(function()
					TeleportSvc:TeleportToPlaceInstance(game.PlaceId, pick, LocalPlayer)
				end)
			else
				-- no list access (private game / blocked HTTP): fall back
				Notify("Server", "No list access - using standard teleport.", "Warning", 2.5)
				Try(function()
					TeleportSvc:Teleport(game.PlaceId, LocalPlayer)
				end)
			end
		end)
	end, {Icon = "shuffle"})

	--// ----------------------------------------------------------------------
	--// 17. UI · INTERFACE TAB (theme + wallpaper shortcuts + unload)
	--// ----------------------------------------------------------------------

	local UITab = SuiteTab:CreateSubTab("Interface", {Icon = "settings", Order = 6})

	local LookSec = UITab:CreateSection("Look & Feel")
	LookSec:Info("Full control lives in the Settings (S) button up top.")

	local themeNames = Window:GetThemes()
	LookSec:Dropdown("Theme", themeNames, Window:GetTheme(), function(v)
		Window:SetTheme(v)
	end)

	LookSec:Toggle("UIBG Wallpaper", true, function(v)
		Window:ToggleWallpaper(v)
	end)
	LookSec:Button("Shuffle Wallpaper", function()
		Window:ShuffleWallpaper()
	end, {Icon = "shuffle"})
	LookSec:Button("Next Wallpaper", function()
		Window:NextWallpaper()
	end, {Icon = "next"})
	LookSec:Slider("Wallpaper Fade", 0, 1, 0.45, function(v)
		Window:SetWallpaperOpacity(v)
	end, 0.05)

	local AISec = UITab:CreateSection("Charlotte AI")
	AISec:Info("Charlotte has her own floating window - press the AI button in the top bar, or her hotkey (default Right Ctrl). Paste your key in Settings first.")
	AISec:Button("Open Charlotte", function()
		if Window.OpenGemini then
			Window:OpenGemini()
		end
	end, {Icon = "ai"})
	AISec:Button("Ask about this game", function()
		Window:SendGemini("Give me three exploit ideas for the Roblox game with PlaceId " .. tostring(game.PlaceId) .. ". Be concise.")
		Notify("Charlotte", "Prompt sent - see her window.", "Info", 2.2)
	end, {Icon = "ai"})
	AISec:Button("Ask her to write an ESP", function()
		Window:SendGemini("Write a compact Roblox Luau box ESP using the Drawing API with a wall check.")
		Notify("Charlotte", "Prompt sent - see her window.", "Info", 2.2)
	end, {Icon = "ai"})

	local DangerSec = UITab:CreateSection("Session")
	DangerSec:Keybind("Panic Key (hide UI)", Enum.KeyCode.RightShift, function(key)
		Window:SetHotkey(key)
	end)

	local function Unload()
		if Unloading then
			return
		end
		Unloading = true

		S.AimEnabled = false
		S.ESPEnabled = false
		S.TriggerBot = false
		S.Flying = false
		S.NoClip = false

		for _, conn in ipairs(Connections) do
			Try(function() conn:Disconnect() end)
		end
		Connections = {}

		for plr in pairs(ESPObjects) do
			DestroyESP(plr)
		end
		for _, d in ipairs(Drawings) do
			Try(function() d:Remove() end)
		end
		Drawings = {}

		StopFly()
		RestoreRates()
		-- V9: drop the noclip part cache and its listeners
		for _, c in ipairs(NoClipConns) do
			Try(function() c:Disconnect() end)
		end
		NoClipConns, NoClipParts, NoClipChar = {}, {}, nil
		ApplyFullBright(false)
		ApplyNoFog(false)
		ApplyXRay(false)
		ApplyFPSBoost(false)

		local hum = GetHum(LocalPlayer)
		if hum then
			Try(function()
				hum.WalkSpeed = 16
				hum.JumpPower = 50
			end)
		end

		Try(function() Window:Destroy() end)
	end

	DangerSec:Button("Unload Suite (full cleanup)", Unload, {Icon = "power"})

	--// ----------------------------------------------------------------------
	--// 18. BOOT
	--// ----------------------------------------------------------------------

	Try(function()
		Camera.FieldOfView = S.CameraFOV
	end)

	Notify("Universal Suite", "Aimbot / ESP / Weapons / Player tabs are ready.", "Success", 3)
	if not HasDrawing then
		Notify("Heads up", "No Drawing API detected - ESP falls back to Chams.", "Warning", 4)
	end

	return {Unload = Unload, State = S}
end

function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local SaveFile = cfg.SaveFile or "KilometresUIX/settings.json"

	------------------------------------------------------------------
	-- CONFIGURATION / STATE
	------------------------------------------------------------------

	local Defaults = {
		ThemeName = "LiquidGlass",
		Width = 750,
		Height = 360,
		OffsetX = 0,
		OffsetY = 0,
		SaveSettings = true,
		Hotkey = Enum.KeyCode.RightShift,
		GeminiHotkey = Enum.KeyCode.RightControl, -- V9: opens Charlotte
		MusicHotkey = Enum.KeyCode.RightAlt,      -- V9.1: opens the music player
		Roundness = 1,
		UIScale = 0.8,   -- V9.1: 80% is the new default (was 100%)
		Blur = false,
	}

	local UIBGDefaults = {
		Enabled = true,
		Index = 1,
		CustomId = "",
		Opacity = 0.45,   -- 0 = fully visible wallpaper, 1 = invisible
		Darken = 0.35,    -- black scrim strength for text readability
		ScaleMode = "Crop",
		Shuffle = false,
		Motion = true,
	}

	local State = {
		ThemeName = Defaults.ThemeName,
		Width = Defaults.Width,
		Height = Defaults.Height,
		OffsetX = Defaults.OffsetX,
		OffsetY = Defaults.OffsetY,
		SaveSettings = Defaults.SaveSettings,
		Hotkey = Defaults.Hotkey,
		GeminiHotkey = Defaults.GeminiHotkey,
		MusicHotkey = Defaults.MusicHotkey,
		Roundness = Defaults.Roundness,
		UIScale = Defaults.UIScale,
		Blur = Defaults.Blur,
		Hidden = false,
		Minimized = false,
		Destroyed = false,
		Refreshers = {},
		Connections = {},
		ActiveTab = nil,
		TabCounter = 0,
		SuiteLoaded = false,
		Suite = nil,
		Gemini = {
			ApiKey = "",
			Model = "gemini-2.5-flash",
			Endpoint = DEFAULT_GEMINI_ENDPOINT,
			Temperature = 0.7,
			MaxTokens = 1024,
			SystemPrompt = "",
			Mode = "Chat",          -- "Chat" | "Coder"
			Typewriter = true,
			AutoRetry = true,
		},
		UIBG = {
			Enabled = UIBGDefaults.Enabled,
			Index = UIBGDefaults.Index,
			CustomId = UIBGDefaults.CustomId,
			Opacity = UIBGDefaults.Opacity,
			Darken = UIBGDefaults.Darken,
			ScaleMode = UIBGDefaults.ScaleMode,
			Shuffle = UIBGDefaults.Shuffle,
			Motion = UIBGDefaults.Motion,
		},
	}

	-- forward declarations (V5 bugfix: these were referenced before their
	-- `local` declaration, silently resolving as globals in old handlers)
	local UpdateLayout
	local Destroy      -- V9.1: the key gate's Cancel path calls this early
	local SetHidden
	local SetMinimized
	local SetTheme
	local ApplyLoadedState
	local WidthSlider
	local HeightSlider
	local ApplyWallpaper
	local ApplyRoundness
	local ApplyUIScale
	local ApplyBlur
	local UIBGRefs = {}
	local SyncTabIndicator
	local GeminiHooks = {}

	local GeminiRefs = {}

	-- V9 forward declarations
	local ClampOffsets
	local MainScaleRef
	local OpenGeminiWindow
	local ToggleGeminiWindow
	local IsGeminiWindowOpen

	-- V9.1: the music player is built by a top-level factory, so the whole
	-- feature costs CreateWindow a single local
	local Music = nil
	local KeyGate = nil   -- V9.1: set when cfg.KeySystem is on

	local function AddConn(conn)
		if conn then
			table.insert(State.Connections, conn)
		end
		return conn
	end

	local function Theme()
		return Themes[State.ThemeName] or Themes.Default
	end

	local function AddRefresher(fn)
		table.insert(State.Refreshers, fn)
	end

	local function RefreshAll()
		for _, fn in ipairs(State.Refreshers) do
			pcall(fn)
		end
	end

	local function Persist()
		if not State.SaveSettings then
			return
		end
		local payload = {
			Version = "V7",
			ThemeName = State.ThemeName,
			Width = State.Width,
			Height = State.Height,
			OffsetX = math.floor(State.OffsetX + 0.5),
			OffsetY = math.floor(State.OffsetY + 0.5),
			SaveSettings = State.SaveSettings,
			Hotkey = tostring(State.Hotkey),
			GeminiHotkey = tostring(State.GeminiHotkey),
			MusicHotkey = tostring(State.MusicHotkey),
			Roundness = State.Roundness,
			UIScale = State.UIScale,
			Blur = State.Blur,
			Gemini = {
				ApiKey = State.Gemini.ApiKey,
				Model = State.Gemini.Model,
				Endpoint = State.Gemini.Endpoint,
				Temperature = State.Gemini.Temperature,
				MaxTokens = State.Gemini.MaxTokens,
				SystemPrompt = State.Gemini.SystemPrompt,
				Mode = State.Gemini.Mode,
				Typewriter = State.Gemini.Typewriter,
				AutoRetry = State.Gemini.AutoRetry,
			},
			UIBG = {
				Enabled = State.UIBG.Enabled,
				Index = State.UIBG.Index,
				CustomId = State.UIBG.CustomId,
				Opacity = State.UIBG.Opacity,
				Darken = State.UIBG.Darken,
				ScaleMode = State.UIBG.ScaleMode,
				Shuffle = State.UIBG.Shuffle,
				Motion = State.UIBG.Motion,
			},
		}
		local json = SafeJSONEncode(payload)
		if json then
			TryWriteFile(SaveFile, json)
		end
	end

	local function LoadPersisted()
		local raw = TryReadFile(SaveFile)
		if not raw then
			-- no file: defaults already present; create the file once
			Persist()
			return
		end

		local data = SafeJSONDecode(raw)
		if not data then
			-- corrupted file: recover safely instead of crashing
			local backup = SaveFile .. ".broken"
			TryWriteFile(backup, raw)
			Persist()
			return
		end

		State.ThemeName = (type(data.ThemeName) == "string" and Themes[data.ThemeName] and data.ThemeName) or State.ThemeName
		State.Width  = Clamp(tonumber(data.Width)  or State.Width,  340, 1400)
		State.Height = Clamp(tonumber(data.Height) or State.Height, 260, 900)
		State.OffsetX = tonumber(data.OffsetX) or 0
		State.OffsetY = tonumber(data.OffsetY) or 0
		State.SaveSettings = data.SaveSettings ~= false
		State.Roundness = Clamp(tonumber(data.Roundness) or State.Roundness, 0, 2)
		State.UIScale = Clamp(tonumber(data.UIScale) or State.UIScale, UI_SCALE_MIN, UI_SCALE_MAX)
		if type(data.Blur) == "boolean" then State.Blur = data.Blur end

		if type(data.Hotkey) == "string" then
			local name = data.Hotkey:gsub("Enum.KeyCode.", "")
			if Enum.KeyCode[name] then
				State.Hotkey = Enum.KeyCode[name]
			end
		end

		if type(data.GeminiHotkey) == "string" then
			local name = data.GeminiHotkey:gsub("Enum.KeyCode.", "")
			if Enum.KeyCode[name] then
				State.GeminiHotkey = Enum.KeyCode[name]
			end
		end

		if type(data.MusicHotkey) == "string" then
			local name = data.MusicHotkey:gsub("Enum.KeyCode.", "")
			if Enum.KeyCode[name] then
				State.MusicHotkey = Enum.KeyCode[name]
			end
		end

		if type(data.Gemini) == "table" then
			local g = data.Gemini
			if type(g.ApiKey) == "string" then State.Gemini.ApiKey = g.ApiKey end
			if type(g.Model) == "string" and g.Model ~= "" then State.Gemini.Model = g.Model end
			if type(g.Endpoint) == "string" and g.Endpoint ~= "" then State.Gemini.Endpoint = g.Endpoint end
			if type(g.Temperature) == "number" then State.Gemini.Temperature = Clamp(g.Temperature, 0, 2) end
			if type(g.MaxTokens) == "number" then State.Gemini.MaxTokens = Clamp(math.floor(g.MaxTokens), 64, 8192) end
			if type(g.SystemPrompt) == "string" then State.Gemini.SystemPrompt = g.SystemPrompt end
			if g.Mode == "Chat" or g.Mode == "Coder" then State.Gemini.Mode = g.Mode end
			if type(g.Typewriter) == "boolean" then State.Gemini.Typewriter = g.Typewriter end
			if type(g.AutoRetry) == "boolean" then State.Gemini.AutoRetry = g.AutoRetry end
		end

		if type(data.UIBG) == "table" then
			local w = data.UIBG
			if type(w.Enabled) == "boolean" then State.UIBG.Enabled = w.Enabled end
			if type(w.Index) == "number" then State.UIBG.Index = Clamp(math.floor(w.Index), 0, #WALLPAPERS) end
			if type(w.CustomId) == "string" then State.UIBG.CustomId = w.CustomId end
			if type(w.Opacity) == "number" then State.UIBG.Opacity = Clamp(w.Opacity, 0, 1) end
			if type(w.Darken) == "number" then State.UIBG.Darken = Clamp(w.Darken, 0, 1) end
			if type(w.ScaleMode) == "string" then
				for _, m in ipairs(UIBG_SCALE_MODES) do
					if m == w.ScaleMode then State.UIBG.ScaleMode = m end
				end
			end
			if type(w.Shuffle) == "boolean" then State.UIBG.Shuffle = w.Shuffle end
			if type(w.Motion) == "boolean" then State.UIBG.Motion = w.Motion end
		end
	end

	LoadPersisted()

	------------------------------------------------------------------
	-- ROOT GUI
	------------------------------------------------------------------

	local Screen = New("ScreenGui", {
		Name = "KilometresUIX",
		Parent = SafeParent(),
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
	})

	------------------------------------------------------------------
	-- NOTIFICATION SYSTEM (V2: typed, stacking, callbacks)
	------------------------------------------------------------------

	local NotifyHolder = New("Frame", {
		Parent = Screen,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.new(0, 292, 1, -28),
		BackgroundTransparency = 1,
		ZIndex = 1000,
	})
	New("UIListLayout", {
		Parent = NotifyHolder,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})

	local NotifyTypeInfo = {
		Info    = {Icon = "info",    Color = function(T) return T.Accent  end},
		Success = {Icon = "check",   Color = function(T) return T.Success end},
		Warning = {Icon = "warning", Color = function(T) return T.Warning end},
		Error   = {Icon = "close",   Color = function(T) return T.Error   end},
	}

	local function Notify(title, text, duration, ntype, onClick)
		-- table form: Notify({Title=..., Text=..., Type=..., Duration=..., Callback=...})
		if type(title) == "table" then
			local t = title
			title = t.Title or t.title
			text = t.Text or t.Message or t.text
			duration = t.Duration or t.duration
			ntype = t.Type or t.type
			onClick = t.Callback or t.OnClick or t.callback
		end
		ntype = NotifyTypeInfo[ntype] and ntype or "Info"
		duration = tonumber(duration) or 3
		title = Truncate(title or "Notification", 60)
		text = Truncate(text or "", 160)

		local T = Theme()
		local accent = NotifyTypeInfo[ntype].Color(T)

		local Card = New("CanvasGroup", {
			Parent = NotifyHolder,
			Size = UDim2.new(1, 0, 0, 66),
			BackgroundColor3 = T.Surface,
			BackgroundTransparency = math.max(T.SurfaceTransparency, 0.05),
			BorderSizePixel = 0,
			GroupTransparency = 1,
			ZIndex = 1001,
		})
		Corner(Card, 16)
		do
			local s = Stroke(Card, accent, 1.2)
			s.Transparency = 0.45
		end
		New("UIGradient", {
			Parent = Card,
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.02),
				NumberSequenceKeypoint.new(1, 0.14),
			}),
		})
		ShadowIn(Card, 16, 0.62)

		local Scale = New("UIScale", {Parent = Card, Scale = 0.9})

		local Bar = New("Frame", { -- colored type bar
			Parent = Card,
			Position = UDim2.fromOffset(3, 10),
			Size = UDim2.new(0, 4, 1, -20),
			BackgroundColor3 = accent,
			BorderSizePixel = 0,
			ZIndex = 1002,
		})
		Corner(Bar, 999)

		do
			local nIcon = MakeIconNode(Card, NotifyTypeInfo[ntype].Icon, 20, accent, 1002)
			if nIcon then
				nIcon.AnchorPoint = Vector2.new(0, 0.5)
				nIcon.Position = UDim2.new(0, 14, 0.5, 0)
				if nIcon:IsA("TextLabel") then
					nIcon.Size = UDim2.new(0, 24, 1, 0)
					nIcon.Position = UDim2.fromOffset(12, 0)
					nIcon.AnchorPoint = Vector2.new(0, 0)
					nIcon.TextSize = 17
				end
			end
		end

		New("TextLabel", {
			Parent = Card,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(40, 9),
			Size = UDim2.new(1, -52, 0, 18),
			Text = title,
			TextColor3 = T.Text,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 1002,
		})

		New("TextLabel", {
			Parent = Card,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(40, 28),
			Size = UDim2.new(1, -52, 0, 32),
			Text = text,
			TextColor3 = T.TextDim,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 1002,
		})

		local Clicker = New("TextButton", {
			Parent = Card,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			ZIndex = 1003,
		})

		Tween(Card, {GroupTransparency = 0}, 0.25)
		Tween(Scale, {Scale = 1}, 0.25)

		local dismissed = false
		local function Dismiss()
			if dismissed then
				return
			end
			dismissed = true
			Tween(Card, {GroupTransparency = 1}, 0.2)
			Tween(Scale, {Scale = 0.92}, 0.2)
