local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/E-equal-mc-square-2/KilometresUI/refs/heads/main/UI10"))() -- or HttpGet your host

local Window = Library:CreateWindow({
	Title    = "Kilometres UI X",
	Subtitle = "V10 · Nova",
	Theme    = "LiquidGlass",
	Intro    = true,          -- cinematic boot (default)
	Layout   = "Top",         -- "Top" | "Side"
	UIScale  = 0.85,
	SaveFile = "KilometresUIX/demo.json",
	-- KeySystem = { Keys = { "STAFF" }, Link = "https://example.com" },
})

local Main = Window:CreateTab("Main")
local Combat = Main:CreateSection("Demo flags")  -- name it whatever you want

Combat:Toggle("Example toggle", {
	Flag = "demo_on",
	Default = false,
	Callback = function(v)
		Window:Notify("Flag", "demo_on = " .. tostring(v), 1.6, "Info")
	end,
})

Combat:Slider("Example slider", {
	Flag = "demo_speed",
	Min = 16, Max = 80, Default = 16, Increment = 1,
	Callback = function(v) end,
})

Combat:Dropdown("Accent mood", {
	Flag = "demo_mood",
	Options = { "Calm", "Loud", "Night" },
	Default = "Calm",
})

Combat:Button("Save profile “Streamer”", function()
	Window:SaveProfile("Streamer")
end)

Combat:Button("Open command palette", function()
	Window:OpenPalette()
end)

local Look = Window:CreateTab("Notes")
local N = Look:CreateSection("V10")
N:Paragraph(
	"What changed",
	"Instance windows, flagged elements, named profiles, Ctrl+K palette, tab filter, side layout, reduced motion, cinematic intro. Universal Suite is not in this kit."
)
N:Info("Hotkeys: RightShift toggles the UI · Ctrl+K opens the palette.")

